<Window x:Class="ORT一键报告.MainWindow" Background="{DynamicResource WindowBackgroundBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ORT一键报告"
        xmlns:lex="http://wpflocalizeextension.codeplex.com"
        xmlns:sys="clr-namespace:System;assembly=mscorlib" xmlns:viewmodels="clr-namespace:ORT一键报告.ViewModels" d:DataContext="{d:DesignInstance Type=viewmodels:MainViewModel}"
        mc:Ignorable="d"
        Title="{Binding Title}" Height="400" Width="600" MinHeight="400" MinWidth="600" WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>
        <Menu>
            <MenuItem Header="{lex:Loc MainWindow_Menu_File}"></MenuItem>
            <MenuItem Header="{lex:Loc MainWindow_Menu_View}">
                <MenuItem Header="{lex:Loc MainWindow_Menu_ViewLog}" Click="MenuItem_ViewLog_Click"/>
            </MenuItem>
            <MenuItem Header="{lex:Loc MainWindow_Menu_Tools}">
                <MenuItem Header="{lex:Loc MainWindow_Menu_ReportTemplate}" Click="MenuItem_ReportTemplate_Click"
                          ToolTip="{lex:Loc MainWindow_ToolTip_ReportTemplate}"/>
            </MenuItem>
            <MenuItem Header="{lex:Loc MainWindow_Menu_Settings}" Click="MenuItem_Settings_Click"/>
            <!--用户：用户中心（个人资料/密码）与登录/注销-->
            <MenuItem Header="{lex:Loc MainWindow_Menu_User}">
                <MenuItem Header="{lex:Loc MainWindow_Menu_UserCenter}" Click="MenuItem_UserCenter_Click"
                          ToolTip="{lex:Loc MainWindow_Menu_UserCenterHint}"/>
                <Separator/>
                <MenuItem x:Name="menu_account" Header="{lex:Loc MainWindow_Menu_Account}" Click="MenuItem_Login_Click"/>
            </MenuItem>
            <MenuItem Header="{lex:Loc MainWindow_Menu_Logout}" Click="MenuItem_Quit_Click"/>
        </Menu>
        <Grid Grid.Row="1" Margin="0">
            <!-- 背景图（用户在 设置→界面 里自行选择；仅主界面使用） -->
            <Image x:Name="img_background" Stretch="UniformToFill" SnapsToDevicePixels="True" Visibility="Collapsed"/>
            <!-- 淡淡遮罩：铺了背景图也保证按钮与文字清晰可读 -->
            <Rectangle x:Name="rect_scrim" Fill="{DynamicResource WindowBackgroundBrush}" Opacity="0.45" Visibility="Collapsed"/>
            <!-- 主功能按钮：垂直排列、靠右 -->
            <StackPanel x:Name="panel_buttons" Orientation="Vertical" HorizontalAlignment="Right" VerticalAlignment="Center"
                        Width="260" Margin="0,10,48,10">
                <Button x:Name="btn_report" Content="{lex:Loc MainWindow_Button_Report}" Style="{StaticResource PrimaryButton}" FontSize="26" FontWeight="Bold" Click="Button_YiJianBaoGao_Click"
                        Margin="0,0,0,14" ToolTip="{lex:Loc MainWindow_ToolTip_Report}"/>
                <Button x:Name="btn_plans" Content="{lex:Loc MainWindow_Button_Plans}" Style="{StaticResource PrimaryButton}" FontSize="26" FontWeight="Bold" Click="Button_Plans_Click"
                        Margin="0,0,0,14" ToolTip="{lex:Loc MainWindow_ToolTip_Plans}"/>
                <Button x:Name="btn_admin" Content="{lex:Loc MainWindow_Button_Admin}" Style="{StaticResource PrimaryButton}" FontSize="26" FontWeight="Bold" Click="Button_Admin_Click"
                        Margin="0,0,0,14" ToolTip="{lex:Loc MainWindow_ToolTip_Admin}"/>
                <Button x:Name="btn_review" Content="{lex:Loc MainWindow_Button_Review}" Style="{StaticResource PrimaryButton}" FontSize="26" FontWeight="Bold" Click="Button_Review_Click"
                        ToolTip="{lex:Loc MainWindow_ToolTip_Review}"/>
            </StackPanel>
        </Grid>

        <!--左下角：当前用户身份信息（登录后显示显示名与角色，未登录显示游客）-->
        <Border Grid.Row="2" Background="{DynamicResource MenuBackgroundBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}"
                BorderThickness="0,1,0,0" Padding="10,4">
            <TextBlock x:Name="txt_user_identity" HorizontalAlignment="Left" VerticalAlignment="Center"
                       Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis"
                       ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
        </Border>
    </Grid>

</Window>
