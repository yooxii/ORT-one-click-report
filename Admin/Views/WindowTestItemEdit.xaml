<Window x:Class="ORT一键报告.Admin.Views.WindowTestItemEdit" Background="{DynamicResource WindowBackgroundBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:lex="http://wpflocalizeextension.codeplex.com"
        mc:Ignorable="d"
        Title="{lex:Loc Admin_NewTestItem}" Width="470" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="15">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>

        <Label Content="{lex:Loc Admin_TestExperiment}" VerticalContentAlignment="Center"/>
        <TextBox x:Name="txt_name" Grid.Column="1" Margin="5" VerticalContentAlignment="Center"/>

        <Label Grid.Row="1" Content="{lex:Loc Admin_TestTime}" VerticalContentAlignment="Center"/>
        <TextBox x:Name="txt_period" Grid.Row="1" Grid.Column="1" Margin="5" VerticalContentAlignment="Center"/>

        <!--测试种类：报告 ORT Plan / TestStatus 的分组行按它归类，可直接输入或用下拉里已有的种类-->
        <Label Grid.Row="2" Content="{lex:Loc Admin_TestCategory}" VerticalContentAlignment="Center"/>
        <ComboBox x:Name="cmb_category" Grid.Row="2" Grid.Column="1" Margin="5" IsEditable="True"
                  VerticalContentAlignment="Center" ToolTip="{lex:Loc Admin_TestCategoryHint}"/>

        <Label Grid.Row="3" Content="{lex:Loc Plans_Owner}" VerticalContentAlignment="Center"/>
        <TextBox x:Name="txt_owner" Grid.Row="3" Grid.Column="1" Margin="5" VerticalContentAlignment="Center"
                 TextChanged="Txt_Owner_TextChanged"/>

        <TextBlock Grid.Row="4" Grid.ColumnSpan="2" Text="{lex:Loc Admin_OwnerHint}" TextWrapping="Wrap"
                   Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,6"/>

        <!--已有技术员多选列表-->
        <Border Grid.Row="5" Grid.ColumnSpan="2" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1"
                Padding="8" Height="150">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="{lex:Loc Admin_TechnicianList}" FontWeight="Bold" Margin="0,0,0,6"/>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="panel_technicians"/>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <Label Grid.Row="6" Content="{lex:Loc Admin_Remark}" VerticalContentAlignment="Center"/>
        <TextBox x:Name="txt_remark" Grid.Row="6" Grid.Column="1" Margin="5" VerticalContentAlignment="Center"/>

        <StackPanel Grid.Row="7" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="{lex:Loc Common_OK}" Width="90" Click="Btn_OK_Click" IsDefault="True"/>
            <Button Content="{lex:Loc Common_Cancel}" Width="90" Margin="10,0,0,0" Click="Btn_Cancel_Click" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
