<!--
  FluentTheme.xaml — 方案一：Fluent 2 原生风格
  Windows 11 视觉语言：浅灰背景、Accent Blue #0078D4、小圆角、细腻边框
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 字体 -->
    <FontFamily x:Key="FontFamilyUI">Segoe UI, Microsoft YaHei UI, Microsoft YaHei</FontFamily>
    <FontFamily x:Key="FontFamilyData">Consolas, Segoe UI, Microsoft YaHei UI</FontFamily>

    <!-- 圆角 -->
    <CornerRadius x:Key="CornerRadiusSmall">4</CornerRadius>
    <CornerRadius x:Key="CornerRadiusButton">4</CornerRadius>
    <CornerRadius x:Key="CornerRadiusCard">8</CornerRadius>
    <CornerRadius x:Key="CornerRadiusLarge">12</CornerRadius>
    <sys:Double x:Key="DisabledOpacity" xmlns:sys="clr-namespace:System;assembly=mscorlib">0.45</sys:Double>

    <!-- 背景层级 -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#FFF3F3F3"/>
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#FFFBFBFB"/>
    <SolidColorBrush x:Key="AlternateRowBrush" Color="#FFF7F7F7"/>
    <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="#FFF9F9F9"/>
    <SolidColorBrush x:Key="HeaderBackgroundBrush" Color="#FFFAFAFA"/>
    <SolidColorBrush x:Key="TableHeaderForegroundBrush" Color="#FF555555"/>

    <!-- 主色 Accent Blue -->
    <SolidColorBrush x:Key="PrimaryBrush" Color="#FF0078D4"/>
    <SolidColorBrush x:Key="PrimaryHoverBrush" Color="#FF106EBE"/>
    <SolidColorBrush x:Key="PrimaryForegroundBrush" Color="#FFFFFFFF"/>

    <!-- 按钮 -->
    <SolidColorBrush x:Key="ButtonBackgroundBrush" Color="#FFFBFBFB"/>
    <SolidColorBrush x:Key="ButtonHoverBrush" Color="#FFF0F0F0"/>
    <SolidColorBrush x:Key="ButtonPressedBrush" Color="#FFE5E5E5"/>
    <SolidColorBrush x:Key="ButtonBorderBrush" Color="#FFE0E0E0"/>
    <SolidColorBrush x:Key="ButtonForegroundBrush" Color="#FF1A1A1A"/>

    <!-- 文字 -->
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FF1A1A1A"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#FF6E6E6E"/>
    <SolidColorBrush x:Key="BorderSubtleBrush" Color="#FFE8E8E8"/>

    <!-- 输入框 -->
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="InputForegroundBrush" Color="#FF1A1A1A"/>
    <SolidColorBrush x:Key="InputBorderBrush" Color="#FFD0D0D0"/>
    <SolidColorBrush x:Key="InputFocusBorderBrush" Color="#FF0078D4"/>

    <!-- 表格选中/悬停 -->
    <SolidColorBrush x:Key="TableRowHoverBrush" Color="#FFF2F2F2"/>
    <SolidColorBrush x:Key="TableRowSelectedBrush" Color="#FFE8F0FA"/>
    <SolidColorBrush x:Key="TableCellSelectedBrush" Color="#FFE0E0E0"/>

    <!-- 下拉项 -->
    <SolidColorBrush x:Key="ItemHoverBrush" Color="#FFF0F0F0"/>
    <SolidColorBrush x:Key="ItemSelectedBrush" Color="#FFE5F1FB"/>

    <!-- 状态色 -->
    <SolidColorBrush x:Key="StatusOkBrush" Color="#FF2E7D32"/>
    <SolidColorBrush x:Key="StatusOkBgBrush" Color="#FFE8F5E9"/>
    <SolidColorBrush x:Key="StatusWarnBrush" Color="#FFE65100"/>
    <SolidColorBrush x:Key="StatusWarnBgBrush" Color="#FFFFF3E0"/>
    <SolidColorBrush x:Key="StatusErrorBrush" Color="#FFC62828"/>
    <SolidColorBrush x:Key="StatusErrorBgBrush" Color="#FFFFEBEE"/>

    <!-- 菜单 -->
    <SolidColorBrush x:Key="MenuBackgroundBrush" Color="#FFFAFAFA"/>
    <SolidColorBrush x:Key="MenuForegroundBrush" Color="#FF1A1A1A"/>

</ResourceDictionary>
