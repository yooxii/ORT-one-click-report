<!--
  MaterialTheme.xaml — 方案二：Material Design 3 商务风
  Teal 主色 #00695C、大圆角、卡片留白、柔和阴影
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 字体 -->
    <FontFamily x:Key="FontFamilyUI">Roboto, Noto Sans SC, Microsoft YaHei UI, Microsoft YaHei</FontFamily>
    <FontFamily x:Key="FontFamilyData">Roboto Mono, Consolas, Microsoft YaHei UI</FontFamily>

    <!-- 圆角（Material 3 大圆角） -->
    <CornerRadius x:Key="CornerRadiusSmall">8</CornerRadius>
    <CornerRadius x:Key="CornerRadiusButton">20</CornerRadius>
    <CornerRadius x:Key="CornerRadiusCard">16</CornerRadius>
    <CornerRadius x:Key="CornerRadiusLarge">24</CornerRadius>
    <sys:Double x:Key="DisabledOpacity" xmlns:sys="clr-namespace:System;assembly=mscorlib">0.4</sys:Double>

    <!-- 背景层级 -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#FFF5F5F5"/>
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="AlternateRowBrush" Color="#FFFAFAFA"/>
    <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="HeaderBackgroundBrush" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="TableHeaderForegroundBrush" Color="#FF616161"/>

    <!-- 主色 Teal -->
    <SolidColorBrush x:Key="PrimaryBrush" Color="#FF00695C"/>
    <SolidColorBrush x:Key="PrimaryHoverBrush" Color="#FF004D40"/>
    <SolidColorBrush x:Key="PrimaryForegroundBrush" Color="#FFFFFFFF"/>

    <!-- 按钮（Material tonal：浅青底 + 深青字，胶囊圆角） -->
    <SolidColorBrush x:Key="ButtonBackgroundBrush" Color="#FFE0F2F1"/>
    <SolidColorBrush x:Key="ButtonHoverBrush" Color="#FFB2DFDB"/>
    <SolidColorBrush x:Key="ButtonPressedBrush" Color="#FF80CBC4"/>
    <SolidColorBrush x:Key="ButtonBorderBrush" Color="#00000000"/>
    <SolidColorBrush x:Key="ButtonForegroundBrush" Color="#FF00695C"/>

    <!-- 文字 -->
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FF1C1B1F"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#FF757575"/>
    <SolidColorBrush x:Key="BorderSubtleBrush" Color="#FFE8E8E8"/>

    <!-- 输入框（Material outlined） -->
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="InputForegroundBrush" Color="#FF1C1B1F"/>
    <SolidColorBrush x:Key="InputBorderBrush" Color="#FFDADCE0"/>
    <SolidColorBrush x:Key="InputFocusBorderBrush" Color="#FF00695C"/>

    <!-- 表格选中/悬停 -->
    <SolidColorBrush x:Key="TableRowHoverBrush" Color="#FFF1F8F7"/>
    <SolidColorBrush x:Key="TableRowSelectedBrush" Color="#FFE0F2F1"/>
    <SolidColorBrush x:Key="TableCellSelectedBrush" Color="#FFB2DFDB"/>

    <!-- 下拉项 -->
    <SolidColorBrush x:Key="ItemHoverBrush" Color="#FFF1F8F7"/>
    <SolidColorBrush x:Key="ItemSelectedBrush" Color="#FFE0F2F1"/>

    <!-- 状态色 -->
    <SolidColorBrush x:Key="StatusOkBrush" Color="#FF2E7D32"/>
    <SolidColorBrush x:Key="StatusOkBgBrush" Color="#FFE8F5E9"/>
    <SolidColorBrush x:Key="StatusWarnBrush" Color="#FFE65100"/>
    <SolidColorBrush x:Key="StatusWarnBgBrush" Color="#FFFFF3E0"/>
    <SolidColorBrush x:Key="StatusErrorBrush" Color="#FFC62828"/>
    <SolidColorBrush x:Key="StatusErrorBgBrush" Color="#FFFFEBEE"/>

    <!-- 菜单（Material top bar：主色填充） -->
    <SolidColorBrush x:Key="MenuBackgroundBrush" Color="#FF00695C"/>
    <SolidColorBrush x:Key="MenuForegroundBrush" Color="#FFFFFFFF"/>

</ResourceDictionary>
