<Window x:Class="ORT一键报告.Reports.Views.WindowReportTemplate" Background="{DynamicResource WindowBackgroundBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:lex="http://wpflocalizeextension.codeplex.com"
        xmlns:local="clr-namespace:ORT一键报告.Reports.Views"
        mc:Ignorable="d"
        Title="{lex:Loc ReportTemplate_Title}" Height="720" Width="1180" MinHeight="520" MinWidth="900"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="6"/>
            <RowDefinition Height="*" MinHeight="120"/>
            <RowDefinition Height="6"/>
            <RowDefinition Height="300" MinHeight="140"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>

        <!--基本信息：机种/客户/版本/阶段/RT工号/周期/序列号/工令/开始日期/输出目录-->
        <GroupBox Grid.Row="0" Header="{lex:Loc ReportTemplate_BaseInfo}" Padding="6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*" MinWidth="120"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*" MinWidth="100"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*" MinWidth="100"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*" MinWidth="100"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                </Grid.RowDefinitions>

                <Label Content="{lex:Loc ReportTemplate_ModelName}" VerticalContentAlignment="Center"/>
                <ComboBox x:Name="cb_model" Grid.Column="1" Margin="4,2" IsEditable="True" VerticalContentAlignment="Center"
                          SelectionChanged="Cb_Model_SelectionChanged" ToolTip="{lex:Loc ReportTemplate_SelectPlan}"/>

                <Label Grid.Column="2" Content="{lex:Loc ReportTemplate_Customer}" VerticalContentAlignment="Center"/>
                <TextBox x:Name="txt_customer" Grid.Column="3" Margin="4,2" VerticalContentAlignment="Center"/>

                <Label Grid.Column="4" Content="{lex:Loc ReportTemplate_Revision}" VerticalContentAlignment="Center"/>
                <TextBox x:Name="txt_revision" Grid.Column="5" Margin="4,2" VerticalContentAlignment="Center"/>

                <Label Grid.Column="6" Content="{lex:Loc ReportTemplate_Stage}" VerticalContentAlignment="Center"/>
                <TextBox x:Name="txt_stage" Grid.Column="7" Margin="4,2" VerticalContentAlignment="Center" Text="MP"/>

                <Label Grid.Row="1" Content="{lex:Loc ReportTemplate_JobNo}" VerticalContentAlignment="Center"/>
                <TextBox x:Name="txt_jobNo" Grid.Row="1" Grid.Column="1" Margin="4,2" VerticalContentAlignment="Center"/>

                <Label Grid.Row="1" Grid.Column="2" Content="{lex:Loc ReportTemplate_Period}" VerticalContentAlignment="Center"/>
                <TextBox x:Name="txt_period" Grid.Row="1" Grid.Column="3" Margin="4,2" VerticalContentAlignment="Center"/>

                <Label Grid.Row="1" Grid.Column="4" Content="{lex:Loc ReportTemplate_WorkOrder}" VerticalContentAlignment="Center"/>
                <TextBox x:Name="txt_workOrder" Grid.Row="1" Grid.Column="5" Margin="4,2" VerticalContentAlignment="Center"/>

                <Label Grid.Row="1" Grid.Column="6" Content="{lex:Loc ReportTemplate_StartDate}" VerticalContentAlignment="Center"/>
                <DatePicker x:Name="dp_start" Grid.Row="1" Grid.Column="7" Margin="4,2" VerticalContentAlignment="Center"/>

                <Label Grid.Row="2" Content="{lex:Loc ReportTemplate_SerialNumbers}" VerticalContentAlignment="Top"/>
                <TextBox x:Name="txt_sns" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="5" Margin="4,2" Height="56"
                         AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                         VerticalContentAlignment="Top"/>

                <StackPanel Grid.Row="2" Grid.Column="6" Grid.ColumnSpan="2">
                    <Label Content="{lex:Loc ReportTemplate_OutputPath}" VerticalContentAlignment="Center"/>
                    <DockPanel Margin="4,0,0,0">
                        <Button DockPanel.Dock="Right" Content="{lex:Loc ReportTemplate_Browse}" Padding="8,2" Margin="6,0,0,0"
                                Click="Btn_Browse_Click"/>
                        <TextBox x:Name="txt_output" VerticalContentAlignment="Center"/>
                    </DockPanel>
                </StackPanel>
            </Grid>
        </GroupBox>

        <!--测试项目与安排的工具条-->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,6,0,0">
            <TextBlock Text="{lex:Loc ReportTemplate_Items}" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <Button x:Name="btn_loadPlan" Content="{lex:Loc ReportTemplate_LoadPlan}" Padding="8,2" Click="Btn_LoadPlan_Click"
                    ToolTip="{lex:Loc ReportTemplate_SelectPlan}"/>
            <Button x:Name="btn_autoFill" Content="{lex:Loc ReportTemplate_AutoFill}" Padding="8,2" Margin="6,0,0,0" Click="Btn_AutoFill_Click"/>
            <Button x:Name="btn_addItem" Content="{lex:Loc ReportTemplate_AddItem}" Padding="8,2" Margin="6,0,0,0" Click="Btn_AddItem_Click"/>
            <Button x:Name="btn_removeItem" Content="{lex:Loc ReportTemplate_RemoveItem}" Padding="8,2" Margin="6,0,0,0" Click="Btn_RemoveItem_Click"/>
            <Button x:Name="btn_moveUp" Content="{lex:Loc ReportTemplate_MoveUp}" Padding="8,2" Margin="6,0,0,0" Click="Btn_MoveUp_Click"/>
            <Button x:Name="btn_moveDown" Content="{lex:Loc ReportTemplate_MoveDown}" Padding="8,2" Margin="6,0,0,0" Click="Btn_MoveDown_Click"/>
            <TextBlock Text="{lex:Loc ReportTemplate_DragHint}" VerticalAlignment="Center" Margin="14,0,0,0"
                       Foreground="{DynamicResource TextSecondaryBrush}"/>
        </StackPanel>

        <!--可拖动的分隔条：上下拖动调整"测试项目安排"表格高度-->
        <GridSplitter Grid.Row="2" Height="6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                      ResizeDirection="Rows" ResizeBehavior="Next" Cursor="SizeNS"
                      Background="{DynamicResource BorderSubtleBrush}" ToolTip="{lex:Loc ReportTemplate_DragToResize}"/>

        <!--测试项目安排（强制按开始日期排序，不能点表头排序，日期可改）-->
        <DataGrid x:Name="dg_items" Grid.Row="3" AutoGenerateColumns="False" CanUserAddRows="False"
                  CanUserSortColumns="False" SelectionMode="Single" SelectionUnit="FullRow" HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal" SelectionChanged="Dg_Items_SelectionChanged"
                  CellEditEnding="Dg_Items_CellEditEnding">
            <DataGrid.Columns>
                <DataGridTextColumn Header="{lex:Loc ReportTemplate_Category}" Binding="{Binding Category}" Width="140"/>
                <DataGridTextColumn Header="{lex:Loc ReportTemplate_Item}" Binding="{Binding TestItemName}" Width="*"/>
                <DataGridTextColumn Header="{lex:Loc ReportTemplate_PeriodHours}" Binding="{Binding PeriodHours}" Width="90"/>
                <DataGridTextColumn Header="{lex:Loc ReportTemplate_StartTime}" Binding="{Binding Start, StringFormat=yyyy/M/d}" Width="100"/>
                <DataGridTextColumn Header="{lex:Loc ReportTemplate_EndTime}" Binding="{Binding End, StringFormat=yyyy/M/d}" Width="100"/>
                <DataGridTextColumn Header="{lex:Loc ReportTemplate_PlanHours}" Binding="{Binding Days}" Width="90" IsReadOnly="True"/>
            </DataGrid.Columns>
        </DataGrid>

        <!--可拖动的分隔条：上下拖动调整下方"测试计划"区域高度-->
        <GridSplitter Grid.Row="4" Height="6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                      ResizeDirection="Rows" ResizeBehavior="PreviousAndNext" Cursor="SizeNS"
                      Background="{DynamicResource BorderSubtleBrush}" ToolTip="{lex:Loc ReportTemplate_DragToResize}"/>

        <!--选中测试项的测试计划（抽样计划/测试条件/通过判定，来自计划模板，可直接编辑或换用别的模板方案）-->
        <GroupBox Grid.Row="5" Header="{lex:Loc ReportTemplate_Plan}" Padding="6">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto"/>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,4">
                    <Button x:Name="btn_pickVariant" Content="{lex:Loc ReportTemplate_PickVariant}" Padding="10,3"
                            Click="Btn_PickVariant_Click" ToolTip="{lex:Loc ReportTemplate_PickVariantHint}"/>
                    <Button x:Name="btn_resetPlan" Content="{lex:Loc ReportTemplate_ResetPlan}" Padding="10,3" Margin="8,0,0,0"
                            Click="Btn_ResetPlan_Click"/>
                    <TextBlock Text="{lex:Loc ReportTemplate_PlanEditableHint}" VerticalAlignment="Center" Margin="12,0,0,0"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                </StackPanel>
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <DockPanel Grid.Column="0" Margin="2">
                        <TextBlock DockPanel.Dock="Top" Text="{lex:Loc ReportTemplate_SamplingPlan}" FontWeight="Bold"/>
                        <TextBox x:Name="txt_planSampling" Tag="SamplingPlan" AcceptsReturn="True" TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto" TextChanged="PlanText_TextChanged"/>
                    </DockPanel>
                    <DockPanel Grid.Column="1" Margin="2">
                        <TextBlock DockPanel.Dock="Top" Text="{lex:Loc ReportTemplate_TestCondition}" FontWeight="Bold"/>
                        <TextBox x:Name="txt_planCondition" Tag="TestCondition" AcceptsReturn="True" TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto" TextChanged="PlanText_TextChanged"/>
                    </DockPanel>
                    <DockPanel Grid.Column="2" Margin="2">
                        <TextBlock DockPanel.Dock="Top" Text="{lex:Loc ReportTemplate_PassCriterion}" FontWeight="Bold"/>
                        <TextBox x:Name="txt_planCriterion" Tag="PassCriterion" AcceptsReturn="True" TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto" TextChanged="PlanText_TextChanged"/>
                    </DockPanel>
                </Grid>
            </Grid>
        </GroupBox>

        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button x:Name="btn_generate" Content="{lex:Loc ReportTemplate_Generate}" Padding="14,4" FontWeight="Bold" Click="Btn_Generate_Click"/>
            <Button x:Name="btn_openFolder" Content="{lex:Loc ReportTemplate_OpenFolder}" Padding="12,4" Margin="10,0,0,0" Click="Btn_OpenFolder_Click"/>
            <Button Content="{lex:Loc ReportTemplate_Close}" Padding="12,4" Margin="10,0,0,0" IsCancel="True" Click="Btn_Close_Click"/>
        </StackPanel>
    </Grid>
</Window>
