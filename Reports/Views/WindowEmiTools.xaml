<Window x:Class="ORT一键报告.Reports.Views.WindowEmiTools"
        Background="{DynamicResource WindowBackgroundBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:lex="http://wpflocalizeextension.codeplex.com"
        mc:Ignorable="d"
        Title="EMI 数据处理" Width="600" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>

        <!-- 数据目录 -->
        <StackPanel Grid.Row="0" Orientation="Horizontal">
            <TextBlock Text="数据目录：" VerticalAlignment="Center"/>
            <TextBox x:Name="txt_dataDir" Width="400" IsReadOnly="True" VerticalAlignment="Center"
                     Background="Transparent" BorderThickness="0" TextWrapping="Wrap"/>
            <Button Content="选择…" Width="60" Margin="8,0,0,0" Click="Btn_SelectDir_Click"/>
        </StackPanel>

        <!-- 文件时间 -->
        <GroupBox Grid.Row="1" Header="文件时间（PDF）" Margin="0,12,0,0" Padding="8">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="基准日期：" VerticalAlignment="Center"/>
                    <DatePicker x:Name="dp_baseDate" Width="140" VerticalAlignment="Center"/>
                    <TextBlock Text="随机天数 0~" VerticalAlignment="Center" Margin="14,0,0,0"/>
                    <TextBox x:Name="txt_randomDays" Width="50" Text="0" Margin="4,0,0,0" VerticalAlignment="Center"/>
                    <CheckBox x:Name="chk_skipWeekend" Content="周末顺延到周一" Margin="14,0,0,0" VerticalAlignment="Center"/>
                    <Button x:Name="btn_applyTime" Content="应用时间" Width="90" Margin="14,0,0,0" Click="Btn_ApplyTime_Click"/>
                </StackPanel>
                <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" Opacity="0.75"
                           Text="说明：只改 PDF 文件的创建/修改时间（保留各文件原有“时分秒”），用于让报告数据的时间与实际测试时间一致。"/>
            </StackPanel>
        </GroupBox>

        <!-- Word 字符串替换 -->
        <GroupBox Grid.Row="2" Header="Word 字符串替换" Margin="0,12,0,0" Padding="8">
            <StackPanel>
                <TextBlock TextWrapping="Wrap" Opacity="0.75"
                           Text="每行一组，格式：旧字符串=新字符串（以 # 开头的行忽略）。只替换文档文本，不重新压缩图片。"/>
                <TextBox x:Name="txt_pairs" Height="130" Margin="0,6,0,0" AcceptsReturn="True" TextWrapping="NoWrap"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                         FontFamily="Consolas" VerticalContentAlignment="Top"/>
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <CheckBox x:Name="chk_backup" Content="替换前备份为 .docx.bak（已存在则不覆盖）" IsChecked="True" VerticalAlignment="Center"/>
                    <Button x:Name="btn_replace" Content="执行替换" Width="90" Margin="14,0,0,0" Click="Btn_Replace_Click"/>
                </StackPanel>
            </StackPanel>
        </GroupBox>

        <!-- 状态 -->
        <TextBlock x:Name="txt_status" Grid.Row="3" Margin="0,12,0,0" TextWrapping="Wrap" MinHeight="34"/>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="关闭" Width="90" Click="Btn_Close_Click" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
