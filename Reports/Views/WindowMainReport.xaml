<Window x:Class="ORT一键报告.Reports.Views.WindowMainReport" Background="{DynamicResource WindowBackgroundBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:lex="http://wpflocalizeextension.codeplex.com"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        xmlns:local="clr-namespace:ORT一键报告.Reports.Views"
        xmlns:models="clr-namespace:ORT一键报告.Reports.Models"
        xmlns:viewmodels="clr-namespace:ORT一键报告.Reports.ViewModels"
        d:DataContext="{d:DesignInstance Type=viewmodels:MainReportViewModel}"
        mc:Ignorable="d"
        Title="{Binding Title}" Height="640" Width="1100" MinHeight="400" MinWidth="600" WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <!--Create list of enumeration values-->
        <ObjectDataProvider x:Key="RpstatusEnum" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type Type="models:ReportStatus" />
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="20" />
            <RowDefinition />
            <RowDefinition Height="20" />
        </Grid.RowDefinitions>
        <Menu x:Name="_Menu" Grid.Row="0">
            <MenuItem Header="{lex:Loc Report_ToolsMenu}">
                <MenuItem Header="{lex:Loc ReportPage_ATEData}" Click="MenuItem_ATE_Click" />
                <MenuItem Header="{lex:Loc Report_TemplateMenu}" Click="MenuItem_ReportTemplate_Click"/>
            </MenuItem>
            <MenuItem Header="{lex:Loc Report_ViewMenu}">
                <MenuItem Header="{lex:Loc Report_ViewLog}" Click="MenuItem_ViewLog_Click"/>
                <Separator/>
                <MenuItem x:Name="menu_tab_thermalshock" Header="{lex:Loc Report_ThermalShockTab}" IsCheckable="True" Click="Menu_TabToggle_Click"/>
                <MenuItem x:Name="menu_tab_burnin" Header="{lex:Loc Report_BurnInTab}" IsCheckable="True" Click="Menu_TabToggle_Click"/>
                <MenuItem x:Name="menu_tab_emi" Header="{lex:Loc Report_EMITab}" IsCheckable="True" Click="Menu_TabToggle_Click"/>
            </MenuItem>
        </Menu>
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="35" />
                <RowDefinition />
            </Grid.RowDefinitions>
            <Grid>
                <Grid Height="30" VerticalAlignment="Top" Margin="10,3,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="65*" MaxWidth="65" MinWidth="65" />
                        <ColumnDefinition Width="650*" MinWidth="200" />
                        <ColumnDefinition Width="65*" MinWidth="65" />
                        <ColumnDefinition Width="65*" MinWidth="65" />
                    </Grid.ColumnDefinitions>
                    <Label Content="{lex:Loc Settings_ReportPath}" />
                    <TextBox x:Name="text_rootReportPath" Text="{Binding ReportPath}" Grid.Column="1" VerticalContentAlignment="Center" TextWrapping="WrapWithOverflow" ToolTip="{lex:Loc Report_ClickBrowse}" />
                    <Button x:Name="btn_rootpath_t" Content="{lex:Loc Common_Browse}" Cursor="Hand" Command="{Binding SelectReportPathCommand}" Margin="3,0,3,0" Grid.Column="2" />
                    <Button x:Name="btn_readReport_t" Content="{lex:Loc Report_Title}" Cursor="Hand" Click="DoReport_Click" Margin="3,0,3,0" Grid.Column="3" />
                </Grid>
            </Grid>
            <TabControl x:Name="tab_report" Margin="10,3,10,3" Grid.Row="1" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
        </Grid>
        <StatusBar Grid.Row="2" Margin="5,0,5,0" Visibility="Collapsed">
            <StatusBarItem x:Name="StatusBarMsg" Content="{lex:Loc Common_PleaseSelect}" />
            <StatusBarItem HorizontalAlignment="Right">
                <ProgressBar x:Name="StatusProgressBar" IsIndeterminate="True" Width="400" Height="15" Visibility="Hidden" />
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
