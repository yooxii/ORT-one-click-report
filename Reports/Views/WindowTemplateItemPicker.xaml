<Window x:Class="ORT一键报告.Reports.Views.WindowTemplateItemPicker" Background="{DynamicResource WindowBackgroundBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:lex="http://wpflocalizeextension.codeplex.com"
        mc:Ignorable="d"
        Title="{lex:Loc ReportTemplate_PickItemTitle}" Height="520" Width="780" MinHeight="360" MinWidth="560"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,6">
            <Label Content="{lex:Loc Common_Search}" VerticalAlignment="Center"/>
            <TextBox x:Name="txt_search" VerticalContentAlignment="Center" TextChanged="Txt_Search_TextChanged"
                     ToolTip="{lex:Loc ReportTemplate_PickItemHint}"/>
        </DockPanel>

        <DataGrid x:Name="dg_items" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                  CanUserReorderColumns="True" IsReadOnly="True" SelectionMode="Extended" SelectionUnit="FullRow"
                  HeadersVisibility="Column" GridLinesVisibility="Horizontal" ClipboardCopyMode="None"
                  MouseDoubleClick="Dg_Items_MouseDoubleClick">
            <DataGrid.Columns>
                <DataGridTextColumn Header="{lex:Loc ReportTemplate_Item}" Binding="{Binding Name}" Width="*"/>
                <DataGridTextColumn Header="{lex:Loc ReportTemplate_PeriodHours}" Binding="{Binding Period}" Width="120"/>
                <DataGridTextColumn Header="{lex:Loc ReportTemplate_Owner}" Binding="{Binding OwnerDisplay}" Width="150"/>
                <DataGridTextColumn Header="{lex:Loc ReportTemplate_Remark}" Binding="{Binding Remark}" Width="180"/>
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock x:Name="txt_hint" Grid.Row="2" Text="{lex:Loc ReportTemplate_PickItemHint}" TextWrapping="Wrap"
                   Margin="0,6,0,0" Foreground="{DynamicResource TextSecondaryBrush}"/>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="{lex:Loc Common_OK}" IsDefault="True" MinWidth="92" Padding="12,4" Click="Btn_Ok_Click"/>
            <Button Content="{lex:Loc Common_Cancel}" IsCancel="True" MinWidth="92" Padding="12,4" Margin="8,0,0,0"/>
        </StackPanel>
    </Grid>
</Window>
