<Window x:Class="ORT一键报告.Reports.Views.ATEWindow" Background="{DynamicResource WindowBackgroundBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:lex="http://wpflocalizeextension.codeplex.com"
        xmlns:local="clr-namespace:ORT一键报告"
        mc:Ignorable="d"
        Title="{lex:Loc ATE_Title}" Height="780" Width="1240" MinHeight="520" MinWidth="900"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <!-- 行标题就是拖动把手：给出可见的底色和拖动光标，否则用户不知道能拖 -->
        <Style x:Key="AteRowHeaderStyle" TargetType="DataGridRowHeader">
            <Setter Property="Width" Value="26"/>
            <Setter Property="Cursor" Value="SizeAll"/>
            <Setter Property="Background" Value="{DynamicResource BorderSubtleBrush}"/>
            <Setter Property="ToolTip" Value="{lex:Loc ATE_DragHandle}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridRowHeader">
                        <Border Background="{TemplateBinding Background}" BorderThickness="0,0,1,1" BorderBrush="{DynamicResource BorderSubtleBrush}">
                            <TextBlock Text="&#x2261;" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid Margin="6">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>

        <!-- 菜单 -->
        <Menu Grid.Row="0" VerticalContentAlignment="Center">
            <MenuItem Header="{lex:Loc Common_Open}" Click="OpenATEDatas_Click"/>
            <MenuItem Header="{lex:Loc ATE_Reload}" Click="btn_reread_Click"/>
            <MenuItem Header="{lex:Loc Common_Exit}" Click="Close_Click"/>
        </Menu>

        <!-- 模板路径 -->
        <Grid Grid.Row="1" Margin="0,4,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition/>
                <ColumnDefinition Width="auto"/>
            </Grid.ColumnDefinitions>
            <Label Content="{lex:Loc ATE_Template}" VerticalAlignment="Center"/>
            <TextBox x:Name="text_ATETemplate" Grid.Column="1" VerticalContentAlignment="Center" Margin="3,0"/>
            <Button x:Name="btn_ATETemplate" Content="{lex:Loc Common_Browse}" Grid.Column="2" MinWidth="80" Click="btn_ATETemplate_Click"/>
        </Grid>

        <!-- 工具栏：除保存 / 提交到报告外的按钮都在这一行 -->
        <WrapPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,5">
            <Button x:Name="btn_nextBad" Content="{lex:Loc ATE_NextOutOfSpec}" MinWidth="130" Margin="0,0,6,0" Click="NextOutOfSpec_Click"/>
            <Button x:Name="btn_reread" Content="{lex:Loc ATE_Reload}" MinWidth="90" Margin="0,0,14,0" Click="btn_reread_Click"/>
            <Button x:Name="btn_toPre" Content="{lex:Loc ATE_MoveToPre}" MinWidth="100" Margin="0,0,6,0" Click="MoveToPre_Click"/>
            <Button x:Name="btn_toPost" Content="{lex:Loc ATE_MoveToPost}" MinWidth="100" Margin="0,0,6,0" Click="MoveToPost_Click"/>
            <Button x:Name="btn_toPool" Content="{lex:Loc ATE_MoveOut}" MinWidth="80" Margin="0,0,14,0" Click="MoveToPool_Click"/>
            <TextBlock x:Name="txt_counts" VerticalAlignment="Center" FontWeight="Bold" Margin="0,0,14,0"/>
            <TextBlock x:Name="txt_bad" VerticalAlignment="Center"/>
        </WrapPanel>

        <!-- 数据区：三个区域垂直排列，宽度拉满、能看到更多数据与更多行 -->
        <Grid Grid.Row="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="2*"/>
                <RowDefinition Height="2*"/>
                <RowDefinition Height="1*"/>
            </Grid.RowDefinitions>

            <!-- 试验前 -->
            <Grid Grid.Row="0" Margin="0,0,0,4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto"/>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                <TextBlock x:Name="txt_preTitle" Text="{lex:Loc ATE_PreTest}" FontWeight="Bold" Margin="2,0,0,3"/>
                <DataGrid x:Name="dg_pre" Grid.Row="1"
                          AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                          CanUserReorderColumns="False" CanUserResizeRows="False"
                          HeadersVisibility="All" RowHeaderWidth="26" RowHeaderStyle="{StaticResource AteRowHeaderStyle}"
                          SelectionUnit="Cell" SelectionMode="Extended"
                          GridLinesVisibility="All" ClipboardCopyMode="None"
                          AllowDrop="True" DragOver="DropTarget_DragOver" Drop="Grid_Drop"
                          PreviewMouseLeftButtonDown="Grid_PreviewMouseLeftButtonDown"
                          PreviewMouseMove="Grid_PreviewMouseMove"/>
            </Grid>

            <!-- 试验后 -->
            <Grid Grid.Row="1" Margin="0,0,0,4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto"/>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                <TextBlock x:Name="txt_postTitle" Text="{lex:Loc ATE_PostTest}" FontWeight="Bold" Margin="2,0,0,3"/>
                <DataGrid x:Name="dg_post" Grid.Row="1"
                          AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                          CanUserReorderColumns="False" CanUserResizeRows="False"
                          HeadersVisibility="All" RowHeaderWidth="26" RowHeaderStyle="{StaticResource AteRowHeaderStyle}"
                          SelectionUnit="Cell" SelectionMode="Extended"
                          GridLinesVisibility="All" ClipboardCopyMode="None"
                          AllowDrop="True" DragOver="DropTarget_DragOver" Drop="Grid_Drop"
                          PreviewMouseLeftButtonDown="Grid_PreviewMouseLeftButtonDown"
                          PreviewMouseMove="Grid_PreviewMouseMove"/>
            </Grid>

            <!-- 未使用的原始数据 -->
            <Grid Grid.Row="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto"/>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                <TextBlock Text="{lex:Loc ATE_Pool}" FontWeight="Bold" Margin="2,0,0,3"/>
                <ListBox x:Name="lb_pool" Grid.Row="1" MinHeight="60" SelectionMode="Extended" DisplayMemberPath="SN"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto"
                         AllowDrop="True" DragOver="DropTarget_DragOver"
                         PreviewMouseLeftButtonDown="Pool_PreviewMouseLeftButtonDown"
                         PreviewMouseMove="Pool_PreviewMouseMove"
                         Drop="Pool_Drop"/>
            </Grid>
        </Grid>

        <TextBlock Grid.Row="4" x:Name="txt_hint" Text="{lex:Loc ATE_DragHint}" TextWrapping="Wrap" Margin="0,5,0,0" Opacity="0.85"/>

        <!-- 最下方：保存 / 提交到报告 -->
        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,2">
            <Button x:Name="btn_save" Content="{lex:Loc Common_Save}" MinWidth="110" Margin="0,0,18,0" Click="SaveATEDatas_Click"/>
            <Label Content="{lex:Loc ATE_ReportType}" VerticalAlignment="Center"/>
            <ComboBox x:Name="cmb_reportType" MinWidth="150" VerticalContentAlignment="Center"/>
            <Button x:Name="btn_submit" Content="{lex:Loc ATE_Submit}" MinWidth="130" Margin="10,0,0,0" Click="SubmitToReport_Click"/>
        </StackPanel>
    </Grid>
</Window>
