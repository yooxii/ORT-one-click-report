<Window x:Class="ORT一键报告.Review.Views.WindowReviewDetail" Background="{DynamicResource WindowBackgroundBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:lex="http://wpflocalizeextension.codeplex.com"
        mc:Ignorable="d"
        Title="{lex:Loc ReviewDetail_Title}" Height="620" Width="760" MinHeight="480" MinWidth="640"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>

        <!--请求基本信息-->
        <Border BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="3" Padding="10">
            <StackPanel>
                <TextBlock x:Name="txt_summary" FontSize="14" FontWeight="Bold" TextWrapping="Wrap"/>
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <TextBlock x:Name="txt_meta" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <TextBlock Grid.Row="1" Text="{lex:Loc ReviewDetail_ChangeContent}" Margin="0,10,0,3"/>

        <!--更改内容（格式化JSON）-->
        <TextBox x:Name="txt_payload" Grid.Row="2" IsReadOnly="True"
                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                 FontFamily="Consolas" AcceptsReturn="True" TextWrapping="NoWrap"/>

        <!--审核意见-->
        <Grid Grid.Row="3" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Label Content="{lex:Loc ReviewDetail_Opinion}" VerticalContentAlignment="Center"/>
            <TextBox x:Name="txt_comment" Grid.Column="1" VerticalContentAlignment="Center"
                     ToolTip="{lex:Loc ReviewDetail_RejectHint}"/>
        </Grid>

        <!--操作按钮-->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="btn_approve" Content="{lex:Loc Common_Approve}" Width="100" Height="30" Click="Btn_Approve_Click"
                    Background="{DynamicResource StatusOkBgBrush}"/>
            <Button x:Name="btn_reject" Content="{lex:Loc Common_Reject}" Width="100" Height="30" Margin="10,0,0,0" Click="Btn_Reject_Click"
                    Background="{DynamicResource StatusErrorBgBrush}"/>
            <Button Content="{lex:Loc Common_Close}" Width="100" Height="30" Margin="10,0,0,0" Click="Btn_Close_Click" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
