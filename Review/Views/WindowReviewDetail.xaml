<Window x:Class="ORT一键报告.Review.Views.WindowReviewDetail"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="请求详情" Height="620" Width="760" MinHeight="480" MinWidth="640"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>

        <!--请求基本信息-->
        <Border BorderBrush="#FFCCCCCC" BorderThickness="1" CornerRadius="3" Padding="10">
            <StackPanel>
                <TextBlock x:Name="txt_summary" FontSize="14" FontWeight="Bold" TextWrapping="Wrap"/>
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <TextBlock x:Name="txt_meta" Foreground="Gray" TextWrapping="Wrap"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <TextBlock Grid.Row="1" Text="更改内容：" Margin="0,10,0,3"/>

        <!--更改内容（格式化JSON）-->
        <TextBox x:Name="txt_payload" Grid.Row="2" IsReadOnly="True"
                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                 FontFamily="Consolas" AcceptsReturn="True" TextWrapping="NoWrap"/>

        <!--审核意见-->
        <Grid Grid.Row="3" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Label Content="审核意见" VerticalContentAlignment="Center"/>
            <TextBox x:Name="txt_comment" Grid.Column="1" VerticalContentAlignment="Center"
                     ToolTip="驳回时建议填写原因"/>
        </Grid>

        <!--操作按钮-->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="btn_approve" Content="通过" Width="100" Height="30" Click="Btn_Approve_Click"
                    Background="#FFE8F5E9"/>
            <Button x:Name="btn_reject" Content="驳回" Width="100" Height="30" Margin="10,0,0,0" Click="Btn_Reject_Click"
                    Background="#FFFFEBEE"/>
            <Button Content="关闭" Width="100" Height="30" Margin="10,0,0,0" Click="Btn_Close_Click" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
