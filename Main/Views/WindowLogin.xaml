<Window x:Class="ORT一键报告.Main.Views.WindowLogin"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="登录" Height="240" Width="360" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="auto"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>

        <Label Content="用户名" VerticalContentAlignment="Center"/>
        <TextBox x:Name="txt_username" Grid.Column="1" Margin="5" VerticalContentAlignment="Center"/>

        <Label Content="密码" Grid.Row="1" VerticalContentAlignment="Center"/>
        <PasswordBox x:Name="txt_password" Grid.Row="1" Grid.Column="1" Margin="5" VerticalContentAlignment="Center"
                     KeyDown="Txt_Password_KeyDown"/>

        <TextBlock x:Name="txt_error" Grid.Row="2" Grid.ColumnSpan="2" Foreground="Red"
                   TextWrapping="Wrap" VerticalAlignment="Center"/>

        <StackPanel Grid.Row="3" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="登录" Width="90" Height="28" Click="Btn_Login_Click" IsDefault="True"/>
            <Button Content="取消" Width="90" Height="28" Margin="10,0,0,0" Click="Btn_Cancel_Click" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
