<Window x:Class="ORT一键报告.Main.Views.WindowLogin" Background="{DynamicResource WindowBackgroundBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:lex="http://wpflocalizeextension.codeplex.com"
        mc:Ignorable="d"
        Title="{lex:Loc WindowLogin_Title}" Height="270" Width="400" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="auto"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>

        <!--上次登录 cookie 提示（分行展示：提示在上、按钮在下，避免按钮溢出）-->
        <Border x:Name="panel_cookie" Grid.ColumnSpan="2" Margin="0,0,0,8" Padding="8,6"
                Background="{DynamicResource ItemSelectedBrush}" BorderBrush="{DynamicResource PrimaryBrush}" BorderThickness="1" CornerRadius="3" Visibility="Collapsed">
            <StackPanel>
                <TextBlock x:Name="txt_cookieHint" TextWrapping="Wrap" Margin="0,0,0,6"/>
                <Button x:Name="btn_continue" Content="{lex:Loc WindowLogin_Button_ContinueLogin}" HorizontalAlignment="Right" Padding="12,4" Click="Btn_ContinueLogin_Click"/>
            </StackPanel>
        </Border>

        <Label Content="{lex:Loc WindowLogin_Label_Username}" Grid.Row="1" VerticalContentAlignment="Center"/>
        <TextBox x:Name="txt_username" Grid.Row="1" Grid.Column="1" Margin="5" VerticalContentAlignment="Center"/>

        <Label Content="{lex:Loc WindowLogin_Label_Password}" Grid.Row="2" VerticalContentAlignment="Center"/>
        <PasswordBox x:Name="txt_password" Grid.Row="2" Grid.Column="1" Margin="5" VerticalContentAlignment="Center"
                     KeyDown="Txt_Password_KeyDown"/>

        <TextBlock x:Name="txt_error" Grid.Row="3" Grid.ColumnSpan="2" Foreground="{DynamicResource StatusErrorBrush}"
                   TextWrapping="Wrap" VerticalAlignment="Center"/>

        <StackPanel Grid.Row="4" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="{lex:Loc WindowLogin_Button_Login}" Width="90" Height="28" Click="Btn_Login_Click" IsDefault="True"/>
            <Button Content="{lex:Loc WindowLogin_Button_Cancel}" Width="90" Height="28" Margin="10,0,0,0" Click="Btn_Cancel_Click" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
