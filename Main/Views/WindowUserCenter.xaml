<Window x:Class="ORT一键报告.Main.Views.WindowUserCenter" Background="{DynamicResource WindowBackgroundBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:lex="http://wpflocalizeextension.codeplex.com"
        mc:Ignorable="d"
        Title="{lex:Loc UserCenter_Title}" Height="560" Width="560" MinHeight="440" MinWidth="460"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>

        <!--账号信息（只读）-->
        <GroupBox Grid.Row="0" Header="{lex:Loc UserCenter_BasicInfo}" Padding="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" MinWidth="90"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                </Grid.RowDefinitions>

                <Label Content="{lex:Loc UserCenter_Username}" VerticalContentAlignment="Center"/>
                <TextBlock x:Name="txt_username" Grid.Column="1" VerticalAlignment="Center" TextWrapping="Wrap"/>

                <Label Grid.Row="1" Content="{lex:Loc UserCenter_Roles}" VerticalContentAlignment="Center"/>
                <TextBlock x:Name="txt_roles" Grid.Row="1" Grid.Column="1" VerticalAlignment="Center" TextWrapping="Wrap"/>

                <Label Grid.Row="2" Content="{lex:Loc UserCenter_CreatedAt}" VerticalContentAlignment="Center"/>
                <TextBlock x:Name="txt_createdAt" Grid.Row="2" Grid.Column="1" VerticalAlignment="Center"/>
            </Grid>
        </GroupBox>

        <!--基本资料（可改：显示名 / 邮箱）-->
        <GroupBox Grid.Row="1" Header="{lex:Loc UserCenter_ProfileSection}" Padding="8" Margin="0,10,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" MinWidth="90"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                </Grid.RowDefinitions>

                <Label Content="{lex:Loc Admin_DisplayName}" VerticalContentAlignment="Center"/>
                <TextBox x:Name="txt_displayName" Grid.Column="1" Margin="4,2" VerticalContentAlignment="Center"/>

                <Label Grid.Row="1" Content="{lex:Loc Admin_Email}" VerticalContentAlignment="Center"/>
                <TextBox x:Name="txt_email" Grid.Row="1" Grid.Column="1" Margin="4,2" VerticalContentAlignment="Center"/>

                <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Text="{lex:Loc UserCenter_ProfileHint}" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0"/>
            </Grid>
        </GroupBox>

        <!--密码（未设置密码时是"设置密码"，已设置时是"修改密码"）-->
        <GroupBox Grid.Row="2" Header="{lex:Loc UserCenter_PasswordSection}" Padding="8" Margin="0,10,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" MinWidth="90"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                </Grid.RowDefinitions>

                <Label x:Name="lbl_currentPassword" Content="{lex:Loc UserCenter_CurrentPassword}" VerticalContentAlignment="Center"/>
                <PasswordBox x:Name="txt_currentPassword" Grid.Column="1" Margin="4,2" VerticalContentAlignment="Center"/>

                <Label Grid.Row="1" Content="{lex:Loc Admin_NewPasswordMin}" VerticalContentAlignment="Center"/>
                <PasswordBox x:Name="txt_newPassword" Grid.Row="1" Grid.Column="1" Margin="4,2" VerticalContentAlignment="Center"/>

                <Label Grid.Row="2" Content="{lex:Loc UserCenter_ConfirmPassword}" VerticalContentAlignment="Center"/>
                <PasswordBox x:Name="txt_confirmPassword" Grid.Row="2" Grid.Column="1" Margin="4,2" VerticalContentAlignment="Center"/>

                <TextBlock x:Name="txt_passwordHint" Grid.Row="3" Grid.ColumnSpan="2" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0"/>
            </Grid>
        </GroupBox>

        <!--本机登录信息：cookie 到期时间，可清除-->
        <GroupBox Grid.Row="3" Header="{lex:Loc UserCenter_LocalLogin}" Padding="8" Margin="0,10,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="txt_cookie" VerticalAlignment="Center" TextWrapping="Wrap"/>
                <Button x:Name="btn_clearCookie" Grid.Column="1" Content="{lex:Loc UserCenter_ClearCookie}" Padding="10,3"
                        Margin="10,0,0,0" Click="Btn_ClearCookie_Click"/>
            </Grid>
        </GroupBox>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="btn_save" Content="{lex:Loc Common_Save}" Width="90" Click="Btn_Save_Click" IsDefault="True"/>
            <Button Content="{lex:Loc Common_Close}" Width="90" Margin="10,0,0,0" Click="Btn_Close_Click" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
