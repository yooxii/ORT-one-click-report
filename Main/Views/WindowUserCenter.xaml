<Window x:Class="ORT一键报告.Main.Views.WindowUserCenter" Background="{DynamicResource WindowBackgroundBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:lex="http://wpflocalizeextension.codeplex.com"
        mc:Ignorable="d"
        Title="{lex:Loc UserCenter_Title}" Height="560" Width="520" MinHeight="480" MinWidth="440"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!--账号信息（只读）-->
        <GroupBox Grid.Row="0" Header="{lex:Loc UserCenter_BasicInfo}" Padding="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" MinWidth="90"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Label Content="{lex:Loc UserCenter_Username}" VerticalContentAlignment="Center"/>
                <TextBlock x:Name="txt_username" Grid.Column="1" VerticalAlignment="Center" TextWrapping="Wrap"/>

                <Label Grid.Row="1" Content="{lex:Loc UserCenter_Roles}" VerticalContentAlignment="Center"/>
                <TextBlock x:Name="txt_roles" Grid.Row="1" Grid.Column="1" VerticalAlignment="Center" TextWrapping="Wrap"/>

                <Label Grid.Row="2" Content="{lex:Loc UserCenter_CreatedAt}" VerticalContentAlignment="Center"/>
                <TextBlock x:Name="txt_createdAt" Grid.Row="2" Grid.Column="1" VerticalAlignment="Center"/>

                <Label Grid.Row="3" Content="{lex:Loc UserCenter_LocalLogin}" VerticalContentAlignment="Center"/>
                <Grid Grid.Row="3" Grid.Column="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="txt_cookie" VerticalAlignment="Center" TextWrapping="Wrap"/>
                    <Button x:Name="btn_clearCookie" Grid.Column="1" Content="{lex:Loc UserCenter_ClearCookie}"
                            Padding="10,3" Margin="10,0,0,0" Click="Btn_ClearCookie_Click"/>
                </Grid>
            </Grid>
        </GroupBox>

        <!--基本资料（可改：显示名 / 邮箱）-->
        <GroupBox Grid.Row="1" Header="{lex:Loc UserCenter_ProfileSection}" Padding="8" Margin="0,10,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" MinWidth="90"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Label Content="{lex:Loc Admin_DisplayName}" VerticalContentAlignment="Center"/>
                <TextBox x:Name="txt_displayName" Grid.Column="1" Margin="4,2" VerticalContentAlignment="Center"/>

                <Label Grid.Row="1" Content="{lex:Loc Admin_Email}" VerticalContentAlignment="Center"/>
                <TextBox x:Name="txt_email" Grid.Row="1" Grid.Column="1" Margin="4,2" VerticalContentAlignment="Center"/>

                <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Text="{lex:Loc UserCenter_ProfileHint}" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0"/>
            </Grid>
        </GroupBox>

        <!--账号与权限：点进去到二级窗口-->
        <GroupBox Grid.Row="2" Header="{lex:Loc UserCenter_SecuritySection}" Padding="8" Margin="0,10,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.ColumnSpan="2">
                    <TextBlock Text="{lex:Loc UserCenter_PasswordSection}" FontWeight="SemiBold"/>
                    <TextBlock x:Name="txt_passwordState" TextWrapping="Wrap" Margin="0,2,0,0"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                </StackPanel>
                <Button x:Name="btn_changePassword" Grid.Column="1" Content="{lex:Loc UserCenter_ChangePasswordEntry}"
                        Padding="14,3" VerticalAlignment="Center" Click="Btn_ChangePassword_Click"/>

                <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Margin="0,12,0,0">
                    <TextBlock Text="{lex:Loc UserCenter_RoleApplySection}" FontWeight="SemiBold"/>
                    <TextBlock x:Name="txt_roleState" TextWrapping="Wrap" Margin="0,2,0,0"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                </StackPanel>
                <Button x:Name="btn_roleRequest" Grid.Row="1" Grid.Column="1" Content="{lex:Loc UserCenter_RoleApplyEntry}"
                        Padding="14,3" Margin="0,12,0,0" VerticalAlignment="Center" Click="Btn_RoleRequest_Click"/>
            </Grid>
        </GroupBox>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="btn_save" Content="{lex:Loc Common_Save}" Width="90" Padding="0,3"
                    Click="Btn_Save_Click" IsDefault="True"/>
            <Button Content="{lex:Loc Common_Close}" Width="90" Padding="0,3" Margin="10,0,0,0"
                    Click="Btn_Close_Click" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
