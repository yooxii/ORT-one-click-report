<UserControl x:Class="ORT一键报告.Views.UserControlReturnLineSingle"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:lex="http://wpflocalizeextension.codeplex.com" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ORT一键报告.Views"
             xmlns:viewmodels="clr-namespace:ORT一键报告.ViewModels"
             d:DataContext="{d:DesignInstance Type=viewmodels:ReturnLineSingleViewModel}"
             mc:Ignorable="d" 
             d:DesignHeight="150" d:DesignWidth="800">
    <Grid Background="White">
        <StackPanel Margin="3">
            <TextBlock Text="{lex:Loc ReturnLineSingle_Title}" FontSize="11" FontFamily="Arial Black" HorizontalAlignment="Center"/>
            <Border BorderBrush="Black" BorderThickness="2">
                <Grid Margin="2">
                    <Grid.RowDefinitions>
                        <RowDefinition/>
                        <RowDefinition/>
                        <RowDefinition/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <local:UserControlInputBox Grid.ColumnSpan="2" Label="{lex:Loc ReturnLineSingle_Model}" Text="{Binding Model}"/>
                    <local:UserControlInputBox Grid.Column="2" Label="{lex:Loc ReturnLineSingle_Version}" Text="{Binding Version}"/>
                    <local:UserControlInputBox Grid.Row="0" Grid.Column="3" Grid.ColumnSpan="1" Label="{lex:Loc ReturnLineSingle_DC}" Text="{Binding DC}"/>
                    <local:UserControlInputBox Grid.Row="0" Grid.Column="4" Grid.ColumnSpan="1" Label="{lex:Loc ReturnLineSingle_Count}" Text="{Binding Count}" Unit="PCS"/>
                    <local:UserControlInputBox Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Label="{lex:Loc ReturnLineSingle_TestItem}" Text="{Binding Testitem}"/>
                    <local:UserControlInputBox Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="2" Label="{lex:Loc ReturnLineSingle_WorkerNo}" Text="{Binding WorkerNo}"/>
                    <local:UserControlInputBox Grid.Row="1" Grid.Column="4" Grid.ColumnSpan="1" Label="{lex:Loc ReturnLineSingle_Date}" Text="{Binding Date}"/>
                    <local:UserControlInputBox Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="5" Label="{lex:Loc ReturnLineSingle_Steps}" Text="{Binding Steps}" Height="40"/>
                    <local:UserControlInputBox Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="1" Label="{lex:Loc ReturnLineSingle_ReturnBy}" Text="{Binding ReturnBy}"/>
                    <local:UserControlInputBox Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="1" Label="{lex:Loc ReturnLineSingle_Phone}" Text="{Binding Phone}"/>
                    <local:UserControlInputBox Grid.Row="3" Grid.Column="2" Grid.ColumnSpan="2" Label="{lex:Loc ReturnLineSingle_Receive}" Text="{Binding Recive}"/>
                    <local:UserControlInputBox Grid.Row="3" Grid.Column="4" Grid.ColumnSpan="1" Label="{lex:Loc ReturnLineSingle_LineNo}" Text="{Binding LineNo}"/>
                </Grid>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>
