<Window x:Class="ORT一键报告.Main.Views.WindowBackup" Background="{DynamicResource WindowBackgroundBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:lex="http://wpflocalizeextension.codeplex.com"
        mc:Ignorable="d"
        Title="{lex:Loc Backup_Title}" Width="1060" Height="560" MinWidth="860" MinHeight="400"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">

    <Window.Resources>
        <!--单元格：居中、无边框，长文本省略号显示并在悬停时给出完整值-->
        <Style x:Key="BackupCell" TargetType="DataGridCell">
            <Setter Property="Padding" Value="2,0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>
        <Style x:Key="BackupText" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="ToolTip" Value="{Binding RelativeSource={RelativeSource Self}, Path=Text}"/>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!--说明：备份策略 + 备份文件夹-->
        <TextBlock Text="{lex:Loc Backup_Hint}" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}"/>

        <Grid Grid.Row="1" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="{lex:Loc Backup_Folder}" VerticalAlignment="Center"/>
            <TextBox x:Name="txt_folder" Grid.Column="1" Margin="6,0,0,0" IsReadOnly="True" VerticalContentAlignment="Center"/>
            <Button x:Name="btn_openFolder" Grid.Column="2" Content="{lex:Loc Backup_OpenFolder}" Margin="6,0,0,0" Padding="10,3"
                    Click="Btn_OpenFolder_Click"/>
            <Button x:Name="btn_full" Grid.Column="3" Content="{lex:Loc Backup_FullNow}" Margin="12,0,0,0" Padding="10,3"
                    Click="Btn_Full_Click"/>
            <Button x:Name="btn_incremental" Grid.Column="4" Content="{lex:Loc Backup_IncrementalNow}" Margin="6,0,0,0" Padding="10,3"
                    Click="Btn_Incremental_Click"/>
            <Button x:Name="btn_refresh" Grid.Column="5" Content="{lex:Loc Common_Refresh}" Margin="6,0,0,0" Padding="10,3"
                    Click="Btn_Refresh_Click"/>
        </Grid>

        <!--快照清单：全量 + 增量，按时间倒序-->
        <DataGrid x:Name="dg_backups" Grid.Row="2" Margin="0,10,0,0"
                  AutoGenerateColumns="False" CanUserAddRows="False" CanUserSortColumns="False"
                  CanUserReorderColumns="False" IsReadOnly="True"
                  HeadersVisibility="Column" GridLinesVisibility="All"
                  SelectionMode="Extended" SelectionUnit="FullRow"
                  ClipboardCopyMode="None"
                  CellStyle="{StaticResource BackupCell}"
                  VirtualizingPanel.IsVirtualizing="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="{lex:Loc Backup_Col_Time}" Width="140"
                                    Binding="{Binding TimeText}" ElementStyle="{StaticResource BackupText}"/>
                <DataGridTextColumn Header="{lex:Loc Backup_Col_Kind}" Width="60"
                                    Binding="{Binding KindText}" ElementStyle="{StaticResource BackupText}"/>
                <DataGridTextColumn Header="{lex:Loc Backup_Col_Size}" Width="80"
                                    Binding="{Binding SizeText}" ElementStyle="{StaticResource BackupText}"/>
                <DataGridTextColumn Header="{lex:Loc Backup_Col_Changed}" Width="80"
                                    Binding="{Binding ChangedText}" ElementStyle="{StaticResource BackupText}"/>
                <DataGridTextColumn Header="{lex:Loc Backup_Col_Base}" Width="230"
                                    Binding="{Binding BaseFileName}" ElementStyle="{StaticResource BackupText}"/>
                <DataGridTextColumn Header="{lex:Loc Backup_Col_File}" Width="*" MinWidth="220"
                                    Binding="{Binding FileName}" ElementStyle="{StaticResource BackupText}"/>
                <DataGridTextColumn Header="{lex:Loc Backup_Col_State}" Width="200"
                                    Binding="{Binding StateText}" ElementStyle="{StaticResource BackupText}"/>
            </DataGrid.Columns>
        </DataGrid>

        <!--底部：状态提示 + 还原/删除/关闭-->
        <Grid Grid.Row="3" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="txt_status" VerticalAlignment="Center" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextSecondaryBrush}"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="btn_restore" Content="{lex:Loc Backup_Restore}" Padding="10,3" Click="Btn_Restore_Click"/>
                <Button x:Name="btn_delete" Content="{lex:Loc Backup_Delete}" Padding="10,3" Margin="10,0,0,0" Click="Btn_Delete_Click"/>
                <Button x:Name="btn_close" Content="{lex:Loc Common_Close}" Width="90" Margin="10,0,0,0" Click="Btn_Close_Click" IsCancel="True"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
