<Window x:Class="ORT一键报告.Main.Views.WindowRoleRequest"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:lex="http://wpflocalizeextension.codeplex.com"
        mc:Ignorable="d"
        Background="{DynamicResource WindowBackgroundBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
        Title="{lex:Loc UserCenter_RoleApplyTitle}" Width="480" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">

    <StackPanel Margin="16">
        <TextBlock Text="{lex:Loc UserCenter_RoleApplyHint}" TextWrapping="Wrap"
                   Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,10"/>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" MinWidth="90"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Label Content="{lex:Loc UserCenter_RoleApplyTarget}" VerticalContentAlignment="Center"/>
            <ComboBox x:Name="cb_roleTarget" Grid.Column="1" Margin="4,3" VerticalContentAlignment="Center"
                      SelectionChanged="Cb_RoleTarget_SelectionChanged"/>

            <Label Grid.Row="1" Content="{lex:Loc UserCenter_RoleApplyApprover}" VerticalContentAlignment="Center"/>
            <ComboBox x:Name="cb_roleApprover" Grid.Row="1" Grid.Column="1" Margin="4,3"
                      VerticalContentAlignment="Center" DisplayMemberPath="Display"/>

            <Label Grid.Row="2" Content="{lex:Loc UserCenter_RoleApplyNote}" VerticalContentAlignment="Center"/>
            <TextBox x:Name="txt_roleNote" Grid.Row="2" Grid.Column="1" Margin="4,3"
                     VerticalContentAlignment="Center" ToolTip="{lex:Loc UserCenter_RoleApplyNoteHint}"/>

            <TextBlock x:Name="txt_roleState" Grid.Row="3" Grid.ColumnSpan="2" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,8,0,0"/>

            <StackPanel Grid.Row="4" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right"
                        Margin="0,12,0,0">
                <Button x:Name="btn_applyRole" Content="{lex:Loc UserCenter_RoleApplySubmit}" Padding="14,3"
                        Click="Btn_ApplyRole_Click" IsDefault="True"/>
                <Button Content="{lex:Loc Common_Close}" Width="90" Padding="0,3" Margin="10,0,0,0"
                        IsCancel="True" Click="Btn_Close_Click"/>
            </StackPanel>
        </Grid>
    </StackPanel>
</Window>
