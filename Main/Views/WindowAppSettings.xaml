<Window x:Class="ORT一键报告.Main.Views.WindowAppSettings" Background="{DynamicResource WindowBackgroundBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:lex="http://wpflocalizeextension.codeplex.com"
        mc:Ignorable="d"
        Title="{lex:Loc Settings_Title}" Height="600" Width="900" MinHeight="450" MinWidth="720"
        WindowStartupLocation="CenterOwner">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
        <Grid.ColumnDefinitions>
            <!-- 目录列随文字自适应（字号调大时不再截断节点名） -->
            <ColumnDefinition Width="Auto" MinWidth="180" MaxWidth="380"/>
            <ColumnDefinition Width="5"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <!--左侧：树状目录预览-->
        <Border Grid.Column="0" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,0,1,0" Padding="8">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="{lex:Loc Settings_DirTab}" FontWeight="Bold" FontSize="14" Margin="4,2,4,8"/>
                <TreeView x:Name="tv_settings" BorderThickness="0" SelectedItemChanged="Tv_Settings_SelectedItemChanged">
                    <TreeViewItem Header="UI" IsExpanded="True" Tag="sec_ui">
                        <TreeViewItem Header="{lex:Loc Settings_Theme}" Tag="sec_theme"/>
                        <TreeViewItem Header="{lex:Loc Settings_Language}" Tag="sec_language"/>
                        <TreeViewItem Header="{lex:Loc Settings_Font}" Tag="sec_font"/>
                    </TreeViewItem>
                    <TreeViewItem Header="{lex:Loc Settings_Path}" IsExpanded="True" Tag="sec_paths">
                        <TreeViewItem Header="{lex:Loc Settings_ATEPath}" Tag="sec_ate"/>
                        <TreeViewItem Header="{lex:Loc Settings_EMIPath}" Tag="sec_emi"/>
                        <TreeViewItem Header="{lex:Loc Settings_DBPath}" Tag="sec_dbpath"/>
                        <TreeViewItem Header="{lex:Loc Settings_PlanPath}" Tag="sec_schedule"/>
                        <TreeViewItem Header="{lex:Loc Settings_RequisitionPath}" Tag="sec_requisition"/>
                        <TreeViewItem Header="{lex:Loc Settings_ReportPath}" Tag="sec_report"/>
                    </TreeViewItem>
                    <TreeViewItem Header="{lex:Loc Settings_Mail}" IsExpanded="True" Tag="sec_mail">
                        <TreeViewItem Header="{lex:Loc Settings_MailTemplates}" Tag="sec_mail_template"/>
                    </TreeViewItem>
                    <TreeViewItem Header="{lex:Loc PlanIndex_Settings_Title}" Tag="sec_planindex"/>
                </TreeView>
            </DockPanel>
        </Border>

        <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="Transparent"/>

        <!--右侧：设置项详情（标签列 Auto 以随字号自适应）
            注意：横向滚动必须保持 Disabled——带长文本的 TextBlock 即使 TextWrapping=Wrap，
            仍按“单行完整宽度”上报期望宽度（如邮件模板的变量说明约 3300px），
            一旦开启 Auto，整个详情面板会被这行文字撑宽并溢出-->
        <ScrollViewer x:Name="sv_right" Grid.Column="2" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled" ScrollChanged="Sv_Right_ScrollChanged">
            <StackPanel Margin="16" Grid.IsSharedSizeScope="True">

                <!-- UI -->
                <Border x:Name="sec_ui" Padding="0,4">
                    <StackPanel>
                        <TextBlock Text="UI" FontSize="20" FontWeight="Bold"/>
                        <TextBlock Text="{lex:Loc Settings_AppearanceTab}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>

                <Border x:Name="sec_theme" Padding="0,10">
                    <StackPanel>
                        <TextBlock Text="{lex:Loc Settings_Theme}" FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock Text="{lex:Loc Settings_ThemeHint}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,8"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="SettingsLabel"/>
                                <ColumnDefinition Width="*" MinWidth="200"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{lex:Loc Settings_Theme}" VerticalAlignment="Center"/>
                            <ComboBox x:Name="cb_theme" Grid.Column="1" VerticalContentAlignment="Center" SelectedValuePath="Code" SelectionChanged="Cb_Theme_SelectionChanged">
                                                            <ComboBox.ItemTemplate>
                                                                <DataTemplate>
                                                                    <TextBlock Text="{Binding DisplayName}"/>
                                                                </DataTemplate>
                                                            </ComboBox.ItemTemplate>
                                                        </ComboBox>
                            <Button x:Name="btn_importTheme" Grid.Column="3" Content="{lex:Loc Settings_ImportTheme}" Click="Btn_ImportTheme_Click" ToolTip="{lex:Loc Settings_ImportThemeHint}"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <Separator Margin="0,12"/>

                <Border x:Name="sec_language" Padding="0,10">
                    <StackPanel>
                        <TextBlock Text="{lex:Loc Settings_Language}" FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock Text="{lex:Loc Settings_LanguageHint}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,8"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="SettingsLabel"/>
                                <ColumnDefinition Width="*" MinWidth="180"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{lex:Loc Settings_Language}" VerticalAlignment="Center"/>
                            <ComboBox x:Name="cb_language" Grid.Column="1" VerticalContentAlignment="Center" SelectedValuePath="Code" SelectionChanged="Cb_Language_SelectionChanged">
                                                            <ComboBox.ItemTemplate>
                                                                <DataTemplate>
                                                                    <TextBlock Text="{Binding DisplayName}"/>
                                                                </DataTemplate>
                                                            </ComboBox.ItemTemplate>
                                                        </ComboBox>
                        </Grid>
                    </StackPanel>
                </Border>

                <Separator Margin="0,12"/>

                <Border x:Name="sec_font" Padding="0,10">
                    <StackPanel>
                        <TextBlock Text="{lex:Loc Settings_Font}" FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock Text="{lex:Loc Settings_FontHint}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,8" TextWrapping="Wrap"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="SettingsLabel"/>
                                <ColumnDefinition Width="*" MinWidth="160"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="SettingsLabel"/>
                                <ColumnDefinition Width="Auto" MinWidth="90"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{lex:Loc Settings_FontFamily}" VerticalAlignment="Center"/>
                            <ComboBox x:Name="cb_fontFamily" Grid.Column="1" VerticalContentAlignment="Center"/>
                            <TextBlock Text="{lex:Loc Settings_FontSize}" Grid.Column="3" VerticalAlignment="Center"/>
                            <ComboBox x:Name="cb_fontSize" Grid.Column="4" VerticalContentAlignment="Center" IsEditable="True"
                                      ToolTip="{lex:Loc Settings_FontSizeHint}"/>
                        </Grid>
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="SettingsLabel"/>
                                <ColumnDefinition Width="Auto" MinWidth="180"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{lex:Loc Settings_FontWeight}" VerticalAlignment="Center"
                                       ToolTip="{lex:Loc Settings_FontWeightHint}"/>
                            <ComboBox x:Name="cb_fontWeight" Grid.Column="1" VerticalContentAlignment="Center" SelectedValuePath="Code">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding DisplayName}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </Grid>
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="SettingsLabel"/>
                                <ColumnDefinition Width="Auto" MinWidth="180"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{lex:Loc Settings_ToastPosition}" VerticalAlignment="Center" ToolTip="{lex:Loc Settings_ToastPositionHint}"/>
                            <ComboBox x:Name="cb_toastPos" Grid.Column="1" VerticalContentAlignment="Center" SelectedValuePath="Code">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding DisplayName}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </Grid>
                    </StackPanel>
                </Border>

                <Separator Margin="0,12"/>

                <!-- 路径 -->
                <Border x:Name="sec_paths" Padding="0,4">
                    <StackPanel>
                        <TextBlock Text="{lex:Loc Settings_Path}" FontSize="20" FontWeight="Bold"/>
                        <TextBlock Text="{lex:Loc Settings_DirHint}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>

                <Border x:Name="sec_ate" Padding="0,10">
                    <StackPanel>
                        <TextBlock Text="{lex:Loc Settings_ATEPath}" FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock Text="{lex:Loc Settings_ATEPathHint}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,8" TextWrapping="Wrap"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="txt_ate" VerticalContentAlignment="Center"/>
                            <Button Content="{lex:Loc Common_BrowseEllipsis}" Grid.Column="2" Padding="6,3" Click="Btn_Browse_Click" Tag="AteDataPath"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border x:Name="sec_emi" Padding="0,10">
                    <StackPanel>
                        <TextBlock Text="{lex:Loc Settings_EMIPath}" FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock Text="{lex:Loc Settings_EMIPathHint}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,8" TextWrapping="Wrap"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="txt_emi" VerticalContentAlignment="Center"/>
                            <Button Content="{lex:Loc Common_BrowseEllipsis}" Grid.Column="2" Padding="6,3" Click="Btn_Browse_Click" Tag="EmiDataPath"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border x:Name="sec_dbpath" Padding="0,10">
                    <StackPanel>
                        <TextBlock Text="{lex:Loc Settings_DBPath}" FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock Text="{lex:Loc Settings_DBPathHint}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,8" TextWrapping="Wrap"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="txt_dbpath" VerticalContentAlignment="Center"/>
                            <Button x:Name="btn_dbpathBrowse" Content="{lex:Loc Common_BrowseEllipsis}" Grid.Column="2" Padding="6,3" Click="Btn_DbPathBrowse_Click"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border x:Name="sec_schedule" Padding="0,10">
                    <StackPanel>
                        <TextBlock Text="{lex:Loc Settings_PlanPath}" FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock Text="{lex:Loc Settings_PlanPathHint}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,8" TextWrapping="Wrap"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="txt_schedule" VerticalContentAlignment="Center"/>
                            <Button Content="{lex:Loc Common_BrowseEllipsis}" Grid.Column="2" Padding="6,3" Click="Btn_Browse_Click" Tag="SchedulePath"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border x:Name="sec_requisition" Padding="0,10">
                    <StackPanel>
                        <TextBlock Text="{lex:Loc Settings_RequisitionPath}" FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock Text="{lex:Loc Settings_ReqPathHint}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,8" TextWrapping="Wrap"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="txt_requisition" VerticalContentAlignment="Center"/>
                            <Button Content="{lex:Loc Common_BrowseEllipsis}" Grid.Column="2" Padding="6,3" Click="Btn_Browse_Click" Tag="RequisitionPath"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border x:Name="sec_report" Padding="0,10">
                    <StackPanel>
                        <TextBlock Text="{lex:Loc Settings_ReportPath}" FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock Text="{lex:Loc Settings_ReportPathHint}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,8" TextWrapping="Wrap"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="txt_report" VerticalContentAlignment="Center"/>
                            <Button Content="{lex:Loc Common_BrowseEllipsis}" Grid.Column="2" Padding="6,3" Click="Btn_Browse_Click" Tag="ReportPath"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!--计划索引（空闲自动执行）；仅管理员可见-->
                <Border x:Name="sec_planindex" Padding="0,10">
                    <StackPanel>
                        <TextBlock Text="{lex:Loc PlanIndex_Settings_Title}" FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock Text="{lex:Loc PlanIndex_Settings_AutoHint}" Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextWrapping="Wrap" Margin="0,2,0,8"/>
                        <CheckBox x:Name="chk_planIndexAuto" Content="{lex:Loc PlanIndex_Settings_Auto}" Margin="0,2,0,8"/>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <Label Content="{lex:Loc PlanIndex_Settings_Idle}" VerticalContentAlignment="Center"/>
                            <TextBox x:Name="txt_planIndexIdle" Width="70" VerticalContentAlignment="Center" Margin="4,0,0,0"/>
                        </StackPanel>
                        <TextBlock Text="{lex:Loc PlanIndex_Settings_IdleHint}" Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextWrapping="Wrap" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <!--邮件服务（发件账号 + 触发规则）；仅管理员可见-->
                <Border x:Name="sec_mail" Padding="0,10">
                    <StackPanel>
                        <TextBlock Text="{lex:Loc Settings_Mail}" FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock Text="{lex:Loc Settings_MailHint}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,2,0,8"/>

                        <CheckBox x:Name="chk_mailEnabled" Content="{lex:Loc Settings_MailEnabled}" Margin="0,2,0,8"/>
                        <CheckBox x:Name="chk_mailNoticeEnabled" Content="{lex:Loc Settings_MailNoticeEnabled}" Margin="0,2,0,8"/>
                        <CheckBox x:Name="chk_mailWarningEnabled" Content="{lex:Loc Settings_MailWarningEnabled}" Margin="0,2,0,8"/>

                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="SettingsLabel"/>
                                <ColumnDefinition Width="*" MinWidth="140"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="SettingsLabel"/>
                                <ColumnDefinition Width="Auto" MinWidth="70"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{lex:Loc Settings_MailHost}" VerticalAlignment="Center"/>
                            <TextBox x:Name="txt_mailHost" Grid.Column="1" VerticalContentAlignment="Center"/>
                            <TextBlock Text="{lex:Loc Settings_MailPort}" Grid.Column="3" VerticalAlignment="Center"/>
                            <TextBox x:Name="txt_mailPort" Grid.Column="4" VerticalContentAlignment="Center"/>
                        </Grid>

                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="SettingsLabel"/>
                                <ColumnDefinition Width="*" MinWidth="200"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{lex:Loc Settings_MailSecurity}" VerticalAlignment="Center" ToolTip="{lex:Loc Settings_MailSecurityHint}"/>
                            <ComboBox x:Name="cb_mailSecurity" Grid.Column="1" VerticalContentAlignment="Center">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding DisplayName}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <CheckBox x:Name="chk_mailIgnoreCert" Grid.Column="3" Content="{lex:Loc Settings_MailIgnoreCert}" VerticalAlignment="Center"/>
                        </Grid>

                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="SettingsLabel"/>
                                <ColumnDefinition Width="*" MinWidth="140"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="SettingsLabel"/>
                                <ColumnDefinition Width="Auto" MinWidth="90"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{lex:Loc Settings_MailUser}" VerticalAlignment="Center"/>
                            <TextBox x:Name="txt_mailUser" Grid.Column="1" VerticalContentAlignment="Center"/>
                            <TextBlock Text="{lex:Loc Settings_MailPassword}" Grid.Column="3" VerticalAlignment="Center"/>
                            <PasswordBox x:Name="txt_mailPassword" Grid.Column="4" VerticalContentAlignment="Center"/>
                        </Grid>

                        <CheckBox x:Name="chk_mailDefaultCred" Content="{lex:Loc Settings_MailDefaultCred}" Margin="0,8,0,0" ToolTip="{lex:Loc Settings_MailDefaultCredHint}"/>

                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="SettingsLabel"/>
                                <ColumnDefinition Width="*" MinWidth="140"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="SettingsLabel"/>
                                <ColumnDefinition Width="*" MinWidth="100"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{lex:Loc Settings_MailFrom}" VerticalAlignment="Center"/>
                            <TextBox x:Name="txt_mailFrom" Grid.Column="1" VerticalContentAlignment="Center"/>
                            <TextBlock Text="{lex:Loc Settings_MailFromName}" Grid.Column="3" VerticalAlignment="Center"/>
                            <TextBox x:Name="txt_mailFromName" Grid.Column="4" VerticalContentAlignment="Center"/>
                        </Grid>

                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="SettingsLabel"/>
                                <ColumnDefinition Width="*" MinWidth="140"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="SettingsLabel"/>
                                <ColumnDefinition Width="Auto" MinWidth="60"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{lex:Loc Settings_MailCc}" VerticalAlignment="Center" ToolTip="{lex:Loc Settings_MailCcHint}"/>
                            <TextBox x:Name="txt_mailCc" Grid.Column="1" VerticalContentAlignment="Center"/>
                            <TextBlock Text="{lex:Loc Settings_MailTimeout}" Grid.Column="3" VerticalAlignment="Center"/>
                            <TextBox x:Name="txt_mailTimeout" Grid.Column="4" VerticalContentAlignment="Center"/>
                        </Grid>

                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="SettingsLabel"/>
                                <ColumnDefinition Width="Auto" MinWidth="60"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="SettingsLabel"/>
                                <ColumnDefinition Width="Auto" MinWidth="60"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{lex:Loc Settings_MailDaysBefore}" VerticalAlignment="Center" ToolTip="{lex:Loc Settings_MailDaysBeforeHint}"/>
                            <TextBox x:Name="txt_mailDaysBefore" Grid.Column="1" VerticalContentAlignment="Center"/>
                            <TextBlock Text="{lex:Loc Settings_MailDedupe}" Grid.Column="3" VerticalAlignment="Center" ToolTip="{lex:Loc Settings_MailDedupeHint}"/>
                            <TextBox x:Name="txt_mailDedupe" Grid.Column="4" VerticalContentAlignment="Center"/>
                        </Grid>

                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <CheckBox x:Name="chk_mailIncludeOverdue" Content="{lex:Loc Settings_MailIncludeOverdue}" Margin="0,0,16,0"/>
                            <CheckBox x:Name="chk_mailHtml" Content="{lex:Loc Settings_MailHtml}"/>
                        </StackPanel>

                        <TextBlock Text="{lex:Loc Settings_MailCcAdmin}" Margin="0,10,0,4" ToolTip="{lex:Loc Settings_MailCcAdminHint}"/>
                        <StackPanel x:Name="panel_mailCcAdmin" Orientation="Horizontal"/>

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="SettingsLabel"/>
                                <ColumnDefinition Width="*" MinWidth="140"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{lex:Loc Settings_MailTestTo}" VerticalAlignment="Center"/>
                            <TextBox x:Name="txt_mailTestTo" Grid.Column="1" VerticalContentAlignment="Center"/>
                            <StackPanel Grid.Column="3" Orientation="Horizontal">
                                <Button x:Name="btn_mailTest" Content="{lex:Loc Settings_MailSendTest}" Padding="10,3" Click="Btn_MailTest_Click"/>
                                <Button x:Name="btn_mailCheck" Content="{lex:Loc Settings_MailRunCheck}" Padding="10,3" Margin="10,0,0,0" Click="Btn_MailCheck_Click"
                                        ToolTip="{lex:Loc Settings_MailRunCheckHint}"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="{lex:Loc Settings_MailLogs}" Margin="0,12,0,4"/>
                        <!-- 日志单行较长：横向滚动交给文本框自身，避免撑宽详情面板 -->
                        <TextBox x:Name="txt_mailLogs" MinHeight="90" IsReadOnly="True" AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                 TextWrapping="NoWrap"
                                 FontFamily="{DynamicResource FontFamilyData}"/>
                    </StackPanel>
                </Border>

                <!--邮件模板；仅管理员可见-->
                <Border x:Name="sec_mail_template" Padding="0,10">
                    <StackPanel>
                        <TextBlock Text="{lex:Loc Settings_MailTemplates}" FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock Text="{lex:Loc Settings_MailTemplatesHint}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,2,0,8"/>
                        <StackPanel x:Name="panel_mailTemplates"/>
                    </StackPanel>
                </Border>

                <Border Padding="0,20,0,40"/>
            </StackPanel>
        </ScrollViewer>
        </Grid>

        <!--底部：保存/应用/取消--> 
        <Border Grid.Row="1" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,1,0,0" Padding="16,10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="btn_save" Content="{lex:Loc Common_Save}" Width="90" Click="Btn_Save_Click" IsDefault="True"/>
                <Button x:Name="btn_apply" Content="{lex:Loc Common_Apply}" Width="90" Margin="10,0,0,0" Click="Btn_Apply_Click"/>
                <Button x:Name="btn_cancel" Content="{lex:Loc Common_Cancel}" Width="90" Margin="10,0,0,0" Click="Btn_Cancel_Click" IsCancel="True"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
