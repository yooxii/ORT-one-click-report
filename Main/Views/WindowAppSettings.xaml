<Window x:Class="ORT一键报告.Main.Views.WindowAppSettings" Background="{DynamicResource WindowBackgroundBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:lex="http://wpflocalizeextension.codeplex.com"
        mc:Ignorable="d"
        Title="{lex:Loc Settings_Title}" Height="600" Width="900" MinHeight="450" MinWidth="720"
        WindowStartupLocation="CenterOwner">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
        <Grid.ColumnDefinitions>
            <!-- 目录列随文字自适应（字号调大时不再截断节点名） -->
            <ColumnDefinition Width="Auto" MinWidth="180" MaxWidth="380"/>
            <ColumnDefinition Width="5"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <!--左侧：树状目录预览-->
        <Border Grid.Column="0" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,0,1,0" Padding="8">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="{lex:Loc Settings_DirTab}" FontWeight="Bold" FontSize="14" Margin="4,2,4,8"/>
                <TreeView x:Name="tv_settings" BorderThickness="0" SelectedItemChanged="Tv_Settings_SelectedItemChanged">
                    <TreeViewItem Header="UI" IsExpanded="True" Tag="sec_ui">
                        <TreeViewItem Header="{lex:Loc Settings_Theme}" Tag="sec_theme"/>
                        <TreeViewItem Header="{lex:Loc Settings_Language}" Tag="sec_language"/>
                        <TreeViewItem Header="{lex:Loc Settings_Font}" Tag="sec_font"/>
                    </TreeViewItem>
                    <TreeViewItem Header="{lex:Loc Settings_Path}" IsExpanded="True" Tag="sec_paths">
                        <TreeViewItem Header="{lex:Loc Settings_ATEPath}" Tag="sec_ate"/>
                        <TreeViewItem Header="{lex:Loc Settings_EMIPath}" Tag="sec_emi"/>
                        <TreeViewItem Header="{lex:Loc Settings_DataFolder}" Tag="sec_dbpath"/>
                        <TreeViewItem Header="{lex:Loc Settings_PlanPath}" Tag="sec_schedule"/>
                        <TreeViewItem Header="{lex:Loc Settings_RequisitionPath}" Tag="sec_requisition"/>
                        <TreeViewItem Header="{lex:Loc Settings_ReportPath}" Tag="sec_report"/>
                    </TreeViewItem>
                    <TreeViewItem Header="{lex:Loc Settings_Mail}" IsExpanded="True" Tag="sec_mail">
                        <TreeViewItem Header="{lex:Loc Settings_MailTemplates}" Tag="sec_mail_template"/>
                    </TreeViewItem>
                    <TreeViewItem Header="{lex:Loc PlanIndex_Settings_Title}" Tag="sec_planindex"/>
                    <TreeViewItem Header="{lex:Loc ReportScan_SettingsTitle}" Tag="sec_reportscan"/>
                    <TreeViewItem Header="{lex:Loc Backup_Settings_Title}" Tag="sec_backup"/>
                    <TreeViewItem Header="{lex:Loc Settings_Background}" Tag="sec_background"/>
                    <TreeViewItem Header="{lex:Loc Ort_Settings_Title}" IsExpanded="True" Tag="sec_ort">
                        <TreeViewItem Header="{lex:Loc Ort_Settings_Basic}" Tag="sec_ort_basic"/>
                        <TreeViewItem Header="{lex:Loc Ort_Settings_Advanced}" Tag="sec_ort_advanced"/>
                    </TreeViewItem>
                    <TreeViewItem Header="{lex:Loc Portal_Settings_Title}" Tag="sec_portal"/>
                </TreeView>
            </DockPanel>
        </Border>

        <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="Transparent"/>

        <!--右侧：设置项详情（标签列 Auto 以随字号自适应）
            注意：横向滚动必须保持 Disabled——带长文本的 TextBlock 即使 TextWrapping=Wrap，
            仍按“单行完整宽度”上报期望宽度（如邮件模板的变量说明约 3300px），
            一旦开启 Auto，整个详情面板会被这行文字撑宽并溢出-->
        <ScrollViewer x:Name="sv_right" Grid.Column="2" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled" ScrollChanged="Sv_Right_ScrollChanged">
            <StackPanel Margin="16" Grid.IsSharedSizeScope="True">

                <!-- UI -->
                <Border x:Name="sec_ui" Padding="0,4">
                    <StackPanel>
                        <TextBlock Text="UI" FontSize="20" FontWeight="Bold"/>
                        <TextBlock Text="{lex:Loc Settings_AppearanceTab}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>

                <Border x:Name="sec_theme" Padding="0,10">
                    <StackPanel>
                        <TextBlock Text="{lex:Loc Settings_Theme}" FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock Text="{lex:Loc Settings_ThemeHint}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,8"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="SettingsLabel"/>
                                <ColumnDefinition Width="*" MinWidth="200"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{lex:Loc Settings_Theme}" VerticalAlignment="Center"/>
                            <ComboBox x:Name="cb_theme" Grid.Column="1" VerticalContentAlignment="Center" SelectedValuePath="Code" SelectionChanged="Cb_Theme_SelectionChanged">
                                                            <ComboBox.ItemTemplate>
                                                                <DataTemplate>
                                                                    <TextBlock Text="{Binding DisplayName}"/>
                                                                </DataTemplate>
                                                            </ComboBox.ItemTemplate>
                                                        </ComboBox>
                            <Button x:Name="btn_importTheme" Grid.Column="3" Content="{lex:Loc Settings_ImportTheme}" Click="Btn_ImportTheme_Click" ToolTip="{lex:Loc Settings_ImportThemeHint}"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <Separator Margin="0,12"/>

                <Border x:Name="sec_language" Padding="0,10">
                    <StackPanel>
                        <TextBlock Text="{lex:Loc Settings_Language}" FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock Text="{lex:Loc Settings_LanguageHint}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,8"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="SettingsLabel"/>
                                <ColumnDefinition Width="*" MinWidth="180"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{lex:Loc Settings_Language}" VerticalAlignment="Center"/>
                            <ComboBox x:Name="cb_language" Grid.Column="1" VerticalContentAlignment="Center" SelectedValuePath="Code" SelectionChanged="Cb_Language_SelectionChanged">
                                                            <ComboBox.ItemTemplate>
                                                                <DataTemplate>
                                                                    <TextBlock Text="{Binding DisplayName}"/>
                                                                </DataTemplate>
                                                            </ComboBox.ItemTemplate>
                                                        </ComboBox>
                        </Grid>
                    </StackPanel>
                </Border>

                <Separator Margin="0,12"/>

                <Border x:Name="sec_font" Padding="0,10">
                    <StackPanel>
                        <TextBlock Text="{lex:Loc Settings_Font}" FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock Text="{lex:Loc Settings_FontHint}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,8" TextWrapping="Wrap"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="SettingsLabel"/>
                                <ColumnDefinition Width="*" MinWidth="160"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="SettingsLabel"/>
                                <ColumnDefinition Width="Auto" MinWidth="90"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{lex:Loc Settings_FontFamily}" VerticalAlignment="Center"/>
                            <ComboBox x:Name="cb_fontFamily" Grid.Column="1" VerticalContentAlignment="Center"/>
                            <TextBlock Text="{lex:Loc Settings_FontSize}" Grid.Column="3" VerticalAlignment="Center"/>
                            <ComboBox x:Name="cb_fontSize" Grid.Column="4" VerticalContentAlignment="Center" IsEditable="True"
                                      ToolTip="{lex:Loc Settings_FontSizeHint}"/>
                        </Grid>
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="SettingsLabel"/>
                                <ColumnDefinition Width="Auto" MinWidth="180"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{lex:Loc Settings_FontWeight}" VerticalAlignment="Center"
                                       ToolTip="{lex:Loc Settings_FontWeightHint}"/>
                            <ComboBox x:Name="cb_fontWeight" Grid.Column="1" VerticalContentAlignment="Center" SelectedValuePath="Code">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding DisplayName}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </Grid>
                        <!-- 主界面背景图：铺满主界面，可自行更换或清除 -->
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="SettingsLabel"/>
                                <ColumnDefinition Width="*" MinWidth="160"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{lex:Loc Settings_BackgroundImage}" VerticalAlignment="Center"
                                       ToolTip="{lex:Loc Settings_BackgroundImageHint}"/>
                            <TextBox x:Name="txt_background" Grid.Column="1" VerticalContentAlignment="Center"
                                     ToolTip="{lex:Loc Settings_BackgroundImageHint}"/>
                            <Button x:Name="btn_browseBackground" Grid.Column="2" Content="{lex:Loc Common_Browse}" Margin="6,0,0,0" Padding="10,2"
                                    Click="Btn_BrowseBackground_Click" ToolTip="{lex:Loc Settings_BackgroundImageHint}"/>
                            <Button x:Name="btn_clearBackground" Grid.Column="3" Content="{lex:Loc Common_Clear}" Margin="6,0,0,0" Padding="10,2"
                                    Click="Btn_ClearBackground_Click"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <Separator Margin="0,12"/>

                <!-- 路径 -->
                <Border x:Name="sec_paths" Padding="0,4">
                    <StackPanel>
                        <TextBlock Text="{lex:Loc Settings_Path}" FontSize="20" FontWeight="Bold"/>
                        <TextBlock Text="{lex:Loc Settings_DirHint}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>

                <Border x:Name="sec_ate" Padding="0,10">
                    <StackPanel>
                        <TextBlock Text="{lex:Loc Settings_ATEPath}" FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock Text="{lex:Loc Settings_ATEPathHint}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,8" TextWrapping="Wrap"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="txt_ate" VerticalContentAlignment="Center"/>
                            <Button Content="{lex:Loc Common_BrowseEllipsis}" Grid.Column="2" Padding="6,3" Click="Btn_Browse_Click" Tag="AteDataPath"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border x:Name="sec_emi" Padding="0,10">
                    <StackPanel>
                        <TextBlock Text="{lex:Loc Settings_EMIPath}" FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock Text="{lex:Loc Settings_EMIPathHint}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,8" TextWrapping="Wrap"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="txt_emi" VerticalContentAlignment="Center"/>
                            <Button Content="{lex:Loc Common_BrowseEllipsis}" Grid.Column="2" Padding="6,3" Click="Btn_Browse_Click" Tag="EmiDataPath"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border x:Name="sec_dbpath" Padding="0,10">
                    <StackPanel>
                        <TextBlock Text="{lex:Loc Settings_DataFolder}" FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock Text="{lex:Loc Settings_DataFolderHint}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,8" TextWrapping="Wrap"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="txt_dataFolder" VerticalContentAlignment="Center"/>
                            <Button x:Name="btn_dataFolderBrowse" Content="{lex:Loc Common_BrowseEllipsis}" Grid.Column="2" Padding="6,3" Click="Btn_DataFolderBrowse_Click"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border x:Name="sec_schedule" Padding="0,10">
                    <StackPanel>
                        <TextBlock Text="{lex:Loc Settings_PlanPath}" FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock Text="{lex:Loc Settings_PlanPathHint}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,8" TextWrapping="Wrap"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="txt_schedule" VerticalContentAlignment="Center"/>
                            <Button Content="{lex:Loc Common_BrowseEllipsis}" Grid.Column="2" Padding="6,3" Click="Btn_Browse_Click" Tag="SchedulePath"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border x:Name="sec_requisition" Padding="0,10">
                    <StackPanel>
                        <TextBlock Text="{lex:Loc Settings_RequisitionPath}" FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock Text="{lex:Loc Settings_ReqPathHint}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,8" TextWrapping="Wrap"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="txt_requisition" VerticalContentAlignment="Center"/>
                            <Button Content="{lex:Loc Common_BrowseEllipsis}" Grid.Column="2" Padding="6,3" Click="Btn_Browse_Click" Tag="RequisitionPath"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border x:Name="sec_report" Padding="0,10">
                    <StackPanel>
                        <TextBlock Text="{lex:Loc Settings_ReportPath}" FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock Text="{lex:Loc Settings_ReportPathHint}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,8" TextWrapping="Wrap"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="txt_report" VerticalContentAlignment="Center"/>
                            <Button Content="{lex:Loc Common_BrowseEllipsis}" Grid.Column="2" Padding="6,3" Click="Btn_Browse_Click" Tag="ReportPath"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!--邮件服务（发件账号 + 触发规则）；仅管理员可见-->
                <Border x:Name="sec_mail" Padding="0,10">
                    <StackPanel>
                        <TextBlock Text="{lex:Loc Settings_Mail}" FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock Text="{lex:Loc Settings_MailHint}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,2,0,8"/>

                        <CheckBox x:Name="chk_mailEnabled" Content="{lex:Loc Settings_MailEnabled}" Margin="0,2,0,8"/>
                        <CheckBox x:Name="chk_mailNoticeEnabled" Content="{lex:Loc Settings_MailNoticeEnabled}" Margin="0,2,0,8"/>
                        <CheckBox x:Name="chk_mailWarningEnabled" Content="{lex:Loc Settings_MailWarningEnabled}" Margin="0,2,0,8"/>

                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="SettingsLabel"/>
                                <ColumnDefinition Width="*" MinWidth="140"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="SettingsLabel"/>
                                <ColumnDefinition Width="Auto" MinWidth="70"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{lex:Loc Settings_MailHost}" VerticalAlignment="Center"/>
                            <TextBox x:Name="txt_mailHost" Grid.Column="1" VerticalContentAlignment="Center"/>
                            <TextBlock Text="{lex:Loc Settings_MailPort}" Grid.Column="3" VerticalAlignment="Center"/>
                            <TextBox x:Name="txt_mailPort" Grid.Column="4" VerticalContentAlignment="Center"/>
                        </Grid>

                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="SettingsLabel"/>
                                <ColumnDefinition Width="*" MinWidth="200"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{lex:Loc Settings_MailSecurity}" VerticalAlignment="Center" ToolTip="{lex:Loc Settings_MailSecurityHint}"/>
                            <ComboBox x:Name="cb_mailSecurity" Grid.Column="1" VerticalContentAlignment="Center">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding DisplayName}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <CheckBox x:Name="chk_mailIgnoreCert" Grid.Column="3" Content="{lex:Loc Settings_MailIgnoreCert}" VerticalAlignment="Center"/>
                        </Grid>

                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="SettingsLabel"/>
                                <ColumnDefinition Width="*" MinWidth="140"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="SettingsLabel"/>
                                <ColumnDefinition Width="Auto" MinWidth="90"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{lex:Loc Settings_MailUser}" VerticalAlignment="Center"/>
                            <TextBox x:Name="txt_mailUser" Grid.Column="1" VerticalContentAlignment="Center"/>
                            <TextBlock Text="{lex:Loc Settings_MailPassword}" Grid.Column="3" VerticalAlignment="Center"/>
                            <PasswordBox x:Name="txt_mailPassword" Grid.Column="4" VerticalContentAlignment="Center"/>
                        </Grid>

                        <CheckBox x:Name="chk_mailDefaultCred" Content="{lex:Loc Settings_MailDefaultCred}" Margin="0,8,0,0" ToolTip="{lex:Loc Settings_MailDefaultCredHint}"/>

                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="SettingsLabel"/>
                                <ColumnDefinition Width="*" MinWidth="140"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="SettingsLabel"/>
                                <ColumnDefinition Width="*" MinWidth="100"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{lex:Loc Settings_MailFrom}" VerticalAlignment="Center"/>
                            <TextBox x:Name="txt_mailFrom" Grid.Column="1" VerticalContentAlignment="Center"/>
                            <TextBlock Text="{lex:Loc Settings_MailFromName}" Grid.Column="3" VerticalAlignment="Center"/>
                            <TextBox x:Name="txt_mailFromName" Grid.Column="4" VerticalContentAlignment="Center"/>
                        </Grid>

                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="SettingsLabel"/>
                                <ColumnDefinition Width="*" MinWidth="140"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="SettingsLabel"/>
                                <ColumnDefinition Width="Auto" MinWidth="60"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{lex:Loc Settings_MailCc}" VerticalAlignment="Center" ToolTip="{lex:Loc Settings_MailCcHint}"/>
                            <TextBox x:Name="txt_mailCc" Grid.Column="1" VerticalContentAlignment="Center"/>
                            <TextBlock Text="{lex:Loc Settings_MailTimeout}" Grid.Column="3" VerticalAlignment="Center"/>
                            <TextBox x:Name="txt_mailTimeout" Grid.Column="4" VerticalContentAlignment="Center"/>
                        </Grid>

                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="SettingsLabel"/>
                                <ColumnDefinition Width="Auto" MinWidth="60"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="SettingsLabel"/>
                                <ColumnDefinition Width="Auto" MinWidth="60"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{lex:Loc Settings_MailDaysBefore}" VerticalAlignment="Center" ToolTip="{lex:Loc Settings_MailDaysBeforeHint}"/>
                            <TextBox x:Name="txt_mailDaysBefore" Grid.Column="1" VerticalContentAlignment="Center"/>
                            <TextBlock Text="{lex:Loc Settings_MailDedupe}" Grid.Column="3" VerticalAlignment="Center" ToolTip="{lex:Loc Settings_MailDedupeHint}"/>
                            <TextBox x:Name="txt_mailDedupe" Grid.Column="4" VerticalContentAlignment="Center"/>
                        </Grid>

                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <CheckBox x:Name="chk_mailIncludeOverdue" Content="{lex:Loc Settings_MailIncludeOverdue}" Margin="0,0,16,0"/>
                            <CheckBox x:Name="chk_mailHtml" Content="{lex:Loc Settings_MailHtml}"/>
                        </StackPanel>

                        <TextBlock Text="{lex:Loc Settings_MailCcAdmin}" Margin="0,10,0,4" ToolTip="{lex:Loc Settings_MailCcAdminHint}"/>
                        <StackPanel x:Name="panel_mailCcAdmin" Orientation="Horizontal"/>

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="SettingsLabel"/>
                                <ColumnDefinition Width="*" MinWidth="140"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{lex:Loc Settings_MailTestTo}" VerticalAlignment="Center"/>
                            <TextBox x:Name="txt_mailTestTo" Grid.Column="1" VerticalContentAlignment="Center"/>
                            <StackPanel Grid.Column="3" Orientation="Horizontal">
                                <Button x:Name="btn_mailTest" Content="{lex:Loc Settings_MailSendTest}" Padding="10,3" Click="Btn_MailTest_Click"/>
                                <Button x:Name="btn_mailCheck" Content="{lex:Loc Settings_MailRunCheck}" Padding="10,3" Margin="10,0,0,0" Click="Btn_MailCheck_Click"
                                        ToolTip="{lex:Loc Settings_MailRunCheckHint}"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="{lex:Loc Settings_MailLogs}" Margin="0,12,0,4"/>
                        <!-- 日志单行较长：横向滚动交给文本框自身，避免撑宽详情面板 -->
                        <TextBox x:Name="txt_mailLogs" MinHeight="90" IsReadOnly="True" AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                 TextWrapping="NoWrap"
                                 FontFamily="{DynamicResource FontFamilyData}"/>
                    </StackPanel>
                </Border>

                <!--邮件模板；仅管理员可见-->
                <Border x:Name="sec_mail_template" Padding="0,10">
                    <StackPanel>
                        <TextBlock Text="{lex:Loc Settings_MailTemplates}" FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock Text="{lex:Loc Settings_MailTemplatesHint}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,2,0,8"/>
                        <StackPanel x:Name="panel_mailTemplates"/>
                    </StackPanel>
                </Border>

                <!--计划索引（空闲自动执行）；仅管理员可见。放在邮件服务之后，与左侧目录顺序保持一致-->
                <Border x:Name="sec_planindex" Padding="0,10">
                    <StackPanel>
                        <TextBlock Text="{lex:Loc PlanIndex_Settings_Title}" FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock Text="{lex:Loc PlanIndex_Settings_AutoHint}" Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextWrapping="Wrap" Margin="0,2,0,8"/>
                        <CheckBox x:Name="chk_planIndexAuto" Content="{lex:Loc PlanIndex_Settings_Auto}" Margin="0,2,0,8"/>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <Label Content="{lex:Loc PlanIndex_Settings_Idle}" VerticalContentAlignment="Center"/>
                            <TextBox x:Name="txt_planIndexIdle" Width="70" VerticalContentAlignment="Center" Margin="4,0,0,0"/>
                        </StackPanel>
                        <TextBlock Text="{lex:Loc PlanIndex_Settings_IdleHint}" Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextWrapping="Wrap" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <!--报告扫描（空闲自动执行 + 报告状态判定）；仅管理员可见-->
                <Border x:Name="sec_reportscan" Padding="0,10">
                    <StackPanel>
                        <TextBlock Text="{lex:Loc ReportScan_SettingsTitle}" FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock Text="{lex:Loc ReportScan_SettingsHint}" Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextWrapping="Wrap" Margin="0,2,0,8"/>
                        <CheckBox x:Name="chk_reportScanAuto" Content="{lex:Loc ReportScan_AutoLabel}" Margin="0,2,0,8"/>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <Label Content="{lex:Loc ReportScan_IdleSecondsLabel}" VerticalContentAlignment="Center"/>
                            <TextBox x:Name="txt_reportScanIdle" Width="70" VerticalContentAlignment="Center" Margin="4,0,0,0"/>
                        </StackPanel>
                        <TextBlock Text="{lex:Loc ReportScan_IdleSecondsHint}" Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextWrapping="Wrap" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <!--数据库备份（仅管理员）：定时全量/增量、备份文件夹、快照与还原入口-->
                <Border x:Name="sec_backup" Padding="0,10">
                    <StackPanel>
                        <TextBlock Text="{lex:Loc Backup_Settings_Title}" FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock Text="{lex:Loc Backup_Settings_Hint}" Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextWrapping="Wrap" Margin="0,2,0,8"/>
                        <CheckBox x:Name="chk_backupAuto" Content="{lex:Loc Backup_Settings_Auto}" Margin="0,2,0,8"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="SettingsLabel"/>
                                <ColumnDefinition Width="*" MinWidth="140"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{lex:Loc Backup_Settings_Folder}" VerticalAlignment="Center"/>
                            <TextBox x:Name="txt_backupFolder" Grid.Column="1" Margin="6,0,0,0" VerticalContentAlignment="Center"
                                     ToolTip="{lex:Loc Backup_Settings_FolderHint}"/>
                            <Button x:Name="btn_backupFolderBrowse" Grid.Column="2" Content="{lex:Loc Common_BrowseEllipsis}"
                                    Margin="6,0,0,0" Padding="6,3" Click="Btn_BackupFolderBrowse_Click"/>
                            <Button x:Name="btn_backupFolderDefault" Grid.Column="3" Content="{lex:Loc Backup_Settings_Default}"
                                    Margin="6,0,0,0" Padding="8,3" Click="Btn_BackupFolderDefault_Click"
                                    ToolTip="{lex:Loc Backup_Settings_FolderHint}"/>
                            <Button x:Name="btn_backupOpen" Grid.Column="4" Content="{lex:Loc Backup_Settings_Open}"
                                    Margin="12,0,0,0" Padding="10,3" Click="Btn_BackupOpen_Click"/>
                        </Grid>
                        <TextBlock x:Name="txt_backupLast" Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextWrapping="Wrap" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>

                <!--后台运行：关闭窗口最小化到后台（托盘）、开机自启、自启到后台；本机设置，所有用户可见-->
                <Border x:Name="sec_background" Padding="0,10">
                    <StackPanel>
                        <TextBlock Text="{lex:Loc Settings_Background}" FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock Text="{lex:Loc Settings_BackgroundHint}" Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextWrapping="Wrap" Margin="0,2,0,8"/>
                        <CheckBox x:Name="chk_minimizeToTray" Content="{lex:Loc Settings_MinimizeToTray}" Margin="0,2,0,2"
                                  ToolTip="{lex:Loc Settings_MinimizeToTrayHint}"/>
                        <TextBlock Text="{lex:Loc Settings_MinimizeToTrayHint}" Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextWrapping="Wrap" Margin="24,0,0,8"/>
                        <CheckBox x:Name="chk_autoStart" Content="{lex:Loc Settings_AutoStart}" Margin="0,2,0,2"
                                  Checked="Chk_AutoStart_Changed" Unchecked="Chk_AutoStart_Changed"/>
                        <TextBlock Text="{lex:Loc Settings_AutoStartHint}" Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextWrapping="Wrap" Margin="24,0,0,8"/>
                        <CheckBox x:Name="chk_autoStartBackground" Content="{lex:Loc Settings_AutoStartBackground}" Margin="24,2,0,2"
                                  ToolTip="{lex:Loc Settings_AutoStartBackgroundHint}"/>
                        <TextBlock Text="{lex:Loc Settings_AutoStartBackgroundHint}" Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextWrapping="Wrap" Margin="48,0,0,8"/>
                        <TextBlock x:Name="txt_autoStartBlocked" Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextWrapping="Wrap" Margin="24,0,0,0" Visibility="Collapsed"/>
                    </StackPanel>
                </Border>

                <!-- ==================== ORT 看板取数（普通 / 高级） ==================== -->
                <Border x:Name="sec_ort" Padding="0,10">
                    <StackPanel>
                        <TextBlock Text="{lex:Loc Ort_Settings_Title}" FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock Text="{lex:Loc Ort_Settings_Hint}" Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextWrapping="Wrap" Margin="0,2,0,8"/>
                        <TabControl x:Name="tc_ort" Margin="0,2,0,0">

                            <!--普通：日常只改日期和 MoType-->
                            <TabItem Header="{lex:Loc Ort_Settings_Basic}">
                                <StackPanel Margin="4,12,4,4">
                                    <CheckBox x:Name="chk_ortWholeMonth" Content="{lex:Loc Ort_Settings_WholeMonth}"
                                              Margin="0,0,0,4" Checked="Chk_OrtWholeMonth_Changed"
                                              Unchecked="Chk_OrtWholeMonth_Changed"
                                              ToolTip="{lex:Loc Ort_Settings_WholeMonthHint}"/>
                                    <Grid Margin="0,4,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="150"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Label Grid.Row="0" Grid.Column="0" Content="{lex:Loc Ort_Settings_DateFrom}"
                                               VerticalContentAlignment="Center"/>
                                        <DatePicker x:Name="dp_ortFrom" Grid.Row="0" Grid.Column="1" Margin="4,2"
                                                    VerticalContentAlignment="Center"/>
                                        <Label Grid.Row="0" Grid.Column="2" Content="{lex:Loc Ort_Settings_DateTo}"
                                               VerticalContentAlignment="Center" Margin="10,0,0,0"/>
                                        <DatePicker x:Name="dp_ortTo" Grid.Row="0" Grid.Column="3" Margin="4,2"
                                                    VerticalContentAlignment="Center"/>
                                        <Label Grid.Row="1" Grid.Column="0" Content="{lex:Loc Ort_Settings_MoType}"
                                               VerticalContentAlignment="Center"/>
                                        <TextBox x:Name="txt_ortMoType" Grid.Row="1" Grid.Column="1" Margin="4,4"
                                                 VerticalContentAlignment="Center"
                                                 ToolTip="{lex:Loc Ort_Settings_MoTypeHint}"/>
                                        <TextBlock Grid.Row="2" Grid.ColumnSpan="4" Margin="0,8,0,0" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   Text="{lex:Loc Ort_Settings_BasicHint}"/>
                                    </Grid>
                                </StackPanel>
                            </TabItem>

                            <!--高级：目标报表（要动态获取的两项）与全部链接配置-->
                            <TabItem Header="{lex:Loc Ort_Settings_Advanced}">
                                <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="420"
                                              HorizontalScrollBarVisibility="Disabled">
                                    <StackPanel Margin="4,12,4,4">
                                        <TextBlock Text="{lex:Loc Ort_Settings_TargetGroup}" FontWeight="SemiBold" Margin="0,0,0,2"/>
                                        <TextBlock Text="{lex:Loc Ort_Settings_TargetHint}" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,6"/>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <Label Grid.Row="0" Grid.Column="0" Content="{lex:Loc Ort_Settings_EntryId}"
                                                   VerticalContentAlignment="Center"/>
                                            <TextBox x:Name="txt_ortEntryId" Grid.Row="0" Grid.Column="1" Margin="4,3"
                                                     VerticalContentAlignment="Center"/>
                                            <Button x:Name="btn_ortExtractEntry" Grid.Row="0" Grid.Column="2" Margin="4,3,0,3"
                                                    Content="{lex:Loc Ort_Settings_ExtractEntry}" Padding="10,2"
                                                    ToolTip="{lex:Loc Ort_Settings_ExtractEntryTip}"
                                                    Click="Btn_OrtExtractEntry_Click"/>
                                            <Label Grid.Row="1" Grid.Column="0" Content="{lex:Loc Ort_Settings_Widget}"
                                                   VerticalContentAlignment="Center"/>
                                            <TextBox x:Name="txt_ortWidget" Grid.Row="1" Grid.Column="1" Margin="4,3"
                                                     VerticalContentAlignment="Center"/>
                                            <Button x:Name="btn_ortProbeWidget" Grid.Row="1" Grid.Column="2" Margin="4,3,0,3"
                                                    Content="{lex:Loc Ort_Settings_ProbeWidget}" Padding="10,2"
                                                    ToolTip="{lex:Loc Ort_Settings_ProbeWidgetTip}"
                                                    Click="Btn_OrtProbeWidget_Click"/>
                                        </Grid>
                                        <TextBlock Text="{lex:Loc Ort_Settings_ProbeHint}" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,10"/>

                                        <TextBlock Text="{lex:Loc Ort_Settings_LinkGroup}" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <Label Grid.Row="0" Content="{lex:Loc Ort_Settings_LoginUrl}" VerticalContentAlignment="Center"/>
                                            <TextBox x:Name="txt_ortLoginUrl" Grid.Row="0" Grid.Column="1" Margin="4,3" VerticalContentAlignment="Center"/>
                                            <Label Grid.Row="1" Content="{lex:Loc Ort_Settings_RedirectUrl}" VerticalContentAlignment="Center"/>
                                            <TextBox x:Name="txt_ortRedirectUrl" Grid.Row="1" Grid.Column="1" Margin="4,3" VerticalContentAlignment="Center"/>
                                            <Label Grid.Row="2" Content="{lex:Loc Ort_Settings_ReportHost}" VerticalContentAlignment="Center"/>
                                            <TextBox x:Name="txt_ortReportHost" Grid.Row="2" Grid.Column="1" Margin="4,3" VerticalContentAlignment="Center"/>
                                            <Label Grid.Row="3" Content="{lex:Loc Ort_Settings_PortalOrigin}" VerticalContentAlignment="Center"/>
                                            <TextBox x:Name="txt_ortPortalOrigin" Grid.Row="3" Grid.Column="1" Margin="4,3" VerticalContentAlignment="Center"/>
                                            <Label Grid.Row="4" Content="{lex:Loc Ort_Settings_EntryPath}" VerticalContentAlignment="Center"/>
                                            <TextBox x:Name="txt_ortEntryPath" Grid.Row="4" Grid.Column="1" Margin="4,3" VerticalContentAlignment="Center"/>
                                            <Label Grid.Row="5" Content="{lex:Loc Ort_Settings_ConfigPath}" VerticalContentAlignment="Center"/>
                                            <TextBox x:Name="txt_ortConfigPath" Grid.Row="5" Grid.Column="1" Margin="4,3" VerticalContentAlignment="Center"/>
                                            <Label Grid.Row="6" Content="{lex:Loc Ort_Settings_LoadPath}" VerticalContentAlignment="Center"/>
                                            <TextBox x:Name="txt_ortLoadPath" Grid.Row="6" Grid.Column="1" Margin="4,3" VerticalContentAlignment="Center"/>
                                        </Grid>

                                        <TextBlock Text="{lex:Loc Ort_Settings_RequestGroup}" FontWeight="SemiBold"
                                                   Margin="0,10,0,4"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <Label Grid.Row="0" Grid.Column="0" Content="{lex:Loc Ort_Settings_DeviceUuid}" VerticalContentAlignment="Center"/>
                                            <TextBox x:Name="txt_ortDeviceUuid" Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="3" Margin="4,3" VerticalContentAlignment="Center"
                                                     ToolTip="{lex:Loc Ort_Settings_DeviceUuidHint}"/>
                                            <Label Grid.Row="1" Grid.Column="0" Content="{lex:Loc Ort_Settings_UserRegion}" VerticalContentAlignment="Center"/>
                                            <TextBox x:Name="txt_ortUserRegion" Grid.Row="1" Grid.Column="1" Margin="4,3" VerticalContentAlignment="Center"/>
                                            <Label Grid.Row="1" Grid.Column="2" Content="{lex:Loc Ort_Settings_UserLanguage}" VerticalContentAlignment="Center" Margin="10,0,0,0"/>
                                            <TextBox x:Name="txt_ortUserLanguage" Grid.Row="1" Grid.Column="3" Margin="4,3" VerticalContentAlignment="Center"/>
                                            <Label Grid.Row="2" Grid.Column="0" Content="{lex:Loc Ort_Settings_Width}" VerticalContentAlignment="Center"/>
                                            <TextBox x:Name="txt_ortWidth" Grid.Row="2" Grid.Column="1" Margin="4,3" VerticalContentAlignment="Center"/>
                                            <Label Grid.Row="2" Grid.Column="2" Content="{lex:Loc Ort_Settings_Height}" VerticalContentAlignment="Center" Margin="10,0,0,0"/>
                                            <TextBox x:Name="txt_ortHeight" Grid.Row="2" Grid.Column="3" Margin="4,3" VerticalContentAlignment="Center"/>
                                            <Label Grid.Row="3" Grid.Column="0" Content="{lex:Loc Ort_Settings_RefererHeight}" VerticalContentAlignment="Center"/>
                                            <TextBox x:Name="txt_ortRefererHeight" Grid.Row="3" Grid.Column="1" Margin="4,3" VerticalContentAlignment="Center"/>
                                            <Label Grid.Row="3" Grid.Column="2" Content="{lex:Loc Ort_Settings_PageIndex}" VerticalContentAlignment="Center" Margin="10,0,0,0"/>
                                            <TextBox x:Name="txt_ortPageIndex" Grid.Row="3" Grid.Column="3" Margin="4,3" VerticalContentAlignment="Center"/>
                                            <Label Grid.Row="4" Grid.Column="0" Content="{lex:Loc Ort_Settings_DateKeys}" VerticalContentAlignment="Center"/>
                                            <TextBox x:Name="txt_ortDateFromKey" Grid.Row="4" Grid.Column="1" Margin="4,3" VerticalContentAlignment="Center"/>
                                            <TextBox x:Name="txt_ortDateToKey" Grid.Row="4" Grid.Column="3" Margin="4,3" VerticalContentAlignment="Center"
                                                     ToolTip="{lex:Loc Ort_Settings_DateToKeyHint}"/>
                                            <Label Grid.Row="5" Grid.Column="0" Content="{lex:Loc Ort_Settings_MoTypeKey}" VerticalContentAlignment="Center"/>
                                            <TextBox x:Name="txt_ortMoTypeKey" Grid.Row="5" Grid.Column="1" Margin="4,3" VerticalContentAlignment="Center"/>
                                            <Label Grid.Row="5" Grid.Column="2" Content="{lex:Loc Ort_Settings_LabelKeys}" VerticalContentAlignment="Center" Margin="10,0,0,0"/>
                                            <TextBox x:Name="txt_ortLabelKeys" Grid.Row="5" Grid.Column="3" Margin="4,3" VerticalContentAlignment="Center"
                                                     ToolTip="{lex:Loc Ort_Settings_LabelKeysHint}"/>
                                            <Label Grid.Row="6" Grid.Column="0" Content="{lex:Loc Ort_Settings_LabelTexts}" VerticalContentAlignment="Center"/>
                                            <TextBox x:Name="txt_ortLabelTexts" Grid.Row="6" Grid.Column="1" Grid.ColumnSpan="3" Margin="4,3" VerticalContentAlignment="Center"
                                                     ToolTip="{lex:Loc Ort_Settings_LabelTextsHint}"/>
                                        </Grid>

                                        <StackPanel Orientation="Horizontal" Margin="0,12,0,4">
                                            <Button Content="{lex:Loc Ort_Settings_RestoreDefaults}" Padding="12,3"
                                                    Click="Btn_OrtRestoreDefaults_Click"
                                                    ToolTip="{lex:Loc Ort_Settings_RestoreDefaultsTip}"/>
                                            <TextBlock Text="{lex:Loc Ort_Settings_RestoreHint}" VerticalAlignment="Center"
                                                       Margin="10,0,0,0" TextWrapping="Wrap"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </ScrollViewer>
                            </TabItem>
                        </TabControl>
                    </StackPanel>
                </Border>

                <!-- ==================== 登录与身份（平台账号） ==================== -->
                <Border x:Name="sec_portal" Padding="0,10">
                    <StackPanel>
                        <TextBlock Text="{lex:Loc Portal_Settings_Title}" FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock Text="{lex:Loc Portal_Settings_Hint}" Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextWrapping="Wrap" Margin="0,2,0,8"/>
                        <CheckBox x:Name="chk_portalAutoEnroll" Content="{lex:Loc Portal_Settings_AutoEnroll}" Margin="0,2,0,2"
                                  ToolTip="{lex:Loc Portal_Settings_AutoEnrollHint}"/>
                        <TextBlock Text="{lex:Loc Portal_Settings_AutoEnrollHint}" Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextWrapping="Wrap" Margin="24,0,0,8"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Label Grid.Row="0" Grid.Column="0" Content="{lex:Loc Portal_Settings_Regions}" VerticalContentAlignment="Center"/>
                            <TextBox x:Name="txt_portalRegions" Grid.Row="0" Grid.Column="1" Margin="4,3" VerticalContentAlignment="Center"
                                     ToolTip="{lex:Loc Portal_Settings_RegionsHint}"/>
                            <Label Grid.Row="0" Grid.Column="2" Content="{lex:Loc Portal_Settings_DefaultRole}" VerticalContentAlignment="Center" Margin="10,0,0,0"/>
                            <ComboBox x:Name="cb_portalRole" Grid.Row="0" Grid.Column="3" Margin="4,3" VerticalContentAlignment="Center"
                                      SelectedValuePath="Code" DisplayMemberPath="Name"/>
                            <Label Grid.Row="1" Grid.Column="0" Content="{lex:Loc Portal_Settings_EmailDomain}" VerticalContentAlignment="Center"/>
                            <TextBox x:Name="txt_portalEmailDomain" Grid.Row="1" Grid.Column="1" Margin="4,3" VerticalContentAlignment="Center"/>
                            <TextBlock Grid.Row="2" Grid.ColumnSpan="4" Text="{lex:Loc Portal_Settings_EmailHint}" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,6,0,0"/>
                        </Grid>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button Content="{lex:Loc Portal_Settings_ManageAccounts}" Padding="12,3"
                                    Click="Btn_ManagePortalAccounts_Click"/>
                            <TextBlock Text="{lex:Loc Portal_Settings_ManageHint}" VerticalAlignment="Center"
                                       Margin="10,0,0,0" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Padding="0,20,0,40"/>
            </StackPanel>
        </ScrollViewer>
        </Grid>

        <!--底部：保存/应用/取消--> 
        <Border Grid.Row="1" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,1,0,0" Padding="16,10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="btn_save" Content="{lex:Loc Common_Save}" Width="90" Click="Btn_Save_Click" IsDefault="True"/>
                <Button x:Name="btn_apply" Content="{lex:Loc Common_Apply}" Width="90" Margin="10,0,0,0" Click="Btn_Apply_Click"/>
                <Button x:Name="btn_cancel" Content="{lex:Loc Common_Cancel}" Width="90" Margin="10,0,0,0" Click="Btn_Cancel_Click" IsCancel="True"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
