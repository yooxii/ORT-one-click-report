<Window x:Class="ORT一键报告.Main.Views.WindowAppSettings"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="设置" Height="600" Width="900" MinHeight="450" MinWidth="720"
        WindowStartupLocation="CenterOwner">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="5"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <!--左侧：树状目录预览-->
        <Border Grid.Column="0" BorderBrush="#FFDDDDDD" BorderThickness="0,0,1,0" Padding="8">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="设置目录" FontWeight="Bold" FontSize="14" Margin="4,2,4,8"/>
                <TreeView x:Name="tv_settings" BorderThickness="0" SelectedItemChanged="Tv_Settings_SelectedItemChanged">
                    <TreeViewItem Header="UI" IsExpanded="True" Tag="sec_ui">
                        <TreeViewItem Header="字体" Tag="sec_font"/>
                    </TreeViewItem>
                    <TreeViewItem Header="路径" IsExpanded="True" Tag="sec_paths">
                        <TreeViewItem Header="计划表路径" Tag="sec_schedule"/>
                        <TreeViewItem Header="领用表路径" Tag="sec_requisition"/>
                        <TreeViewItem Header="报告路径" Tag="sec_report"/>
                        <TreeViewItem Header="ATE数据路径" Tag="sec_ate"/>
                        <TreeViewItem Header="EMI数据路径" Tag="sec_emi"/>
                    </TreeViewItem>
                </TreeView>
            </DockPanel>
        </Border>

        <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="Transparent"/>

        <!--右侧：设置项详情-->
        <ScrollViewer x:Name="sv_right" Grid.Column="2" VerticalScrollBarVisibility="Auto" ScrollChanged="Sv_Right_ScrollChanged">
            <StackPanel Margin="16">

                <!-- UI -->
                <Border x:Name="sec_ui" Padding="0,4">
                    <StackPanel>
                        <TextBlock Text="UI" FontSize="20" FontWeight="Bold"/>
                        <TextBlock Text="界面外观相关设置" Foreground="Gray" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>

                <Border x:Name="sec_font" Padding="0,10">
                    <StackPanel>
                        <TextBlock Text="字体" FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock Text="全局字体族与字号，保存后立即应用到所有窗口。" Foreground="Gray" Margin="0,2,0,8"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="100"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="字体族" VerticalAlignment="Center"/>
                            <ComboBox x:Name="cb_fontFamily" Grid.Column="1" VerticalContentAlignment="Center"
                                      SelectionChanged="Cb_FontFamily_SelectionChanged"/>
                            <TextBlock Text="字号" Grid.Column="3" VerticalAlignment="Center"/>
                            <ComboBox x:Name="cb_fontSize" Grid.Column="4" VerticalContentAlignment="Center" IsEditable="True"
                                      SelectionChanged="Cb_FontSize_SelectionChanged"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <Separator Margin="0,12"/>

                <!-- 路径 -->
                <Border x:Name="sec_paths" Padding="0,4">
                    <StackPanel>
                        <TextBlock Text="路径" FontSize="20" FontWeight="Bold"/>
                        <TextBlock Text="各对话框的默认打开目录。留空则使用系统默认位置。" Foreground="Gray" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>

                <Border x:Name="sec_schedule" Padding="0,10">
                    <StackPanel>
                        <TextBlock Text="计划表路径" FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock Text="导入计划表（ORT Test Schedule）时的默认目录。" Foreground="Gray" Margin="0,2,0,8"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="70"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="txt_schedule" VerticalContentAlignment="Center" TextChanged="Txt_Path_TextChanged" Tag="SchedulePath"/>
                            <Button Content="浏览..." Grid.Column="2" Padding="6,3" Click="Btn_Browse_Click" Tag="SchedulePath"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border x:Name="sec_requisition" Padding="0,10">
                    <StackPanel>
                        <TextBlock Text="领用表路径" FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock Text="导入领用表（成品領用記錄）时的默认目录。" Foreground="Gray" Margin="0,2,0,8"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="70"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="txt_requisition" VerticalContentAlignment="Center" TextChanged="Txt_Path_TextChanged" Tag="RequisitionPath"/>
                            <Button Content="浏览..." Grid.Column="2" Padding="6,3" Click="Btn_Browse_Click" Tag="RequisitionPath"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border x:Name="sec_report" Padding="0,10">
                    <StackPanel>
                        <TextBlock Text="报告路径" FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock Text="一键报告选择报告概览时的默认打开目录。" Foreground="Gray" Margin="0,2,0,8"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="70"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="txt_report" VerticalContentAlignment="Center" TextChanged="Txt_Path_TextChanged" Tag="ReportPath"/>
                            <Button Content="浏览..." Grid.Column="2" Padding="6,3" Click="Btn_Browse_Click" Tag="ReportPath"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border x:Name="sec_ate" Padding="0,10">
                    <StackPanel>
                        <TextBlock Text="ATE数据路径" FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock Text="选择ATE数据时的默认打开目录。" Foreground="Gray" Margin="0,2,0,8"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="70"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="txt_ate" VerticalContentAlignment="Center" TextChanged="Txt_Path_TextChanged" Tag="AteDataPath"/>
                            <Button Content="浏览..." Grid.Column="2" Padding="6,3" Click="Btn_Browse_Click" Tag="AteDataPath"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border x:Name="sec_emi" Padding="0,10">
                    <StackPanel>
                        <TextBlock Text="EMI数据路径" FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock Text="选择EMI数据时的默认打开目录。" Foreground="Gray" Margin="0,2,0,8"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="70"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="txt_emi" VerticalContentAlignment="Center" TextChanged="Txt_Path_TextChanged" Tag="EmiDataPath"/>
                            <Button Content="浏览..." Grid.Column="2" Padding="6,3" Click="Btn_Browse_Click" Tag="EmiDataPath"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Padding="0,20,0,40"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
