<Window x:Class="ORT一键报告.Main.Views.WindowPortalAccounts" Background="{DynamicResource WindowBackgroundBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:lex="http://wpflocalizeextension.codeplex.com"
        mc:Ignorable="d"
        Title="{lex:Loc PortalAccounts_Title}" Height="520" Width="860" MinHeight="380" MinWidth="700"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="{lex:Loc PortalAccounts_Hint}" TextWrapping="Wrap" Margin="0,0,0,8"
                   Foreground="{DynamicResource TextSecondaryBrush}"/>

        <DataGrid x:Name="dg_accounts" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False"
                  HeadersVisibility="Column" GridLinesVisibility="Horizontal" SelectionMode="Extended"
                  SelectionUnit="FullRow" RowHeight="30">
            <DataGrid.Columns>
                <DataGridTextColumn Header="{lex:Loc PortalAccounts_Account}" Binding="{Binding Account}" Width="120"/>
                <DataGridTextColumn Header="{lex:Loc PortalAccounts_Name}" Binding="{Binding DisplayName}" Width="180"/>
                <DataGridComboBoxColumn Header="{lex:Loc PortalAccounts_Role}"
                                        SelectedValueBinding="{Binding Role, UpdateSourceTrigger=PropertyChanged}"
                                        SelectedValuePath="Code" DisplayMemberPath="Name" Width="130"/>
                <DataGridTextColumn Header="{lex:Loc PortalAccounts_Email}" Binding="{Binding Email}" Width="190"/>
                <DataGridCheckBoxColumn Header="{lex:Loc PortalAccounts_Active}" Binding="{Binding IsActive}" Width="70"/>
                <DataGridTextColumn Header="{lex:Loc PortalAccounts_LastLogin}" IsReadOnly="True" Width="150"
                                    Binding="{Binding LastLoginText}"/>
            </DataGrid.Columns>
        </DataGrid>

        <Grid Grid.Row="2" Margin="0,10,0,0">
            <TextBlock x:Name="txt_status" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"
                       TextWrapping="Wrap"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="{lex:Loc PortalAccounts_Add}" Width="90" Click="Btn_Add_Click"/>
                <Button Content="{lex:Loc PortalAccounts_Delete}" Width="90" Margin="8,0,0,0" Click="Btn_Delete_Click"/>
                <Button Content="{lex:Loc Common_Save}" Width="90" Margin="8,0,0,0" Click="Btn_Save_Click" IsDefault="True"/>
                <Button Content="{lex:Loc PortalAccounts_Close}" Width="90" Margin="8,0,0,0" Click="Btn_Close_Click" IsCancel="True"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
