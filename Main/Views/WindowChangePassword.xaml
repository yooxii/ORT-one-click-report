<Window x:Class="ORT一键报告.Main.Views.WindowChangePassword"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:lex="http://wpflocalizeextension.codeplex.com"
        mc:Ignorable="d"
        Background="{DynamicResource WindowBackgroundBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
        Title="{lex:Loc UserCenter_ChangePasswordTitle}" Width="520" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">

    <StackPanel Margin="16">
        <!--本程序账号密码-->
        <GroupBox Header="{lex:Loc UserCenter_PasswordSection}" Padding="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" MinWidth="90"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Label x:Name="lbl_currentPassword" Content="{lex:Loc UserCenter_CurrentPassword}" VerticalContentAlignment="Center"/>
                <PasswordBox x:Name="txt_currentPassword" Grid.Column="1" Margin="4,3" VerticalContentAlignment="Center"/>

                <Label Grid.Row="1" Content="{lex:Loc Admin_NewPasswordMin}" VerticalContentAlignment="Center"/>
                <PasswordBox x:Name="txt_newPassword" Grid.Row="1" Grid.Column="1" Margin="4,3" VerticalContentAlignment="Center"/>

                <Label Grid.Row="2" Content="{lex:Loc UserCenter_ConfirmPassword}" VerticalContentAlignment="Center"/>
                <PasswordBox x:Name="txt_confirmPassword" Grid.Row="2" Grid.Column="1" Margin="4,3" VerticalContentAlignment="Center"/>

                <Grid Grid.Row="3" Grid.ColumnSpan="2" Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="txt_passwordHint" TextWrapping="Wrap" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <Button x:Name="btn_saveAppPassword" Grid.Column="1" Content="{lex:Loc Common_Save}"
                            Width="92" Padding="0,3" Click="Btn_SaveAppPassword_Click"/>
                </Grid>
            </Grid>
        </GroupBox>

        <!--MES 数据库账号密码（公司要求 90 天变更）-->
        <GroupBox x:Name="grp_db" Header="{lex:Loc UserCenter_DbPasswordSection}" Padding="10" Margin="0,12,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" MinWidth="90"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Label Content="{lex:Loc Sim44_Login_User}" VerticalContentAlignment="Center"/>
                <TextBlock x:Name="txt_dbUser" Grid.Column="1" VerticalAlignment="Center" Margin="4,3"/>

                <Label Grid.Row="1" Content="{lex:Loc UserCenter_DbPasswordExpiry}" VerticalContentAlignment="Center"/>
                <TextBlock x:Name="txt_dbExpiry" Grid.Row="1" Grid.Column="1" VerticalAlignment="Center"
                           Margin="4,3" TextWrapping="Wrap"/>

                <Label Grid.Row="2" Content="{lex:Loc UserCenter_CurrentPassword}" VerticalContentAlignment="Center"/>
                <PasswordBox x:Name="txt_dbOldPassword" Grid.Row="2" Grid.Column="1" Margin="4,3" VerticalContentAlignment="Center"/>

                <Label Grid.Row="3" Content="{lex:Loc Admin_NewPasswordMin}" VerticalContentAlignment="Center"/>
                <PasswordBox x:Name="txt_dbNewPassword" Grid.Row="3" Grid.Column="1" Margin="4,3" VerticalContentAlignment="Center"/>

                <Label Grid.Row="4" Content="{lex:Loc UserCenter_ConfirmPassword}" VerticalContentAlignment="Center"/>
                <PasswordBox x:Name="txt_dbConfirmPassword" Grid.Row="4" Grid.Column="1" Margin="4,3" VerticalContentAlignment="Center"/>

                <Grid Grid.Row="5" Grid.ColumnSpan="2" Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="txt_dbHint" TextWrapping="Wrap" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <Button x:Name="btn_changeDbPassword" Grid.Column="1" Content="{lex:Loc UserCenter_ChangeDbPassword}"
                            Padding="12,3" Click="Btn_ChangeDbPassword_Click"/>
                </Grid>
            </Grid>
        </GroupBox>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="{lex:Loc Common_Close}" Width="90" Padding="0,3" IsCancel="True" Click="Btn_Close_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
