<Window x:Class="ORT一键报告.Main.Views.WindowLog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="日志查看" Height="600" Width="1000" MinHeight="400" MinWidth="700"
        WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <!--CellStyle的TargetType必须是DataGridCell，TextBlock会从单元格继承Foreground/FontWeight-->
        <Style x:Key="LevelCellStyle" TargetType="DataGridCell">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Level}" Value="ERROR">
                    <Setter Property="Foreground" Value="Red"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Level}" Value="FATAL">
                    <Setter Property="Foreground" Value="DarkRed"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Level}" Value="WARN">
                    <Setter Property="Foreground" Value="DarkOrange"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Level}" Value="DEBUG">
                    <Setter Property="Foreground" Value="Gray"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Level}" Value="INFO">
                    <Setter Property="Foreground" Value="DarkBlue"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="5">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>

        <!--工具栏: 日志文件选择 / 级别筛选 / 关键字搜索 / 刷新-->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition Width="180"/>
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition Width="110"/>
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition/>
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition Width="auto"/>
            </Grid.ColumnDefinitions>
            <Label Content="日志文件" VerticalContentAlignment="Center"/>
            <ComboBox x:Name="cb_logFiles" Grid.Column="1" VerticalContentAlignment="Center"
                      SelectionChanged="Cb_LogFiles_SelectionChanged"/>
            <Label Content="级别" Grid.Column="2" VerticalContentAlignment="Center"/>
            <ComboBox x:Name="cb_level" Grid.Column="3" VerticalContentAlignment="Center"
                      SelectionChanged="Filter_Changed">
                <ComboBoxItem Content="全部" IsSelected="True"/>
                <ComboBoxItem Content="DEBUG"/>
                <ComboBoxItem Content="INFO"/>
                <ComboBoxItem Content="WARN"/>
                <ComboBoxItem Content="ERROR"/>
                <ComboBoxItem Content="FATAL"/>
            </ComboBox>
            <Label Content="搜索" Grid.Column="4" VerticalContentAlignment="Center"/>
            <TextBox x:Name="txt_search" Grid.Column="5" VerticalContentAlignment="Center"
                     ToolTip="输入关键字筛选日志内容" TextChanged="Filter_Changed"/>
            <CheckBox x:Name="chk_autoRefresh" Content="自动刷新" Grid.Column="6"
                      VerticalAlignment="Center" Margin="8,0,0,0" IsChecked="True"
                      Checked="Filter_Changed" Unchecked="Filter_Changed"/>
            <Button Content="刷新" Grid.Column="7" Margin="8,0,0,0" Padding="10,2"
                    Cursor="Hand" Click="Btn_Refresh_Click"/>
        </Grid>

        <!--日志列表: 点击列头可排序-->
        <DataGrid x:Name="dg_logs" Grid.Row="1" Margin="0,5,0,0"
                  AutoGenerateColumns="False" IsReadOnly="True"
                  CanUserSortColumns="True" CanUserAddRows="False"
                  HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                  SelectionMode="Single" SelectionUnit="FullRow"
                  VirtualizingPanel.IsVirtualizing="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="时间" Binding="{Binding TimeText}" Width="160" SortMemberPath="Time"/>
                <DataGridTextColumn Header="级别" Binding="{Binding Level}" Width="65"
                                    CellStyle="{StaticResource LevelCellStyle}"/>
                <DataGridTextColumn Header="来源" Binding="{Binding Logger}" Width="200"/>
                <DataGridTextColumn Header="内容" Binding="{Binding Message}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <StatusBar Grid.Row="2">
            <StatusBarItem x:Name="status_count" Content="共 0 条"/>
            <Separator/>
            <StatusBarItem x:Name="status_file" Content=""/>
        </StatusBar>
    </Grid>
</Window>
