<Window x:Class="ORT一键报告.PopupWindow" Background="{DynamicResource WindowBackgroundBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:lex="http://wpflocalizeextension.codeplex.com"
        xmlns:local="clr-namespace:ORT一键报告"
        mc:Ignorable="d"
        Title="{Binding Title}" Width="420" SizeToContent="Height" FontSize="14"
        ResizeMode="NoResize" ShowInTaskbar="False" WindowStyle="ToolWindow" WindowStartupLocation="CenterOwner">
    <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}"
            BorderThickness="1" CornerRadius="6" Margin="10" Padding="16,14,16,14">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 图标 + 标题 / 说明 -->
            <DockPanel Grid.Row="0">
                <Border x:Name="IconBadge" DockPanel.Dock="Left" Width="34" Height="34" CornerRadius="17"
                        Margin="0,0,12,0" VerticalAlignment="Top" Background="{DynamicResource StatusOkBgBrush}">
                    <TextBlock x:Name="IconText" FontFamily="Segoe MDL2 Assets" FontSize="17"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="TitleText" Text="{Binding Title}" FontWeight="SemiBold"
                               TextWrapping="Wrap" Margin="0,0,0,3"/>
                    <TextBlock x:Name="MessageText" Text="{Binding Message}" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                </StackPanel>
            </DockPanel>

            <!-- 处理中：不确定进度条（等待窗口专用） -->
            <ProgressBar x:Name="BusyBar" Grid.Row="1" Height="4" Margin="0,14,0,0"
                         Minimum="0" Maximum="100" IsIndeterminate="True" Visibility="Collapsed"/>

            <!-- 按钮行（消息窗口专用） -->
            <WrapPanel x:Name="ButtonPanel" Grid.Row="2" Orientation="Horizontal"
                       HorizontalAlignment="Right" Margin="0,16,0,0"/>
        </Grid>
    </Border>
</Window>
