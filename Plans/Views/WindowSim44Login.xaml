<Window x:Class="ORT一键报告.Plans.Views.WindowSim44Login"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:lex="http://wpflocalizeextension.codeplex.com"
        mc:Ignorable="d"
        Background="{DynamicResource WindowBackgroundBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
        Title="{lex:Loc Sim44_Login_Title}" Width="400" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" MinWidth="80"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.ColumnSpan="2" Text="{lex:Loc Sim44_Login_Hint}" TextWrapping="Wrap"
                   Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,10"/>

        <Label Grid.Row="1" Content="{lex:Loc Sim44_Login_User}" VerticalContentAlignment="Center"/>
        <TextBox x:Name="txt_user" Grid.Row="1" Grid.Column="1" Margin="4,3" VerticalContentAlignment="Center"/>

        <Label Grid.Row="2" Content="{lex:Loc Sim44_Login_Password}" VerticalContentAlignment="Center"/>
        <PasswordBox x:Name="pwd" Grid.Row="2" Grid.Column="1" Margin="4,3" VerticalContentAlignment="Center"/>

        <CheckBox x:Name="chk_remember" Grid.Row="3" Grid.Column="1" Margin="4,8,0,0"
                  Content="{lex:Loc Sim44_Login_Remember}" IsChecked="True"/>

        <TextBlock x:Name="txt_msg" Grid.Row="4" Grid.ColumnSpan="2" Margin="0,10,0,0" TextWrapping="Wrap"
                   Foreground="#C62828"/>

        <Grid Grid.Row="5" Grid.ColumnSpan="2" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="btn_selftest" Content="{lex:Loc Sim44_SelfTest}" Padding="10,3" Click="Btn_SelfTest_Click"/>
            <Button x:Name="btn_settings" Grid.Column="1" Content="{lex:Loc Sim44_Settings_Open}" Padding="10,3"
                    Margin="8,0,0,0" HorizontalAlignment="Left" Click="Btn_Settings_Click"/>
            <Button x:Name="btn_ok" Grid.Column="3" Content="{lex:Loc Sim44_Login}" Width="88" Padding="0,3"
                    Click="Btn_Login_Click" IsDefault="True"/>
            <Button Grid.Column="4" Content="{lex:Loc Common_Cancel}" Width="80" Padding="0,3" Margin="8,0,0,0"
                    IsCancel="True" Click="Btn_Cancel_Click"/>
        </Grid>
    </Grid>
</Window>
