<UserControl x:Class="ORT一键报告.Plans.Views.FilterDropDown"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" x:Name="root" MinWidth="110">

    <Grid>
        <!--触发按钮：显示当前选择摘要-->
        <ToggleButton x:Name="PART_Toggle" HorizontalContentAlignment="Left" Padding="6,2"
                      Content="{Binding SummaryText, ElementName=root}"
                      ToolTip="点击展开筛选列表"/>

        <!--下拉面板：搜索框 + 全选 + 复选列表-->
        <Popup x:Name="PART_Popup"
               IsOpen="{Binding IsChecked, ElementName=PART_Toggle}"
               StaysOpen="False" AllowsTransparency="True"
               Placement="Bottom" PlacementTarget="{Binding ElementName=PART_Toggle}">
            <Border Background="White" BorderBrush="#FF999999" BorderThickness="1"
                    Width="230" MaxHeight="340">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>
                    <TextBox x:Name="PART_Search" Margin="4,4,4,2" Padding="2"
                             ToolTip="搜索选项"/>
                    <CheckBox x:Name="PART_SelectAll" Content="(全选)" Grid.Row="1" Margin="6,2"
                              IsChecked="True" Checked="SelectAll_Changed" Unchecked="SelectAll_Changed"/>
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" MaxHeight="260">
                        <ItemsControl x:Name="PART_List" Margin="4,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox Content="{Binding Name}" Margin="2,1"
                                              IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                              Checked="Item_CheckChanged" Unchecked="Item_CheckChanged"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Popup>
    </Grid>
</UserControl>
