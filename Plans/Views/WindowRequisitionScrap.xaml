<Window x:Class="ORT一键报告.Plans.Views.WindowRequisitionScrap" Background="{DynamicResource WindowBackgroundBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:lex="http://wpflocalizeextension.codeplex.com"
        mc:Ignorable="d"
        Title="{lex:Loc ReqScrap_Title}" Width="560" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="15">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="110"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>

        <!--机种名称/领料单据/序列号/工令/线别：只读展示，内容可选中复制（Ctrl+C）-->
        <Label Content="{lex:Loc Plans_ModelNameTC}" VerticalContentAlignment="Center"/>
        <TextBox x:Name="txt_model" Grid.Column="1" Margin="5" IsReadOnly="True" BorderThickness="0"
                 Background="Transparent" ToolTip="{lex:Loc Common_CopyHint}"/>

        <Label Grid.Row="1" Content="{lex:Loc Plans_RequisitionDocNo}" VerticalContentAlignment="Center"/>
        <TextBox x:Name="txt_reqNo" Grid.Row="1" Grid.Column="1" Margin="5" IsReadOnly="True" BorderThickness="0"
                 Background="Transparent" ToolTip="{lex:Loc Common_CopyHint}"/>

        <Label Grid.Row="2" Content="{lex:Loc Plans_SN}" VerticalAlignment="Top" VerticalContentAlignment="Center"/>
        <TextBox x:Name="txt_sn" Grid.Row="2" Grid.Column="1" Margin="5" IsReadOnly="True" BorderThickness="0"
                 Background="Transparent" TextWrapping="Wrap" AcceptsReturn="True" MinLines="1" MaxLines="6"
                 VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" ToolTip="{lex:Loc Common_CopyHint}"/>

        <Label Grid.Row="3" Content="{lex:Loc Plans_WorkOrder}" VerticalContentAlignment="Center"/>
        <TextBox x:Name="txt_workOrder" Grid.Row="3" Grid.Column="1" Margin="5" IsReadOnly="True" BorderThickness="0"
                 Background="Transparent" ToolTip="{lex:Loc Common_CopyHint}"/>

        <Label Grid.Row="4" Content="{lex:Loc Plans_Line}" VerticalContentAlignment="Center"/>
        <TextBox x:Name="txt_line" Grid.Row="4" Grid.Column="1" Margin="5" IsReadOnly="True" BorderThickness="0"
                 Background="Transparent" ToolTip="{lex:Loc Common_CopyHint}"/>

        <!--报废序列号清单：必填，直接输入或上传文件二选一；提交时与领用清单核对，异常不能继续-->
        <GroupBox Grid.Row="5" Grid.ColumnSpan="2" Header="{lex:Loc ReqScrap_SnGroup}" Margin="0,8,0,0" Padding="5">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="rb_snInput" Content="{lex:Loc ReqScrap_SnInputMode}" IsChecked="True"
                                 Checked="SnMode_Changed" VerticalContentAlignment="Center"/>
                    <RadioButton x:Name="rb_snFile" Content="{lex:Loc ReqScrap_SnFileMode}" Margin="20,0,0,0"
                                 Checked="SnMode_Changed" VerticalContentAlignment="Center"/>
                </StackPanel>
                <Grid Grid.Row="1" Margin="0,5,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="txt_scrapSn" TextWrapping="Wrap" AcceptsReturn="True" AcceptsTab="True"
                             MinLines="3" MaxLines="9" VerticalScrollBarVisibility="Auto"
                             VerticalContentAlignment="Top" Padding="2"
                             ToolTip="{lex:Loc ReqScrap_SnPasteHint}"/>
                    <Button x:Name="btn_snFile" Content="{lex:Loc Common_SelectFileEllipsis}" Grid.Column="1" Margin="5,0,0,0"
                            Padding="10,2" Click="Btn_SnFile_Click" Visibility="Collapsed"/>
                    <TextBlock x:Name="txt_snFileName" Grid.Column="0" VerticalAlignment="Center"
                               Visibility="Collapsed" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextSecondaryBrush}"/>
                </Grid>
                <StackPanel Grid.Row="2" Margin="0,5,0,0">
                    <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}"
                               Text="{lex:Loc ReqScrap_SnFileSpec}"/>
                    <TextBlock x:Name="txt_reqSnInfo" Margin="0,3,0,0" TextWrapping="Wrap" FontWeight="Bold"/>
                </StackPanel>
            </Grid>
        </GroupBox>

        <!--报废信息：点「报废」写入该条领退记录（需点「提交保存」才入库）-->
        <Label Grid.Row="6" Content="{lex:Loc ReqScrap_No}" VerticalContentAlignment="Center"/>
        <TextBox x:Name="txt_scrapNo" Grid.Row="6" Grid.Column="1" Margin="5" VerticalContentAlignment="Center"/>

        <Label Grid.Row="7" Content="{lex:Loc ReqScrap_Qty}" VerticalContentAlignment="Center"
               Style="{StaticResource RequiredFieldLabel}"/>
        <TextBox x:Name="txt_scrapQty" Grid.Row="7" Grid.Column="1" Margin="5" VerticalContentAlignment="Center"/>

        <Grid Grid.Row="8" Grid.ColumnSpan="2" Margin="0,10,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Label Content="{lex:Loc ReqScrap_Date}" VerticalContentAlignment="Center"
                       Style="{StaticResource RequiredFieldLabel}"/>
                <DatePicker x:Name="dp_scrapDate" Grid.Column="1" Margin="5" VerticalContentAlignment="Center"/>
            </Grid>
            <StackPanel Grid.Row="1" Margin="0,4,0,0">
                <TextBlock Text="{lex:Loc Common_RequiredHint}" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                <TextBlock x:Name="txt_hint" Margin="0,3,0,0" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextSecondaryBrush}"/>
            </StackPanel>
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                <Button Content="{lex:Loc ReqScrap_Btn}" Width="90" Click="Btn_Scrap_Click" IsDefault="True"/>
                <Button Content="{lex:Loc Common_Cancel}" Width="90" Margin="10,0,0,0" Click="Btn_Cancel_Click" IsCancel="True"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
