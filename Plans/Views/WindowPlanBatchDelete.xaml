<Window x:Class="ORT一键报告.Plans.Views.WindowPlanBatchDelete" Background="{DynamicResource WindowBackgroundBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:lex="http://wpflocalizeextension.codeplex.com"
        xmlns:conv="clr-namespace:ORT一键报告.Converters"
        mc:Ignorable="d"
        Width="820" Height="420" MinWidth="640" MinHeight="300" ShowInTaskbar="False"
        WindowStartupLocation="Manual">

    <Window.Resources>
        <conv:SingleLineTextConverter x:Key="SingleLine"/>
        <Style x:Key="BatchCell" TargetType="DataGridCell">
            <Setter Property="Padding" Value="2,0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>
        <Style x:Key="BatchText" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="ToolTip" Value="{Binding RelativeSource={RelativeSource Self}, Path=Text}"/>
        </Style>
        <!-- 置顶开关：外观沿用主题按钮，勾选时用强调色填充，和界面其余按钮一致 -->
        <Style x:Key="TopmostToggle" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="{DynamicResource ButtonForegroundBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="bd"
                                Background="{DynamicResource ButtonBackgroundBrush}"
                                BorderBrush="{DynamicResource ButtonBorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{DynamicResource CornerRadiusButton}"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource ButtonHoverBrush}"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource PrimaryBrush}"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource PrimaryForegroundBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="{DynamicResource DisabledOpacity}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="txt_hint" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}"/>

        <!--清单：只列辨认计划记录所需的信息（与单条删除时确认的条目一致），右键单击任一单元格即复制该值-->
        <DataGrid x:Name="dg_items" Grid.Row="1" Margin="0,6,0,0"
                  AutoGenerateColumns="False" CanUserAddRows="False" CanUserSortColumns="False"
                  CanUserReorderColumns="False" IsReadOnly="True"
                  HeadersVisibility="Column" GridLinesVisibility="All"
                  SelectionMode="Extended" SelectionUnit="FullRow"
                  ClipboardCopyMode="None"
                  CellStyle="{StaticResource BatchCell}"
                  SelectionChanged="Dg_Items_SelectionChanged"
                  VirtualizingPanel.IsVirtualizing="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="{lex:Loc Plans_WorkNumber}" SortMemberPath="JobNo" Width="150"
                                    Binding="{Binding JobNo}" ElementStyle="{StaticResource BatchText}"/>
                <DataGridTextColumn Header="{lex:Loc Plans_ModelName}" SortMemberPath="ModelName" Width="220"
                                    Binding="{Binding ModelName}" ElementStyle="{StaticResource BatchText}"/>
                <DataGridTextColumn Header="{lex:Loc Plans_TestItem}" SortMemberPath="TestItem" Width="200"
                                    Binding="{Binding TestItem}" ElementStyle="{StaticResource BatchText}"/>
            </DataGrid.Columns>
        </DataGrid>

        <Grid Grid.Row="2" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <!--置顶：默认不置顶，勾选后窗口始终显示在其他窗口之上（方便边点表格边核对清单）-->
            <ToggleButton x:Name="btn_topmost" Style="{StaticResource TopmostToggle}"
                          Content="{lex:Loc Plans_Batch_Topmost}" ToolTip="{lex:Loc Plans_Batch_TopmostToolTip}"
                          Checked="Btn_Topmost_Changed" Unchecked="Btn_Topmost_Changed"/>
            <!--移除点错加入的记录-->
            <Button x:Name="btn_remove" Grid.Column="1" Content="{lex:Loc Plans_Batch_RemoveSelected}" Padding="8,2"
                    Margin="8,0,0,0" Click="Btn_Remove_Click"/>
            <TextBlock Grid.Column="2" Margin="12,0,0,0" Text="{lex:Loc Plans_Batch_CopyHint}"
                       VerticalAlignment="Center" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextSecondaryBrush}"/>
            <StackPanel Grid.Column="3" Orientation="Horizontal">
                <Button x:Name="btn_confirm" Width="110" Click="Btn_Confirm_Click" IsDefault="True"/>
                <Button Content="{lex:Loc Common_Cancel}" Width="90" Margin="10,0,0,0" Click="Btn_Cancel_Click" IsCancel="True"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
