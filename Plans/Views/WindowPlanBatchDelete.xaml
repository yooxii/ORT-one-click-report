<Window x:Class="ORT一键报告.Plans.Views.WindowPlanBatchDelete" Background="{DynamicResource WindowBackgroundBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:lex="http://wpflocalizeextension.codeplex.com"
        xmlns:conv="clr-namespace:ORT一键报告.Converters"
        mc:Ignorable="d"
        Width="980" Height="480" MinWidth="760" MinHeight="340" ShowInTaskbar="False"
        WindowStartupLocation="Manual">

    <Window.Resources>
        <conv:SingleLineTextConverter x:Key="SingleLine"/>
        <Style x:Key="BatchCell" TargetType="DataGridCell">
            <Setter Property="Padding" Value="2,0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>
        <Style x:Key="BatchText" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="ToolTip" Value="{Binding RelativeSource={RelativeSource Self}, Path=Text}"/>
        </Style>
        <Style x:Key="BatchResultText" TargetType="TextBlock" BasedOn="{StaticResource BatchText}">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource StatusPendingBrush}"/>
        </Style>
        <!-- 置顶开关：外观沿用主题按钮，勾选时用强调色填充，和界面其余按钮一致 -->
        <Style x:Key="TopmostToggle" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="{DynamicResource ButtonForegroundBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="bd"
                                Background="{DynamicResource ButtonBackgroundBrush}"
                                BorderBrush="{DynamicResource ButtonBorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{DynamicResource CornerRadiusButton}"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource ButtonHoverBrush}"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource PrimaryBrush}"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource PrimaryForegroundBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="{DynamicResource DisabledOpacity}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="txt_hint" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}"/>

        <Border Grid.Row="1" Margin="0,6,0,6" Padding="8,4" CornerRadius="{DynamicResource CornerRadiusSmall}"
                Background="{DynamicResource CardBackgroundBrush}">
            <TextBlock x:Name="txt_summary" TextWrapping="Wrap" FontWeight="Bold"/>
        </Border>

        <!--清单工具条：点错时可以移除选中的那几条-->
        <DockPanel Grid.Row="2" Margin="0,0,0,4">
            <TextBlock x:Name="txt_empty" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="8,0,0,0"
                       Foreground="{DynamicResource TextSecondaryBrush}" Text="{lex:Loc Plans_Batch_EmptyHint}"/>
            <Button x:Name="btn_remove" Content="{lex:Loc Plans_Batch_RemoveSelected}" Padding="8,2"
                    HorizontalAlignment="Left" Click="Btn_Remove_Click"/>
        </DockPanel>

        <!--清单：将被标记删除的计划记录全部关键信息（右键单击任一单元格即复制该值）-->
        <DataGrid x:Name="dg_items" Grid.Row="3"
                  AutoGenerateColumns="False" CanUserAddRows="False" CanUserSortColumns="False"
                  CanUserReorderColumns="True" IsReadOnly="True"
                  HeadersVisibility="Column" GridLinesVisibility="All"
                  SelectionMode="Extended" SelectionUnit="Cell"
                  ClipboardCopyMode="None" FrozenColumnCount="1"
                  CellStyle="{StaticResource BatchCell}"
                  SelectionChanged="Dg_Items_SelectionChanged"
                  VirtualizingPanel.IsVirtualizing="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="{lex:Loc Plans_Batch_ResultHeader}" Binding="{Binding Result}"
                                    SortMemberPath="Result" Width="200"
                                    ElementStyle="{StaticResource BatchResultText}"/>
                <DataGridTextColumn Header="{lex:Loc Plans_WorkNumber}" SortMemberPath="JobNo" Width="110"
                                    Binding="{Binding Item.JobNo}" ElementStyle="{StaticResource BatchText}"/>
                <DataGridTextColumn Header="{lex:Loc Plans_ProductType}" SortMemberPath="Product" Width="90"
                                    Binding="{Binding Item.Product}" ElementStyle="{StaticResource BatchText}"/>
                <DataGridTextColumn Header="{lex:Loc PlanEdit_Customer}" SortMemberPath="Customer" Width="100"
                                    Binding="{Binding Item.Customer}" ElementStyle="{StaticResource BatchText}"/>
                <DataGridTextColumn Header="{lex:Loc Plans_ModelName}" SortMemberPath="ModelName" Width="130"
                                    Binding="{Binding Item.ModelName}" ElementStyle="{StaticResource BatchText}"/>
                <DataGridTextColumn Header="{lex:Loc Plans_Stage}" SortMemberPath="Stage" Width="65"
                                    Binding="{Binding Item.Stage}" ElementStyle="{StaticResource BatchText}"/>
                <DataGridTextColumn Header="{lex:Loc Plans_TestItem}" SortMemberPath="TestItem" Width="150"
                                    Binding="{Binding Item.TestItem}" ElementStyle="{StaticResource BatchText}"/>
                <DataGridTextColumn Header="{lex:Loc PlanEdit_SampleQty}" SortMemberPath="SampleSize" Width="60"
                                    Binding="{Binding Item.SampleSize}" ElementStyle="{StaticResource BatchText}"/>
                <DataGridTextColumn Header="{lex:Loc Admin_TestTime}" SortMemberPath="TestPeriod" Width="70"
                                    Binding="{Binding Item.TestPeriod}" ElementStyle="{StaticResource BatchText}"/>
                <DataGridTextColumn Header="{lex:Loc Plans_Owner}" SortMemberPath="Owner" Width="80"
                                    Binding="{Binding Item.Owner}" ElementStyle="{StaticResource BatchText}"/>
                <DataGridTextColumn Header="{lex:Loc Plans_StartDate}" SortMemberPath="StartDate" Width="90"
                                    Binding="{Binding Item.StartDate, StringFormat={}{0:yyyy/M/d}}" ElementStyle="{StaticResource BatchText}"/>
                <DataGridTextColumn Header="{lex:Loc PlanEdit_EndDate}" SortMemberPath="EndDate" Width="90"
                                    Binding="{Binding Item.EndDate, StringFormat={}{0:yyyy/M/d}}" ElementStyle="{StaticResource BatchText}"/>
                <DataGridTextColumn Header="{lex:Loc Plans_Status}" SortMemberPath="Status" Width="75"
                                    Binding="{Binding Item.Status}" ElementStyle="{StaticResource BatchText}"/>
                <DataGridTextColumn Header="{lex:Loc Plans_ReportStatus}" SortMemberPath="ReportStatus" Width="80"
                                    Binding="{Binding Item.ReportStatus}" ElementStyle="{StaticResource BatchText}"/>
                <DataGridTextColumn Header="{lex:Loc Plans_UnitReturn}" SortMemberPath="UnitReturnDate" Width="90"
                                    Binding="{Binding Item.UnitReturnDate, StringFormat={}{0:yyyy/M/d}}" ElementStyle="{StaticResource BatchText}"/>
                <DataGridTextColumn Header="{lex:Loc Admin_Remark}" SortMemberPath="Remark" Width="150"
                                    Binding="{Binding Item.Remark, Converter={StaticResource SingleLine}}" ElementStyle="{StaticResource BatchText}"/>
            </DataGrid.Columns>
        </DataGrid>

        <Grid Grid.Row="4" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <!--置顶：默认不置顶，勾选后窗口始终显示在其他窗口之上（方便边点表格边核对清单）-->
            <ToggleButton x:Name="btn_topmost" Style="{StaticResource TopmostToggle}"
                          Content="{lex:Loc Plans_Batch_Topmost}" ToolTip="{lex:Loc Plans_Batch_TopmostToolTip}"
                          Checked="Btn_Topmost_Changed" Unchecked="Btn_Topmost_Changed"/>
            <TextBlock Grid.Column="1" Margin="12,0,0,0" Text="{lex:Loc Plans_Batch_CopyHint}"
                       VerticalAlignment="Center" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextSecondaryBrush}"/>
            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button x:Name="btn_confirm" Width="110" Click="Btn_Confirm_Click" IsDefault="True"/>
                <Button Content="{lex:Loc Common_Cancel}" Width="90" Margin="10,0,0,0" Click="Btn_Cancel_Click" IsCancel="True"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
