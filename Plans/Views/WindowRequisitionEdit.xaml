<Window x:Class="ORT一键报告.Plans.Views.WindowRequisitionEdit"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="领退表新增/编辑" Height="680" Width="680" MinHeight="560" MinWidth="600"
        WindowStartupLocation="CenterOwner" SizeToContent="Height">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>

        <!--领退信息（必填项带*）-->
        <GroupBox Header="领退信息" Padding="5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                </Grid.RowDefinitions>
                <Label Content="領用日期*"/>
                <DatePicker x:Name="dp_reqDate" Grid.Column="1" Margin="3" VerticalContentAlignment="Center"/>
                <Label Content="領料單据號*" Grid.Column="2"/>
                <TextBox x:Name="txt_reqNo" Grid.Column="3" Margin="3"/>

                <Label Content="機種名稱*" Grid.Row="1"/>
                <TextBox x:Name="txt_model" Grid.Row="1" Grid.Column="1" Margin="3"/>
                <Label Content="領出數量*" Grid.Row="1" Grid.Column="2"/>
                <TextBox x:Name="txt_outQty" Grid.Row="1" Grid.Column="3" Margin="3"/>

                <Label Content="REV.*" Grid.Row="2"/>
                <TextBox x:Name="txt_rev" Grid.Row="2" Grid.Column="1" Margin="3"/>
                <Label Content="Work Order*" Grid.Row="2" Grid.Column="2"/>
                <TextBox x:Name="txt_workOrder" Grid.Row="2" Grid.Column="3" Margin="3"/>

                <Label Content="D/C" Grid.Row="3"/>
                <TextBox x:Name="txt_dc" Grid.Row="3" Grid.Column="1" Margin="3" IsReadOnly="True" ToolTip="根据Work Order自动补全"/>
                <Label Content="線別" Grid.Row="3" Grid.Column="2"/>
                <TextBox x:Name="txt_lineNo" Grid.Row="3" Grid.Column="3" Margin="3" IsReadOnly="True" ToolTip="根据Work Order自动补全"/>

                <Label Content="回线RT工令" Grid.Row="4"/>
                <CheckBox x:Name="chk_genReturnRt" Grid.Row="4" Grid.Column="1" VerticalAlignment="Center"
                          Content="自动生成" IsChecked="True" Checked="Chk_GenReturnRt_Changed" Unchecked="Chk_GenReturnRt_Changed"
                          ToolTip="自动生成 RTAH{当前年月}{编号}"/>
                <TextBox x:Name="txt_returnRt" Grid.Row="4" Grid.Column="3" Margin="3" IsReadOnly="True"/>
            </Grid>
        </GroupBox>

        <!--序列号：自定义输入 / 上传文件 二选一-->
        <GroupBox Header="S/N *（字符串或附件）" Grid.Row="1" Margin="0,5,0,0" Padding="5">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="rb_snInput" Content="自定义输入" IsChecked="True" Checked="SnMode_Changed" VerticalContentAlignment="Center"/>
                    <RadioButton x:Name="rb_snFile" Content="上传文件" Margin="20,0,0,0" Checked="SnMode_Changed" VerticalContentAlignment="Center"/>
                </StackPanel>
                <Grid Grid.Row="1" Margin="0,5,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="txt_sn" VerticalContentAlignment="Center" TextWrapping="WrapWithOverflow"/>
                    <Button x:Name="btn_snFile" Content="选择文件..." Grid.Column="1" Margin="5,0,0,0"
                            Padding="10,2" Click="Btn_SnFile_Click" Visibility="Collapsed"/>
                    <TextBlock x:Name="txt_snFileName" Grid.Column="0" VerticalAlignment="Center"
                               Visibility="Collapsed" TextTrimming="CharacterEllipsis" Foreground="Gray"/>
                </Grid>
            </Grid>
        </GroupBox>

        <!--计划表同步信息-->
        <GroupBox Header="计划表同步信息 *（领退新增时同步新增计划）" Grid.Row="2" Margin="0,5,0,0" Padding="5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                </Grid.RowDefinitions>
                <Label Content="测试项目*"/>
                <ComboBox x:Name="cb_testItem" Grid.Column="1" Margin="3" VerticalContentAlignment="Center"
                          SelectionChanged="Cb_TestItem_SelectionChanged"/>
                <Label Content="开始时间*" Grid.Column="2"/>
                <DatePicker x:Name="dp_startDate" Grid.Column="3" Margin="3" VerticalContentAlignment="Center"/>

                <Label Content="阶段*" Grid.Row="1"/>
                <ComboBox x:Name="cb_stage" Grid.Row="1" Grid.Column="1" Margin="3" VerticalContentAlignment="Center"/>

                <Label Content="工作编号" Grid.Row="2"/>
                <TextBox x:Name="txt_jobNo" Grid.Row="2" Grid.Column="1" Margin="3" IsReadOnly="True" ToolTip="自动生成 RT{当前年月}{编号}"/>
                <Label Content="样品数" Grid.Row="2" Grid.Column="2"/>
                <TextBox x:Name="txt_sampleSize" Grid.Row="2" Grid.Column="3" Margin="3" IsReadOnly="True" ToolTip="与领出数量一致"/>

                <Label Content="产品别" Grid.Row="3"/>
                <TextBox x:Name="txt_product" Grid.Row="3" Grid.Column="1" Margin="3" IsReadOnly="True" ToolTip="根据机种名自动查询"/>
                <Label Content="客户别" Grid.Row="3" Grid.Column="2"/>
                <TextBox x:Name="txt_customer" Grid.Row="3" Grid.Column="3" Margin="3" IsReadOnly="True" ToolTip="根据机种名自动查询"/>
            </Grid>
        </GroupBox>

        <!--其他-->
        <GroupBox Header="其他" Grid.Row="3" Margin="0,5,0,0" Padding="5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition/><RowDefinition/><RowDefinition/>
                </Grid.RowDefinitions>
                <Label Content="负责人"/>
                <TextBox x:Name="txt_owner" Grid.Column="1" Margin="3" IsReadOnly="True" ToolTip="根据测试项目自动查询"/>
                <Label Content="试验时间" Grid.Row="1"/>
                <TextBox x:Name="txt_testPeriod" Grid.Row="1" Grid.Column="1" Margin="3" IsReadOnly="True" ToolTip="根据测试项目自动查询"/>
                <Label Content="结束日期" Grid.Row="2"/>
                <DatePicker x:Name="dp_endDate" Grid.Row="2" Grid.Column="1" Margin="3" IsEnabled="False" ToolTip="根据试验时间自动计算"/>
            </Grid>
        </GroupBox>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="保存" Width="90" Height="28" Click="Btn_Save_Click" IsDefault="True"/>
            <Button Content="取消" Width="90" Height="28" Margin="10,0,0,0" Click="Btn_Cancel_Click" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
