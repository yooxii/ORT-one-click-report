<Window x:Class="ORT一键报告.Plans.Views.WindowRequisitionEdit" Background="{DynamicResource WindowBackgroundBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:lex="http://wpflocalizeextension.codeplex.com"
        mc:Ignorable="d"
        Title="{lex:Loc ReqEdit_Title}" Height="680" Width="680" MinHeight="560" MinWidth="600"
        WindowStartupLocation="CenterOwner" SizeToContent="Height">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>

        <!--领退信息（必填项带*）-->
        <GroupBox Header="{lex:Loc ReqEdit_ReturnInfo}" Padding="5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                </Grid.RowDefinitions>
                <Label Content="{lex:Loc ReqEdit_DateTC}"/>
                <DatePicker x:Name="dp_reqDate" Grid.Column="1" Margin="3" VerticalContentAlignment="Center"/>
                <Label Content="{lex:Loc ReqEdit_DocNoTC}" Grid.Column="2"/>
                <TextBox x:Name="txt_reqNo" Grid.Column="3" Margin="3"/>

                <Label Content="{lex:Loc ReqEdit_ModelName}" Grid.Row="1"/>
                <TextBox x:Name="txt_model" Grid.Row="1" Grid.Column="1" Margin="3" TextChanged="Txt_Model_TextChanged"
                         ToolTip="{lex:Loc ReqEdit_ModelDispositionHint}"/>
                <Label Content="{lex:Loc ReqEdit_QtyTC}" Grid.Row="1" Grid.Column="2"/>
                <TextBox x:Name="txt_outQty" Grid.Row="1" Grid.Column="3" Margin="3" TextChanged="Txt_OutQty_TextChanged"/>

                <Label Content="REV.*" Grid.Row="2"/>
                <!--版本输入框：填入机种后以水印提示「最近版本：xxx」，留空保存即用该版本-->
                <Grid Grid.Row="2" Grid.Column="1" Margin="3">
                    <TextBox x:Name="txt_rev" TextChanged="Txt_Rev_TextChanged"/>
                    <TextBlock x:Name="txt_revHint" IsHitTestVisible="False" Margin="6,0,4,0"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource TextSecondaryBrush}" Visibility="Collapsed"/>
                </Grid>
                <Label Content="Work Order*" Grid.Row="2" Grid.Column="2"/>
                <TextBox x:Name="txt_workOrder" Grid.Row="2" Grid.Column="3" Margin="3"
                         TextChanged="Txt_WorkOrder_TextChanged" ToolTip="{lex:Loc ReqEdit_WorkOrderHint}"/>

                <Label Content="D/C" Grid.Row="3"/>
                <TextBox x:Name="txt_dc" Grid.Row="3" Grid.Column="1" Margin="3" ToolTip="{lex:Loc ReqEdit_SNHint}"/>
                <Label Content="{lex:Loc ReqEdit_LineTC}" Grid.Row="3" Grid.Column="2"/>
                <TextBox x:Name="txt_lineNo" Grid.Row="3" Grid.Column="3" Margin="3" ToolTip="{lex:Loc ReqEdit_SNHint}"/>

                <!--回线RT工令：由「单体去向」驱动——入库才需要（启用且保存时必填），报废禁用并留空-->
                <Label Content="{lex:Loc Plans_ReturnRTOrder}" Grid.Row="4" Background="Transparent" Cursor="Hand"
                       ToolTip="{lex:Loc PlanEdit_RefreshRtHint}" MouseLeftButtonUp="Lbl_ReturnRt_Click"/>
                <TextBox x:Name="txt_returnRt" Grid.Row="4" Grid.Column="1" Margin="3"
                         ToolTip="{lex:Loc PlanEdit_RefreshRtHint}"/>

                <!--单体去向：入库/报废二选一（必填，决定测试后走哪条终态分支）-->
                <Label Content="{lex:Loc ReqEdit_Disposition}" Grid.Row="5"/>
                <ComboBox x:Name="cb_disposition" Grid.Row="5" Grid.Column="1" Margin="3" VerticalContentAlignment="Center"
                          ToolTip="{lex:Loc ReqEdit_DispositionHint}"/>
            </Grid>
        </GroupBox>

        <!--序列号：自定义输入 / 上传文件 二选一（必填）-->
        <GroupBox Header="{lex:Loc ReqEdit_SN}" Grid.Row="1" Margin="0,5,0,0" Padding="5"
>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="rb_snInput" Content="{lex:Loc ReqEdit_CustomInput}" IsChecked="True" Checked="SnMode_Changed" VerticalContentAlignment="Center"/>
                    <RadioButton x:Name="rb_snFile" Content="{lex:Loc Common_UploadFile}" Margin="20,0,0,0" Checked="SnMode_Changed" VerticalContentAlignment="Center"/>
                </StackPanel>
                <Grid Grid.Row="1" Margin="0,5,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="txt_sn" TextWrapping="Wrap" AcceptsReturn="True" AcceptsTab="True"
                             MinLines="2" MaxLines="8" VerticalScrollBarVisibility="Auto"
                             VerticalContentAlignment="Top" Padding="2"/>
                    <Button x:Name="btn_snFile" Content="{lex:Loc Common_SelectFileEllipsis}" Grid.Column="1" Margin="5,0,0,0"
                            Padding="10,2" Click="Btn_SnFile_Click" Visibility="Collapsed"/>
                    <TextBlock x:Name="txt_snFileName" Grid.Column="0" VerticalAlignment="Center"
                               Visibility="Collapsed" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextSecondaryBrush}"/>
                </Grid>
            </Grid>
        </GroupBox>

        <!--计划表同步信息：折叠=不同步（只登记领退信息）；展开=同时建立/更新计划表记录，下列字段必填。
            「其他」的负责人/试验时间/结束日期也一并放在里面，折叠时一起隐藏。-->
        <Expander x:Name="exp_planSync" Grid.Row="2" Margin="0,5,0,0" IsExpanded="False"
                  Header="{lex:Loc ReqEdit_PlanSync}" Expanded="Exp_PlanSync_Toggled" Collapsed="Exp_PlanSync_Toggled">
            <StackPanel>
                <GroupBox Padding="5">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                        </Grid.RowDefinitions>
                        <Label Content="{lex:Loc PlanEdit_TestItem}"/>
                        <ComboBox x:Name="cb_testItem" Grid.Column="1" Margin="3" VerticalContentAlignment="Center"
                                  SelectionChanged="Cb_TestItem_SelectionChanged"/>
                        <Label Content="{lex:Loc PlanEdit_StartTime}" Grid.Column="2"/>
                        <DatePicker x:Name="dp_startDate" Grid.Column="3" Margin="3" VerticalContentAlignment="Center"/>

                        <Label Content="{lex:Loc ReqEdit_Stage}" Grid.Row="1"/>
                        <ComboBox x:Name="cb_stage" Grid.Row="1" Grid.Column="1" Margin="3" VerticalContentAlignment="Center"/>
                        <Label Content="{lex:Loc Plans_ReportStatus}" Grid.Row="1" Grid.Column="2"/>
                        <ComboBox x:Name="cb_reportStatus" Grid.Row="1" Grid.Column="3" Margin="3" VerticalContentAlignment="Center"
                                  ToolTip="{lex:Loc Plans_ReportStatusHint}"/>

                        <Label Content="{lex:Loc PlanEdit_WorkNumber}" Grid.Row="2" Background="Transparent" Cursor="Hand"
                               ToolTip="{lex:Loc PlanEdit_RefreshJobNoHint}" MouseLeftButtonUp="Lbl_JobNo_Click"/>
                        <TextBox x:Name="txt_jobNo" Grid.Row="2" Grid.Column="1" Margin="3" ToolTip="{lex:Loc ReqEdit_AutoGenRT}"/>
                        <Label Content="{lex:Loc PlanEdit_SampleQty}" Grid.Row="2" Grid.Column="2"/>
                        <TextBox x:Name="txt_sampleSize" Grid.Row="2" Grid.Column="3" Margin="3" ToolTip="{lex:Loc ReqEdit_QtyHint}"/>

                        <Label Content="{lex:Loc Plans_ProductType}" Grid.Row="3"/>
                        <TextBox x:Name="txt_product" Grid.Row="3" Grid.Column="1" Margin="3" ToolTip="{lex:Loc ReqEdit_ModelNameHint}"/>
                        <Label Content="{lex:Loc PlanEdit_Customer}" Grid.Row="3" Grid.Column="2"/>
                        <TextBox x:Name="txt_customer" Grid.Row="3" Grid.Column="3" Margin="3" ToolTip="{lex:Loc ReqEdit_ModelNameHint}"/>

                        <TextBlock Grid.Row="4" Grid.ColumnSpan="4" Margin="3,6,3,0" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextSecondaryBrush}" Text="{lex:Loc ReqEdit_PlanSyncRequired}"/>
                    </Grid>
                </GroupBox>

                <!--其他：负责人 / 试验时间 / 结束日期，已并入「计划表同步信息」折叠区（只在同步计划时才需要填）-->
                <GroupBox Header="{lex:Loc PlanEdit_Other}" Margin="0,5,0,0" Padding="5">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition/><RowDefinition/>
                        </Grid.RowDefinitions>
                        <Label Content="{lex:Loc Plans_Owner}"/>
                        <TextBox x:Name="txt_owner" Grid.Column="1" Margin="3" ToolTip="{lex:Loc PlanEdit_TestItemHint}"/>
                        <Label Content="{lex:Loc Admin_TestTime}" Grid.Column="2"/>
                        <TextBox x:Name="txt_testPeriod" Grid.Column="3" Margin="3" ToolTip="{lex:Loc PlanEdit_TestItemHint}"/>

                        <Label Content="{lex:Loc PlanEdit_EndDate}" Grid.Row="1"/>
                        <DatePicker x:Name="dp_endDate" Grid.Row="1" Grid.Column="1" Margin="3" ToolTip="{lex:Loc PlanEdit_EndDateHint}"/>
                    </Grid>
                </GroupBox>
            </StackPanel>
        </Expander>

        <!--按钮行：左侧必填提示，右侧 保存 / 保存并继续（仅新增） / 取消。不写死按钮高度（主题按钮模板自带 Padding(8,7)）-->
        <Grid Grid.Row="3" Margin="0,10,0,0">
            <TextBlock Text="{lex:Loc Common_RequiredHint}" VerticalAlignment="Center" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextSecondaryBrush}"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="{lex:Loc Common_Save}" Width="90" Click="Btn_Save_Click" IsDefault="True"/>
                <Button x:Name="btn_saveAndContinue" Content="{lex:Loc Common_SaveAndContinue}" Width="110"
                        Margin="10,0,0,0" Click="Btn_SaveAndContinue_Click"
                        ToolTip="{lex:Loc Common_SaveAndContinueHint}" Visibility="Collapsed"/>
                <Button Content="{lex:Loc Common_Cancel}" Width="90" Margin="10,0,0,0" Click="Btn_Cancel_Click" IsCancel="True"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
