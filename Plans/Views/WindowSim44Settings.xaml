<Window x:Class="ORT一键报告.Plans.Views.WindowSim44Settings"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:lex="http://wpflocalizeextension.codeplex.com"
        mc:Ignorable="d"
        Background="{DynamicResource WindowBackgroundBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
        Title="{lex:Loc Sim44_Settings_Title}" Width="560" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">

    <StackPanel Margin="16">
        <TextBlock Text="{lex:Loc Sim44_Settings_Intro}" TextWrapping="Wrap"
                   Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,12"/>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" MinWidth="120"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Label Content="{lex:Loc Sim44_Settings_DataSource}" VerticalContentAlignment="Center"/>
            <TextBox x:Name="txt_dataSource" Grid.Column="1" Margin="4,3" VerticalContentAlignment="Center"/>

            <Label Grid.Row="1" Content="{lex:Loc Sim44_Settings_Table}" VerticalContentAlignment="Center"/>
            <TextBox x:Name="txt_table" Grid.Row="1" Grid.Column="1" Margin="4,3" VerticalContentAlignment="Center"
                     ToolTip="{lex:Loc Sim44_Settings_TableHint}"/>

            <TextBlock Grid.Row="2" Grid.Column="1" Text="{lex:Loc Sim44_Settings_TableHint}" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="4,0,0,6"/>

            <Label Grid.Row="3" Content="{lex:Loc Sim44_Settings_BridgePath}" VerticalContentAlignment="Center"/>
            <TextBox x:Name="txt_bridge" Grid.Row="3" Grid.Column="1" Margin="4,3" VerticalContentAlignment="Center"
                     ToolTip="{lex:Loc Sim44_Settings_BridgeHint}"/>

            <TextBlock Grid.Row="4" Grid.Column="1" Text="{lex:Loc Sim44_Settings_BridgeHint}" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="4,0,0,0"/>
        </Grid>

        <TextBlock x:Name="txt_probe" TextWrapping="Wrap" Margin="0,10,0,0"
                   Foreground="{DynamicResource TextSecondaryBrush}"/>

        <Grid Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="btn_probe" Content="{lex:Loc Sim44_Settings_Probe}" Padding="10,3"
                    ToolTip="{lex:Loc Sim44_Settings_ProbeHint}" Click="Btn_Probe_Click"/>
            <Button Grid.Column="2" Content="{lex:Loc Common_Save}" Width="90" Padding="0,3" Margin="0,0,0,0"
                    Click="Btn_Save_Click" IsDefault="True"/>
            <Button Grid.Column="3" Content="{lex:Loc Common_Close}" Width="90" Padding="0,3" Margin="10,0,0,0"
                    IsCancel="True" Click="Btn_Close_Click"/>
        </Grid>
    </StackPanel>
</Window>
