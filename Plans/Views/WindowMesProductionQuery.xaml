<Window x:Class="ORT一键报告.Plans.Views.WindowMesProductionQuery"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:lex="http://wpflocalizeextension.codeplex.com"
        mc:Ignorable="d"
        Background="{DynamicResource WindowBackgroundBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
        Title="{lex:Loc ProdQuery_Title}" Height="720" Width="1060" MinHeight="560" MinWidth="880"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!--登录状态-->
        <Border BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" Padding="10,6" Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{lex:Loc Sim44_Status_Db}" VerticalAlignment="Center"/>
                    <TextBlock x:Name="txt_loginState" Margin="6,0,16,0" VerticalAlignment="Center" FontWeight="SemiBold"/>
                    <TextBlock x:Name="txt_loginHint" VerticalAlignment="Center" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="btn_login" Content="{lex:Loc Sim44_Login}" Padding="10,3" Margin="0,0,8,0"
                            Click="Btn_Login_Click"/>
                    <Button x:Name="btn_settings" Content="{lex:Loc Sim44_Settings_Open}" Padding="10,3"
                            Click="Btn_Settings_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <TabControl x:Name="tabs" Grid.Row="1">
            <!--月排程 / 小工令-->
            <TabItem Header="{lex:Loc ProdQuery_TabSchedule}">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Label Content="{lex:Loc ProdQuery_Date}" VerticalContentAlignment="Center"/>
                        <Grid Grid.Column="1" Margin="4,3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <DatePicker x:Name="dp_s_from" VerticalContentAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="~" VerticalAlignment="Center" Margin="4,0"/>
                            <DatePicker x:Name="dp_s_to" Grid.Column="2" VerticalContentAlignment="Center"/>
                        </Grid>
                        <Label Grid.Column="2" Content="PCB" VerticalContentAlignment="Center" Margin="8,0,0,0"/>
                        <TextBox x:Name="txt_s_pcb" Grid.Column="3" Width="150" Margin="4,3" VerticalContentAlignment="Center"/>
                        <Button x:Name="btn_s_query" Grid.Column="4" Content="{lex:Loc Common_Query}" Padding="16,3"
                                Margin="8,0,0,0" Click="Btn_ScheduleQuery_Click" IsDefault="True"/>
                        <TextBlock Grid.Column="5" x:Name="txt_s_state" VerticalAlignment="Center" Margin="10,0,0,0"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </Grid>
                    <DataGrid x:Name="grid_schedule" Grid.Row="1" Margin="0,8,0,0" AutoGenerateColumns="True"
                              IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"/>
                </Grid>
            </TabItem>

            <!--准备领用单-->
            <TabItem Header="{lex:Loc ProdQuery_TabPreIssue}">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Label Content="{lex:Loc ProdQuery_Date}" VerticalContentAlignment="Center"/>
                        <Grid Grid.Column="1" Margin="4,3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <DatePicker x:Name="dp_p_from" VerticalContentAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="~" VerticalAlignment="Center" Margin="4,0"/>
                            <DatePicker x:Name="dp_p_to" Grid.Column="2" VerticalContentAlignment="Center"/>
                        </Grid>
                        <Label Grid.Column="2" Content="{lex:Loc ProdQuery_User}" VerticalContentAlignment="Center" Margin="8,0,0,0"/>
                        <TextBox x:Name="txt_p_user" Grid.Column="3" Width="130" Margin="4,3" VerticalContentAlignment="Center"/>
                        <Button x:Name="btn_p_query" Grid.Column="4" Content="{lex:Loc Common_Query}" Padding="16,3"
                                Margin="8,0,0,0" Click="Btn_PreIssueQuery_Click"/>
                        <TextBlock Grid.Column="5" x:Name="txt_p_state" VerticalAlignment="Center" Margin="10,0,0,0"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </Grid>
                    <Grid Grid.Row="1" Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Label Content="{lex:Loc ProdQuery_Vchno}" VerticalContentAlignment="Center"/>
                        <TextBox x:Name="txt_v_from" Grid.Column="1" Margin="4,3" VerticalContentAlignment="Center"/>
                        <Label Grid.Column="2" Content="~" VerticalContentAlignment="Center" Margin="4,0"/>
                        <TextBox x:Name="txt_v_to" Grid.Column="3" Margin="4,3" VerticalContentAlignment="Center"/>
                        <Label Grid.Column="4" Content="{lex:Loc ProdQuery_Part}" VerticalContentAlignment="Center" Margin="8,0,0,0"/>
                        <TextBox x:Name="txt_part_from" Grid.Column="5" Margin="4,3" VerticalContentAlignment="Center"/>
                        <Label Grid.Column="6" Content="~" VerticalContentAlignment="Center" Margin="4,0"/>
                        <TextBox x:Name="txt_part_to" Grid.Column="7" Margin="4,3" VerticalContentAlignment="Center"/>
                    </Grid>
                    <DataGrid x:Name="grid_preissue" Grid.Row="2" Margin="0,8,0,0" AutoGenerateColumns="True"
                              IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"/>
                </Grid>
            </TabItem>
        </TabControl>

        <Grid Grid.Row="2" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="txt_hint" VerticalAlignment="Center" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextSecondaryBrush}"/>
            <Button Grid.Column="1" Content="{lex:Loc Common_Close}" Width="90" Padding="0,3" IsCancel="True"
                    Click="Btn_Close_Click"/>
        </Grid>
    </Grid>
</Window>
