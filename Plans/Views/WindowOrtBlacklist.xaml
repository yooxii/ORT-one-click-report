<Window x:Class="ORT一键报告.Plans.Views.WindowOrtBlacklist"
        Background="{DynamicResource WindowBackgroundBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:lex="http://wpflocalizeextension.codeplex.com"
        mc:Ignorable="d"
        Title="{lex:Loc PreIssue_BlacklistTitle}" Width="820" Height="520" MinWidth="620" MinHeight="360"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">

    <Window.Resources>
        <Style x:Key="ListText" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="Margin" Value="0"/>
        </Style>
        <Style x:Key="ListCell" TargetType="DataGridCell">
            <Setter Property="Padding" Value="2,0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{lex:Loc PreIssue_BlacklistHint}" TextWrapping="Wrap"
                   Foreground="{DynamicResource TextSecondaryBrush}"/>

        <!-- 新增一条：类型（機種 / 正则） + 内容 + 原因 -->
        <WrapPanel Grid.Row="1" Margin="0,10,0,4">
            <Label Content="{lex:Loc PreIssue_BlacklistKind}" VerticalAlignment="Center"/>
            <ComboBox x:Name="cb_kind" Width="100" VerticalAlignment="Center" Margin="0,0,10,0"
                      SelectionChanged="Cb_Kind_SelectionChanged"/>
            <Label Content="{lex:Loc PreIssue_BlacklistEntry}" VerticalAlignment="Center"/>
            <TextBox x:Name="txt_model" Width="190" VerticalContentAlignment="Center" Margin="0,0,10,0"/>
            <Label Content="{lex:Loc PreIssue_Reason}" VerticalAlignment="Center"/>
            <TextBox x:Name="txt_reason" Width="180" VerticalContentAlignment="Center" Margin="0,0,10,0"/>
            <Button Content="{lex:Loc PreIssue_BlacklistAdd}" MinWidth="76" Padding="10,3" Click="Btn_Add_Click"/>
        </WrapPanel>

        <!-- 正则提示（只在「正则」类型时显示） -->
        <TextBlock x:Name="txt_pattern_hint" Grid.Row="2" Text="{lex:Loc PreIssue_BlacklistRegexHint}"
                   TextWrapping="Wrap" Margin="0,0,0,6" Visibility="Collapsed"
                   Foreground="{DynamicResource StatusWarnBrush}"/>

        <DataGrid x:Name="dg_blacklist" Grid.Row="3"
                  AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                  HeadersVisibility="Column" GridLinesVisibility="All"
                  SelectionMode="Single" SelectionUnit="FullRow" ClipboardCopyMode="None">
            <DataGrid.CellStyle>
                <StaticResource ResourceKey="ListCell"/>
            </DataGrid.CellStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="{lex:Loc PreIssue_BlacklistKind}" Binding="{Binding KindText}" Width="70" ElementStyle="{StaticResource ListText}"/>
                <DataGridTextColumn Header="{lex:Loc PreIssue_BlacklistEntry}" Binding="{Binding Model}" Width="230" ElementStyle="{StaticResource ListText}"/>
                <DataGridTextColumn Header="{lex:Loc PreIssue_Reason}" Binding="{Binding Reason}" Width="*" ElementStyle="{StaticResource ListText}"/>
                <DataGridTextColumn Header="{lex:Loc PreIssue_Changes_Operator}" Binding="{Binding CreatedBy}" Width="110" ElementStyle="{StaticResource ListText}"/>
                <DataGridTextColumn Header="{lex:Loc PreIssue_Changes_Time}" Binding="{Binding CreatedAt, StringFormat={}{0:yyyy/M/d HH:mm}}" Width="140" ElementStyle="{StaticResource ListText}"/>
            </DataGrid.Columns>
        </DataGrid>

        <DockPanel Grid.Row="4" Margin="0,10,0,0">
            <Button DockPanel.Dock="Right" Content="{lex:Loc Common_Close}" MinWidth="84" Padding="10,3" Margin="8,0,0,0"
                    IsCancel="True"/>
            <Button DockPanel.Dock="Right" Content="{lex:Loc PreIssue_BlacklistRemove}" MinWidth="84" Padding="10,3"
                    Click="Btn_Remove_Click"/>
            <TextBlock x:Name="txt_status" VerticalAlignment="Center" Foreground="{DynamicResource StatusWarnBrush}"/>
        </DockPanel>
    </Grid>
</Window>
