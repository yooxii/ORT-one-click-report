<Window x:Class="ORT一键报告.Plans.Views.WindowFlow" Background="{DynamicResource WindowBackgroundBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:lex="http://wpflocalizeextension.codeplex.com"
        xmlns:vm="clr-namespace:ORT一键报告.Plans.ViewModels"
        mc:Ignorable="d"
        Title="{lex:Loc Flow_Title}" Width="640" Height="720" MinHeight="480" MinWidth="560"
        WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <!-- 步骤节点：按状态配色（完成=绿 / 进行中=黄 / 未到达=灰 / 无需=灰 / 已驳回=红） -->
        <DataTemplate x:Key="StepTemplate" DataType="{x:Type vm:FlowStepItem}">
            <Border x:Name="stepBorder" BorderThickness="1" CornerRadius="{DynamicResource CornerRadiusSmall}"
                    Padding="8,5" Margin="2,0,2,6" Background="Transparent"
                    BorderBrush="{DynamicResource TextSecondaryBrush}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="auto"/>
                    </Grid.ColumnDefinitions>
                    <Ellipse x:Name="bullet" Width="10" Height="10" VerticalAlignment="Center" Margin="0,0,8,0"
                             Fill="{DynamicResource TextSecondaryBrush}"/>
                    <StackPanel Grid.Column="1">
                        <TextBlock x:Name="titleText" Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding Evidence}" TextWrapping="Wrap" Margin="0,2,0,0"
                                   Foreground="{DynamicResource TextSecondaryBrush}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Evidence}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Evidence}" Value="">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock x:Name="linkText" Margin="0,2,0,0">
                            <Hyperlink Click="FlowLink_Click" Tag="{Binding LinkPath}">
                                <Run Text="{Binding LinkText, Mode=OneWay}"/>
                            </Hyperlink>
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasLink}" Value="False">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                    <TextBlock x:Name="stateText" Grid.Column="2" Text="{Binding StateText}" FontWeight="Bold"
                               VerticalAlignment="Center" Margin="8,0,0,0"/>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding State}" Value="done">
                    <Setter TargetName="bullet" Property="Fill" Value="{DynamicResource StatusClosedBrush}"/>
                    <Setter TargetName="stateText" Property="Foreground" Value="{DynamicResource StatusClosedBrush}"/>
                    <Setter TargetName="stepBorder" Property="Background" Value="{DynamicResource StatusClosedBgBrush}"/>
                    <Setter TargetName="stepBorder" Property="BorderBrush" Value="{DynamicResource StatusClosedBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="current">
                    <Setter TargetName="bullet" Property="Fill" Value="{DynamicResource StatusOngoingBrush}"/>
                    <Setter TargetName="stateText" Property="Foreground" Value="{DynamicResource StatusOngoingBrush}"/>
                    <Setter TargetName="stepBorder" Property="Background" Value="{DynamicResource StatusOngoingBgBrush}"/>
                    <Setter TargetName="stepBorder" Property="BorderBrush" Value="{DynamicResource StatusOngoingBrush}"/>
                    <Setter TargetName="titleText" Property="FontWeight" Value="Bold"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="skipped">
                    <Setter TargetName="stateText" Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                    <Setter TargetName="stepBorder" Property="BorderBrush" Value="{DynamicResource TextSecondaryBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="rejected">
                    <Setter TargetName="bullet" Property="Fill" Value="{DynamicResource StatusPendingBrush}"/>
                    <Setter TargetName="stateText" Property="Foreground" Value="{DynamicResource StatusPendingBrush}"/>
                    <Setter TargetName="stepBorder" Property="Background" Value="{DynamicResource StatusPendingBgBrush}"/>
                    <Setter TargetName="stepBorder" Property="BorderBrush" Value="{DynamicResource StatusPendingBrush}"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- 一步行：1 个节点（普通）或 2 个节点（并行，如"新建報告模板 / 進行試驗"） -->
        <DataTemplate x:Key="RowTemplate" DataType="{x:Type vm:FlowRow}">
            <ItemsControl ItemsSource="{Binding Items}" ItemTemplate="{StaticResource StepTemplate}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Rows="1"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </DataTemplate>

        <!-- 图例小圆点 -->
        <Style x:Key="LegendDot" TargetType="Ellipse">
            <Setter Property="Width" Value="9"/>
            <Setter Property="Height" Value="9"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>

        <!-- 头部：流程类型 + 记录标识 + 当前所处节点 -->
        <Border Padding="10,8" CornerRadius="{DynamicResource CornerRadiusSmall}"
                Background="{DynamicResource CardBackgroundBrush}">
            <StackPanel>
                <TextBlock Text="{Binding FlowTitle}" FontSize="14" FontWeight="Bold"/>
                <TextBlock Text="{Binding Subtitle}" Margin="0,2,0,0" Foreground="{DynamicResource TextSecondaryBrush}"
                           TextWrapping="Wrap"/>
                <TextBlock Text="{Binding CurrentText}" Margin="0,4,0,0" FontWeight="SemiBold"
                           Foreground="{DynamicResource StatusOngoingBrush}"/>
            </StackPanel>
        </Border>

        <!-- 流程主体：线性步骤 + 双分支 + 共用结案 -->
        <ScrollViewer Grid.Row="1" Margin="0,8,0,0" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <ItemsControl ItemsSource="{Binding Rows}" ItemTemplate="{StaticResource RowTemplate}"/>

                <!-- 分支区（无分支的流程自动折叠）：报废 与 回线入库 两列 -->
                <Grid x:Name="branchArea" Margin="0,4,0,0">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Branches.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Branches[0].IsDimmed}" Value="True">
                                        <Setter Property="Opacity" Value="0.45"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Margin="2,0,2,4" TextWrapping="Wrap">
                            <Run Text="{Binding Branches[0].Title, Mode=OneWay}" FontWeight="Bold"/>
                            <Run Text=" "/>
                            <Run Text="{Binding Branches[0].StateText, Mode=OneWay}" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </TextBlock>
                        <ItemsControl ItemsSource="{Binding Branches[0].Steps}" ItemTemplate="{StaticResource StepTemplate}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Branches[1].IsDimmed}" Value="True">
                                        <Setter Property="Opacity" Value="0.45"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Margin="2,0,2,4" TextWrapping="Wrap">
                            <Run Text="{Binding Branches[1].Title, Mode=OneWay}" FontWeight="Bold"/>
                            <Run Text=" "/>
                            <Run Text="{Binding Branches[1].StateText, Mode=OneWay}" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </TextBlock>
                        <ItemsControl ItemsSource="{Binding Branches[1].Steps}" ItemTemplate="{StaticResource StepTemplate}"/>
                    </StackPanel>
                </Grid>

                <!-- 共用结案节点 -->
                <ContentControl Margin="0,4,0,0" Content="{Binding CloseStep}" ContentTemplate="{StaticResource StepTemplate}"/>
            </StackPanel>
        </ScrollViewer>

        <!-- 图例 + 判定依据说明 -->
        <StackPanel Grid.Row="2" Margin="2,8,0,0">
            <StackPanel Orientation="Horizontal">
                <Ellipse Style="{StaticResource LegendDot}" Fill="{DynamicResource StatusClosedBrush}"/>
                <TextBlock Text="{lex:Loc Flow_State_Done}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,12,0" VerticalAlignment="Center"/>
                <Ellipse Style="{StaticResource LegendDot}" Fill="{DynamicResource StatusOngoingBrush}"/>
                <TextBlock Text="{lex:Loc Flow_State_Current}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,12,0" VerticalAlignment="Center"/>
                <Ellipse Style="{StaticResource LegendDot}" Fill="{DynamicResource TextSecondaryBrush}"/>
                <TextBlock Text="{lex:Loc Flow_State_Waiting}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,12,0" VerticalAlignment="Center"/>
                <Ellipse Style="{StaticResource LegendDot}" Fill="{DynamicResource TextSecondaryBrush}"/>
                <TextBlock Text="{lex:Loc Flow_State_Skipped}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,12,0" VerticalAlignment="Center"/>
                <Ellipse Style="{StaticResource LegendDot}" Fill="{DynamicResource StatusPendingBrush}"/>
                <TextBlock Text="{lex:Loc Flow_State_Rejected}" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock Text="{Binding FooterNote}" Margin="0,4,0,0" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextSecondaryBrush}"/>
        </StackPanel>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="{lex:Loc Common_Close}" Width="90" Click="Btn_Close_Click" IsDefault="True" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
