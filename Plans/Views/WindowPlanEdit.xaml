<Window x:Class="ORT一键报告.Plans.Views.WindowPlanEdit"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="新增计划记录" Height="700" Width="640" MinHeight="500" MinWidth="600"
        WindowStartupLocation="CenterOwner" SizeToContent="Height">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>

        <!--计划信息-->
        <GroupBox Header="计划信息" Padding="5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                </Grid.RowDefinitions>
                <Label Content="工作編號*"/>
                <TextBox x:Name="txt_jobNo" Grid.Column="1" Margin="3"/>
                <Label Content="机种名称" Grid.Column="2"/>
                <TextBox x:Name="txt_model" Grid.Column="3" Margin="3"/>

                <Label Content="测试项目" Grid.Row="1"/>
                <ComboBox x:Name="cb_testItem" Grid.Row="1" Grid.Column="1" Margin="3" VerticalContentAlignment="Center"
                          ToolTip="测试项目取自字典，如需新增请到管理模块添加"/>
                <Label Content="阶段" Grid.Row="1" Grid.Column="2"/>
                <ComboBox x:Name="cb_stage" Grid.Row="1" Grid.Column="3" Margin="3" VerticalContentAlignment="Center"
                          ToolTip="阶段取自字典，如需新增请到管理模块添加"/>

                <Label Content="产品别" Grid.Row="2"/>
                <ComboBox x:Name="cb_product" Grid.Row="2" Grid.Column="1" Margin="3" VerticalContentAlignment="Center"
                          ToolTip="产品别取自字典，如需新增请到管理模块添加"/>
                <Label Content="客户别" Grid.Row="2" Grid.Column="2"/>
                <ComboBox x:Name="cb_customer" Grid.Row="2" Grid.Column="3" Margin="3" VerticalContentAlignment="Center"
                          ToolTip="客户别取自字典，如需新增请到管理模块添加"/>

                <Label Content="样品数" Grid.Row="3"/>
                <TextBox x:Name="txt_sampleSize" Grid.Row="3" Grid.Column="1" Margin="3"/>
                <Label Content="试验时间" Grid.Row="3" Grid.Column="2"/>
                <TextBox x:Name="txt_testPeriod" Grid.Row="3" Grid.Column="3" Margin="3"/>

                <Label Content="状况" Grid.Row="4"/>
                <ComboBox x:Name="cb_status" Grid.Row="4" Grid.Column="1" Margin="3" VerticalContentAlignment="Center"
                          ToolTip="状况仅可选 Ongoing / Close / Pending"/>
            </Grid>
        </GroupBox>

        <!--领用信息-->
        <GroupBox Header="领用信息" Grid.Row="1" Margin="0,5,0,0" Padding="5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition/><RowDefinition/><RowDefinition/>
                </Grid.RowDefinitions>
                <Label Content="领料单据号"/>
                <TextBox x:Name="txt_reqNo" Grid.Column="1" Margin="3"/>
                <Label Content="回线RT工令" Grid.Column="2"/>
                <TextBox x:Name="txt_returnRt" Grid.Column="3" Margin="3"/>

                <Label Content="Work Order" Grid.Row="1"/>
                <TextBox x:Name="txt_workOrder" Grid.Row="1" Grid.Column="1" Margin="3"/>
                <Label Content="领出数量" Grid.Row="1" Grid.Column="2"/>
                <TextBox x:Name="txt_outQty" Grid.Row="1" Grid.Column="3" Margin="3"/>

                <Label Content="线别" Grid.Row="2"/>
                <TextBox x:Name="txt_lineNo" Grid.Row="2" Grid.Column="1" Margin="3"/>
                <Label Content="领用日期" Grid.Row="2" Grid.Column="2"/>
                <TextBox x:Name="txt_reqDate" Grid.Row="2" Grid.Column="3" Margin="3" ToolTip="如: 1月9日"/>
            </Grid>
        </GroupBox>

        <!--序列号：自定义输入 / 上传文件 二选一-->
        <GroupBox Header="序列号 (S/N)" Grid.Row="2" Margin="0,5,0,0" Padding="5">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="rb_snInput" Content="自定义输入" IsChecked="True" Checked="SnMode_Changed" VerticalContentAlignment="Center"/>
                    <RadioButton x:Name="rb_snFile" Content="上传文件" Margin="20,0,0,0" Checked="SnMode_Changed" VerticalContentAlignment="Center"/>
                </StackPanel>
                <Grid Grid.Row="1" Margin="0,5,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="txt_sn" VerticalContentAlignment="Center"
                             ToolTip="多个SN可用/分隔" TextWrapping="WrapWithOverflow"/>
                    <Button x:Name="btn_snFile" Content="选择文件..." Grid.Column="1" Margin="5,0,0,0"
                            Padding="10,2" Click="Btn_SnFile_Click" Visibility="Collapsed"/>
                    <TextBlock x:Name="txt_snFileName" Grid.Column="0" VerticalAlignment="Center"
                               Visibility="Collapsed" TextTrimming="CharacterEllipsis" Foreground="Gray"/>
                </Grid>
            </Grid>
        </GroupBox>

        <!--其他字段-->
        <GroupBox Header="其他" Grid.Row="3" Margin="0,5,0,0" Padding="5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition/><RowDefinition/>
                </Grid.RowDefinitions>
                <Label Content="负责人"/>
                <TextBox x:Name="txt_owner" Grid.Column="1" Margin="3"/>
                <Label Content="备注" Grid.Row="1"/>
                <TextBox x:Name="txt_remark" Grid.Row="1" Grid.Column="1" Margin="3"
                         TextWrapping="WrapWithOverflow" AcceptsReturn="True" Height="50"
                         VerticalScrollBarVisibility="Auto"/>
            </Grid>
        </GroupBox>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="保存" Width="90" Height="28" Click="Btn_Save_Click" IsDefault="True"/>
            <Button Content="取消" Width="90" Height="28" Margin="10,0,0,0" Click="Btn_Cancel_Click" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
