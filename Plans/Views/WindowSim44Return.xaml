<Window x:Class="ORT一键报告.Plans.Views.WindowSim44Return"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:lex="http://wpflocalizeextension.codeplex.com"
        mc:Ignorable="d"
        Background="{DynamicResource WindowBackgroundBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
        Title="{lex:Loc Sim44_Title}" Height="780" Width="1040" MinHeight="640" MinWidth="900"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!--登录状态条-->
        <Border Grid.Row="0" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1"
                Padding="10,6" Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{lex:Loc Sim44_Status_Db}" VerticalAlignment="Center"/>
                    <TextBlock x:Name="txt_loginState" Margin="6,0,16,0" VerticalAlignment="Center"
                               FontWeight="SemiBold" Text="{lex:Loc Sim44_Status_NotLoggedIn}"/>
                    <TextBlock x:Name="txt_expiry" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="btn_selftest" Content="{lex:Loc Sim44_SelfTest}" Padding="10,3" Margin="0,0,8,0"
                            Click="Btn_SelfTest_Click"/>
                    <Button x:Name="btn_login" Content="{lex:Loc Sim44_Login}" Padding="10,3" Margin="0,0,8,0"
                            Click="Btn_Login_Click"/>
                    <Button x:Name="btn_logout" Content="{lex:Loc Sim44_Logout}" Padding="10,3"
                            Click="Btn_Logout_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!--查询条件-->
        <GroupBox Grid.Row="1" Header="{lex:Loc Sim44_QuerySection}" Padding="8" Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Label Content="{lex:Loc Sim44_Field_MoNo}" VerticalContentAlignment="Center"/>
                <TextBox x:Name="txt_q_mo" Grid.Column="1" Margin="4,3" VerticalContentAlignment="Center"
                         ToolTip="{lex:Loc Sim44_Query_MoHint}"/>

                <Label Grid.Column="2" Content="{lex:Loc Sim44_Field_PartNo}" VerticalContentAlignment="Center" Margin="8,0,0,0"/>
                <TextBox x:Name="txt_q_part" Grid.Column="3" Margin="4,3" VerticalContentAlignment="Center"/>

                <Label Grid.Column="4" Content="{lex:Loc Sim44_Field_Line}" VerticalContentAlignment="Center" Margin="8,0,0,0"/>
                <TextBox x:Name="txt_q_line" Grid.Column="5" Margin="4,3" VerticalContentAlignment="Center"/>

                <Label Grid.Row="1" Content="{lex:Loc Sim44_Field_Date}" VerticalContentAlignment="Center"/>
                <Grid Grid.Row="1" Grid.Column="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <DatePicker x:Name="dp_q_from" Margin="4,3" VerticalContentAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="~" VerticalAlignment="Center" Margin="4,0"/>
                    <DatePicker x:Name="dp_q_to" Grid.Column="2" Margin="4,3" VerticalContentAlignment="Center"/>
                </Grid>

                <StackPanel Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="4" Orientation="Horizontal"
                            HorizontalAlignment="Right" Margin="8,0,0,0">
                    <Button x:Name="btn_query" Content="{lex:Loc Common_Query}" Padding="16,3" Margin="0,0,8,0"
                            Click="Btn_Query_Click" IsDefault="True"/>
                    <Button x:Name="btn_query_clear" Content="{lex:Loc Common_Clear}" Padding="16,3"
                            Click="Btn_QueryClear_Click"/>
                </StackPanel>
            </Grid>
        </GroupBox>

        <!--结果-->
        <GroupBox Grid.Row="2" Header="{lex:Loc Sim44_ResultSection}" Padding="6" Margin="0,0,0,8">
            <DataGrid x:Name="grid_result" AutoGenerateColumns="False" IsReadOnly="True"
                      SelectionMode="Single" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                      CanUserAddRows="False" Margin="0" SelectionChanged="Grid_Result_SelectionChanged">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="{lex:Loc Sim44_Field_MoNo}" Binding="{Binding MoNo}" Width="170"/>
                    <DataGridTextColumn Header="{lex:Loc Sim44_Field_Line}" Binding="{Binding LineNo}" Width="90"/>
                    <DataGridTextColumn Header="{lex:Loc Sim44_Field_LineName}" Binding="{Binding LineName}" Width="130"/>
                    <DataGridTextColumn Header="{lex:Loc Sim44_Field_Date}" Binding="{Binding StartDate}" Width="100"/>
                    <DataGridTextColumn Header="{lex:Loc Sim44_Field_PartNo}" Binding="{Binding PartNo}" Width="150"/>
                    <DataGridTextColumn Header="{lex:Loc Sim44_Field_Qty}" Binding="{Binding MoQty}" Width="80"/>
                    <DataGridTextColumn Header="RMA_NO" Binding="{Binding RmaNo}" Width="110"/>
                    <DataGridTextColumn Header="RMA_SEQ" Binding="{Binding RmaSeq}" Width="80"/>
                    <DataGridTextColumn Header="{lex:Loc Sim44_Field_UpdatedBy}" Binding="{Binding UpdUser}" Width="90"/>
                    <DataGridTextColumn Header="{lex:Loc Sim44_Field_UpdatedAt}" Binding="{Binding UpdDate}" Width="100"/>
                </DataGrid.Columns>
            </DataGrid>
        </GroupBox>

        <!--编辑区-->
        <GroupBox Grid.Row="3" Header="{lex:Loc Sim44_EditSection}" Padding="8" Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Label Content="{lex:Loc Sim44_Field_MoNo}" VerticalContentAlignment="Center"/>
                <TextBox x:Name="txt_mo" Grid.Column="1" Margin="4,3" VerticalContentAlignment="Center"
                         ToolTip="{lex:Loc Sim44_Field_MoHint}"/>

                <Label Grid.Column="2" Content="{lex:Loc Sim44_Field_PartNo}" VerticalContentAlignment="Center" Margin="8,0,0,0"/>
                <Grid Grid.Column="3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="txt_part" Margin="4,3" VerticalContentAlignment="Center"
                             ToolTip="{lex:Loc Sim44_Field_PartHint}"/>
                    <Button Grid.Column="1" x:Name="btn_lookup_part" Content="..." Padding="8,2" Margin="0,3,0,3"
                            ToolTip="{lex:Loc Sim44_LookupPart}" Click="Btn_LookupPart_Click"/>
                </Grid>

                <Label Grid.Row="1" Content="{lex:Loc Sim44_Field_Line}" VerticalContentAlignment="Center"/>
                <Grid Grid.Row="1" Grid.Column="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="txt_line_no" Margin="4,3" VerticalContentAlignment="Center"
                             ToolTip="{lex:Loc Sim44_Field_LineNoHint}"/>
                    <Button Grid.Column="1" x:Name="btn_lookup_line" Content="..." Padding="8,2" Margin="0,3,0,3"
                            ToolTip="{lex:Loc Sim44_LookupLine}" Click="Btn_LookupLine_Click"/>
                </Grid>

                <Label Grid.Row="1" Grid.Column="2" Content="{lex:Loc Sim44_Field_LineName}" VerticalContentAlignment="Center" Margin="8,0,0,0"/>
                <TextBox x:Name="txt_line_name" Grid.Row="1" Grid.Column="3" Margin="4,3" VerticalContentAlignment="Center"/>

                <Label Grid.Row="2" Content="{lex:Loc Sim44_Field_Date}" VerticalContentAlignment="Center"/>
                <DatePicker x:Name="dp_date" Grid.Row="2" Grid.Column="1" Margin="4,3" VerticalContentAlignment="Center"/>

                <Label Grid.Row="2" Grid.Column="2" Content="{lex:Loc Sim44_Field_Qty}" VerticalContentAlignment="Center" Margin="8,0,0,0"/>
                <Grid Grid.Row="2" Grid.Column="3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="txt_qty" Margin="4,3" VerticalContentAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="RMA_NO" VerticalAlignment="Center" Margin="8,0,4,0"/>
                    <TextBox x:Name="txt_rma" Grid.Column="2" Width="110" Margin="4,3" VerticalContentAlignment="Center"
                             ToolTip="{lex:Loc Sim44_Field_RmaHint}"/>
                    <TextBlock Grid.Column="3" Text="SEQ" VerticalAlignment="Center" Margin="8,0,4,0"/>
                    <TextBox x:Name="txt_rma_seq" Grid.Column="4" Width="60" Margin="4,3" VerticalContentAlignment="Center"/>
                </Grid>
            </Grid>
        </GroupBox>

        <!--底部-->
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="txt_status" VerticalAlignment="Center" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextSecondaryBrush}"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="btn_insert" Content="{lex:Loc Sim44_Add}" Width="96" Padding="0,3" Margin="0,0,8,0"
                        Click="Btn_Insert_Click"/>
                <Button x:Name="btn_update" Content="{lex:Loc Sim44_Modify}" Width="96" Padding="0,3" Margin="0,0,8,0"
                        Click="Btn_Update_Click"/>
                <Button x:Name="btn_clear" Content="{lex:Loc Common_Clear}" Width="80" Padding="0,3" Margin="0,0,8,0"
                        Click="Btn_Clear_Click"/>
                <Button Content="{lex:Loc Common_Close}" Width="80" Padding="0,3" IsCancel="True"
                        Click="Btn_Close_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
