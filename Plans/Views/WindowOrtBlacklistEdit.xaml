<Window x:Class="ORT一键报告.Plans.Views.WindowOrtBlacklistEdit"
        Background="{DynamicResource WindowBackgroundBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:lex="http://wpflocalizeextension.codeplex.com"
        mc:Ignorable="d"
        Title="{lex:Loc PreIssue_BlacklistEditTitle}" Width="560" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="NoResize">

    <StackPanel Margin="14">
        <TextBlock Text="{lex:Loc PreIssue_BlacklistEditHint}" TextWrapping="Wrap"
                   Foreground="{DynamicResource TextSecondaryBrush}"/>

        <!-- 类型：機種（精确） / 正则 -->
        <DockPanel Margin="0,12,0,0">
            <Label Content="{lex:Loc PreIssue_BlacklistKind}" VerticalAlignment="Center"/>
            <ComboBox x:Name="cb_kind" Width="110" VerticalAlignment="Center" HorizontalAlignment="Left"
                      SelectionChanged="Input_Changed"/>
        </DockPanel>

        <DockPanel Margin="0,8,0,0">
            <Label Content="{lex:Loc PreIssue_BlacklistEntry}" VerticalAlignment="Center"/>
            <TextBox x:Name="txt_value" VerticalContentAlignment="Center" FontFamily="Consolas"
                     TextChanged="Input_Changed"/>
        </DockPanel>

        <!-- 由单个机种生成「同系列」正则 -->
        <WrapPanel Margin="0,8,0,0">
            <Button x:Name="btn_series" Content="{lex:Loc PreIssue_BlacklistToSeries}" Padding="10,3"
                    Click="Btn_Series_Click" ToolTip="{lex:Loc PreIssue_BlacklistSeriesTip}"/>
            <TextBlock x:Name="txt_series" VerticalAlignment="Center" Margin="10,0,0,0"
                       Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
        </WrapPanel>

        <DockPanel Margin="0,8,0,0">
            <Label Content="{lex:Loc PreIssue_Reason}" VerticalAlignment="Center"/>
            <TextBox x:Name="txt_reason" VerticalContentAlignment="Center"/>
        </DockPanel>

        <!-- 这条规则本月会命中哪些机种（确认前先看一眼） -->
        <Border Margin="0,10,0,0" Padding="8,6" CornerRadius="{DynamicResource CornerRadiusSmall}"
                Background="{DynamicResource StatusWarnBgBrush}">
            <TextBlock x:Name="txt_preview" TextWrapping="Wrap" Foreground="{DynamicResource StatusWarnBrush}"/>
        </Border>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="{lex:Loc Common_OK}" IsDefault="True" MinWidth="84" Padding="10,3" Click="Btn_Ok_Click"/>
            <Button Content="{lex:Loc Common_Cancel}" IsCancel="True" MinWidth="84" Padding="10,3" Margin="8,0,0,0"/>
        </StackPanel>
    </StackPanel>
</Window>
