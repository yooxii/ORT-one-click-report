<Window x:Class="ORT一键报告.Plans.Views.WindowPlanDirectEdit" Background="{DynamicResource WindowBackgroundBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:lex="http://wpflocalizeextension.codeplex.com"
        mc:Ignorable="d"
        Title="{lex:Loc PlanEdit_Title}" Height="560" Width="640" MinHeight="500" MinWidth="580"
        WindowStartupLocation="CenterOwner" SizeToContent="Height">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>

        <GroupBox Header="{lex:Loc PlanEdit_PlanInfo}" Padding="5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                </Grid.RowDefinitions>
                <Label Content="{lex:Loc PlanEdit_TestItem}"/>
                <ComboBox x:Name="cb_testItem" Grid.Column="1" Margin="3" VerticalContentAlignment="Center"
                          SelectionChanged="Cb_TestItem_SelectionChanged"/>
                <Label Content="{lex:Loc PlanEdit_StartTime}" Grid.Column="2"/>
                <DatePicker x:Name="dp_startDate" Grid.Column="3" Margin="3" VerticalContentAlignment="Center"
                            SelectedDateChanged="Dp_StartDate_Changed"/>

                <Label Content="{lex:Loc PlanEdit_StageTC}" Grid.Row="1"/>
                <ComboBox x:Name="cb_stage" Grid.Row="1" Grid.Column="1" Margin="3" VerticalContentAlignment="Center"/>
                <Label Content="{lex:Loc ReqEdit_ModelName}" Grid.Row="1" Grid.Column="2"/>
                <TextBox x:Name="txt_model" Grid.Row="1" Grid.Column="3" Margin="3" TextChanged="Txt_Model_TextChanged"/>
                
                <Label Content="{lex:Loc PlanEdit_WorkNumber}" Grid.Row="2"/>
                <TextBox x:Name="txt_jobNo" Grid.Row="2" Grid.Column="1" Margin="3" IsReadOnly="True"
                         ToolTip="{lex:Loc PlanEdit_WorkNumberHint}"/>
                <Label Content="{lex:Loc PlanEdit_SampleQty}" Grid.Row="2" Grid.Column="2"/>
                <TextBox x:Name="txt_sampleSize" Grid.Row="2" Grid.Column="3" Margin="3"/>
                
                <Label Content="{lex:Loc Plans_ProductType}" Grid.Row="3"/>
                <TextBox x:Name="txt_product" Grid.Row="3" Grid.Column="1" Margin="3" ToolTip="{lex:Loc ReqEdit_ModelNameHint}"/>
                <Label Content="{lex:Loc PlanEdit_Customer}" Grid.Row="3" Grid.Column="2"/>
                <TextBox x:Name="txt_customer" Grid.Row="3" Grid.Column="3" Margin="3" ToolTip="{lex:Loc ReqEdit_ModelNameHint}"/>
            </Grid>
        </GroupBox>

        <GroupBox Header="{lex:Loc PlanEdit_Other}" Grid.Row="1" Margin="0,5,0,0" Padding="5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                </Grid.RowDefinitions>
                <Label Content="{lex:Loc Plans_Owner}"/>
                <TextBox x:Name="txt_owner" Grid.Column="1" Margin="3" ToolTip="{lex:Loc PlanEdit_TestItemHint}"/>
                <Label Content="{lex:Loc Admin_TestTime}" Grid.Row="1"/>
                <TextBox x:Name="txt_testPeriod" Grid.Row="1" Grid.Column="1" Margin="3" ToolTip="{lex:Loc PlanEdit_TestItemHint}"/>
                <Label Content="{lex:Loc PlanEdit_EndDate}" Grid.Row="2"/>
                <DatePicker x:Name="dp_endDate" Grid.Row="2" Grid.Column="1" Margin="3" ToolTip="{lex:Loc PlanEdit_EndDateHint}"/>
                <Label Content="{lex:Loc PlanEdit_Remark}" Grid.Row="3"/>
                <TextBox x:Name="txt_remark" Grid.Row="3" Grid.Column="1" Margin="3"
                         TextWrapping="WrapWithOverflow" AcceptsReturn="True" Height="50" VerticalScrollBarVisibility="Auto"/>
            </Grid>
        </GroupBox>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="{lex:Loc Common_Save}" Width="90" Height="28" Click="Btn_Save_Click" IsDefault="True"/>
            <Button Content="{lex:Loc Common_Cancel}" Width="90" Height="28" Margin="10,0,0,0" Click="Btn_Cancel_Click" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
