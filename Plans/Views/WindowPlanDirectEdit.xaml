<Window x:Class="ORT一键报告.Plans.Views.WindowPlanDirectEdit"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="计划表新增/编辑（非领用）" Height="560" Width="640" MinHeight="500" MinWidth="580"
        WindowStartupLocation="CenterOwner" SizeToContent="Height">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>

        <GroupBox Header="计划信息 *" Padding="5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                </Grid.RowDefinitions>
                <Label Content="测试项目*"/>
                <ComboBox x:Name="cb_testItem" Grid.Column="1" Margin="3" VerticalContentAlignment="Center"
                          SelectionChanged="Cb_TestItem_SelectionChanged"/>
                <Label Content="开始时间*" Grid.Column="2"/>
                <DatePicker x:Name="dp_startDate" Grid.Column="3" Margin="3" VerticalContentAlignment="Center"
                            SelectedDateChanged="Dp_StartDate_Changed"/>

                <Label Content="阶段*" Grid.Row="1"/>
                <ComboBox x:Name="cb_stage" Grid.Row="1" Grid.Column="1" Margin="3" VerticalContentAlignment="Center"/>
                <Label Content="機種名稱*" Grid.Row="1" Grid.Column="2"/>
                <TextBox x:Name="txt_model" Grid.Row="1" Grid.Column="3" Margin="3"/>

                <Label Content="工作编号" Grid.Row="2"/>
                <TextBox x:Name="txt_jobNo" Grid.Row="2" Grid.Column="1" Margin="3" IsReadOnly="True"
                         ToolTip="自动生成 QRT{当前年月}{编号}（非领用计划）"/>
                <Label Content="样品数" Grid.Row="2" Grid.Column="2"/>
                <TextBox x:Name="txt_sampleSize" Grid.Row="2" Grid.Column="3" Margin="3"/>

                <Label Content="产品别" Grid.Row="3"/>
                <TextBox x:Name="txt_product" Grid.Row="3" Grid.Column="1" Margin="3" IsReadOnly="True" ToolTip="根据机种名自动查询"/>
                <Label Content="客户别" Grid.Row="3" Grid.Column="2"/>
                <TextBox x:Name="txt_customer" Grid.Row="3" Grid.Column="3" Margin="3" IsReadOnly="True" ToolTip="根据机种名自动查询"/>
            </Grid>
        </GroupBox>

        <GroupBox Header="其他" Grid.Row="1" Margin="0,5,0,0" Padding="5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                </Grid.RowDefinitions>
                <Label Content="负责人"/>
                <TextBox x:Name="txt_owner" Grid.Column="1" Margin="3" IsReadOnly="True" ToolTip="根据测试项目自动查询"/>
                <Label Content="试验时间" Grid.Row="1"/>
                <TextBox x:Name="txt_testPeriod" Grid.Row="1" Grid.Column="1" Margin="3" IsReadOnly="True" ToolTip="根据测试项目自动查询"/>
                <Label Content="结束日期" Grid.Row="2"/>
                <DatePicker x:Name="dp_endDate" Grid.Row="2" Grid.Column="1" Margin="3" IsEnabled="False" ToolTip="根据试验时间自动计算"/>
                <Label Content="备注*" Grid.Row="3"/>
                <TextBox x:Name="txt_remark" Grid.Row="3" Grid.Column="1" Margin="3"
                         TextWrapping="WrapWithOverflow" AcceptsReturn="True" Height="50" VerticalScrollBarVisibility="Auto"/>
            </Grid>
        </GroupBox>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="保存" Width="90" Height="28" Click="Btn_Save_Click" IsDefault="True"/>
            <Button Content="取消" Width="90" Height="28" Margin="10,0,0,0" Click="Btn_Cancel_Click" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
