<Window x:Class="ORT一键报告.Plans.Views.WindowPlans"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ORT一键报告.Plans.Views"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        mc:Ignorable="d"
        Title="领退和计划" Height="700" Width="1300" MinHeight="450" MinWidth="900"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <!-- 文本列浏览样式：文字水平垂直居中，无内边距与边框 -->
        <Style x:Key="CenterText" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
        </Style>
        <!-- 文本列编辑样式：无边框铺满单元格，内容居中 -->
        <Style x:Key="CenterEdit" TargetType="TextBox">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <!-- 单元格通用样式：无内边距、内容居中；选中单元格浅灰（与选中行背景叠加显示），黑字不变 -->
        <Style x:Key="FullCell" TargetType="DataGridCell">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="Black"/>
            <Style.Triggers>
                <!-- 选中单元格：浅灰色（行选中与单元格选中可同时显示） -->
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#FFE0E0E0"/>
                    <Setter Property="Foreground" Value="Black"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="5">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>

        <!--工具栏-->
        <ToolBarTray>
            <ToolBar Band="0" BandIndex="0">
                <Button Content="领退新增" Command="{Binding AddRequisitionCommand}" ToolTip="新增领退记录并同步新增计划"/>
                <Button Content="计划新增" Command="{Binding AddPlanCommand}" ToolTip="直接新增非领用计划（QRT前缀）"/>
                <Button Content="编辑" Command="{Binding EditRequisitionCommand}" ToolTip="编辑选中记录"/>
                <Separator/>
                <Button Content="提交保存" Command="{Binding SaveChangesCommand}" FontWeight="Bold"
                        ToolTip="将暂存的修改写入数据库并记录变更日志"/>
                <Button Content="丢弃修改" Command="{Binding DiscardChangesCommand}"
                        ToolTip="放弃所有暂存修改，还原为数据库状态"/>
                <Separator/>
                <Button Content="导出领退表" Command="{Binding ExportRequisitionCommand}" ToolTip="导出为成品領退管理表格式"/>
                <Button Content="导出计划表" Command="{Binding ExportScheduleCommand}" ToolTip="导出为 ORT Test Schedule 格式"/>
                <Separator/>
                <Button Content="回线转移单" Click="Btn_ReturnLine_Click" ToolTip="打开回线转移单工具"/>
                <Separator/>
                <Button Content="刷新" Command="{Binding RefreshCommand}" ToolTip="重新加载数据（会丢弃未提交修改）"/>
            </ToolBar>
        </ToolBarTray>

        <!--筛选区（可折叠）-->
        <Expander Grid.Row="1" Header="筛选" IsExpanded="True" Margin="0,5,0,0">
            <StackPanel Margin="5">
                <WrapPanel>
                    <Label Content="领退搜索" VerticalContentAlignment="Center"/>
                    <TextBox Width="180" Margin="0,0,15,3" VerticalContentAlignment="Center"
                             Text="{Binding ReqKeyword, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="按机种/单据号/工令/SN等筛选领退表"/>
                    <Label Content="计划搜索" VerticalContentAlignment="Center"/>
                    <TextBox Width="180" Margin="0,0,15,3" VerticalContentAlignment="Center"
                             Text="{Binding Keyword, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="按机种/工作编号/测试项目等筛选计划表"/>
                    <ComboBox Width="140" Margin="0,0,10,3" VerticalContentAlignment="Center"
                              ItemsSource="{Binding AvailableFields}"
                              SelectedItem="{Binding AddFilterField, Mode=TwoWay}"
                              ToolTip="选择字段以添加计划表筛选条件"/>
                    <ItemsControl ItemsSource="{Binding ActiveFilters}" VerticalAlignment="Center">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="#FFBBBBBB" BorderThickness="1" CornerRadius="3"
                                        Margin="0,0,8,3" Padding="5,2" Background="#FFF8F8F8">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Field}" VerticalAlignment="Center"
                                                   FontWeight="Bold" Margin="0,0,5,0"/>
                                        <local:FilterDropDown
                                            Options="{Binding Options}"
                                            SelectedValues="{Binding SelectedValues}"
                                            Visibility="{Binding IsValueField, Converter={StaticResource BoolToVis}}"/>
                                        <StackPanel Orientation="Horizontal"
                                                    Visibility="{Binding IsDateField, Converter={StaticResource BoolToVis}}">
                                            <DatePicker Width="112" SelectedDate="{Binding DateFrom, Mode=TwoWay}" ToolTip="起始日期"/>
                                            <TextBlock Text="~" VerticalAlignment="Center" Margin="3,0"/>
                                            <DatePicker Width="112" SelectedDate="{Binding DateTo, Mode=TwoWay}" ToolTip="截止日期"/>
                                        </StackPanel>
                                        <Button Content="✕" Margin="5,0,0,0" Padding="3,0" BorderThickness="0"
                                                Background="Transparent" Foreground="Gray" ToolTip="删除该筛选条件"
                                                Command="{Binding DataContext.RemoveFilterCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </WrapPanel>
            </StackPanel>
        </Expander>

        <!--两 Tab：领退表 / 计划表-->
        <TabControl Grid.Row="2" Margin="0,5,0,0">
            <!--领退表-->
            <TabItem Header="领退表">
                <DataGrid x:Name="dg_requisitions"
                          ItemsSource="{Binding RequisitionsView}"
                          SelectedItem="{Binding SelectedRequisition, Mode=TwoWay}"
                          AutoGenerateColumns="False"
                          IsReadOnly="{Binding DataContext.IsGridReadOnly, RelativeSource={RelativeSource AncestorType=Window}}"
                          CanUserSortColumns="True" CanUserReorderColumns="True" CanUserAddRows="False"
                          HeadersVisibility="All" GridLinesVisibility="All"
                          SelectionMode="Extended" SelectionUnit="CellOrRowHeader"
                          ClipboardCopyMode="None"
                          LoadingRow="Dg_Requisitions_LoadingRow"
                          CellEditEnding="Dg_Requisitions_CellEditEnding"
                          CurrentCellChanged="Dg_Requisitions_CurrentCellChanged"
                          PreviewMouseRightButtonDown="Dg_Requisitions_PreviewMouseRightButtonDown"
                          VirtualizingPanel.IsVirtualizing="True">
                    <DataGrid.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="编辑(对话框)" Click="Menu_EditRequisition_Click"/>
                            <MenuItem Header="标记删除" Click="Menu_DeleteRequisition_Click"/>
                            <Separator/>
                            <MenuItem Header="复制行" Click="Menu_CopyReqRow_Click"/>
                            <MenuItem Header="复制单元格" Click="Menu_CopyReqCell_Click"/>
                            <MenuItem Header="粘贴" Click="Menu_PasteReq_Click"/>
                            <Separator/>
                            <MenuItem Header="显示/隐藏列" x:Name="menu_req_columns" SubmenuOpened="Menu_ReqColumns_SubmenuOpened"/>
                        </ContextMenu>
                    </DataGrid.ContextMenu>
                    <DataGrid.CellStyle>
                        <StaticResource ResourceKey="FullCell"/>
                    </DataGrid.CellStyle>
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Setter Property="Background" Value="White"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Id}" Value="0">
                                    <Setter Property="Background" Value="#FFFFF8E1"/>
                                </DataTrigger>
                                <!-- 选中行：很浅的灰色 -->
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#FFF2F2F2"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="領用日期" Width="90" SortMemberPath="RequisitionDate">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding RequisitionDate, StringFormat={}{0:yyyy/M/d}}" Style="{StaticResource CenterText}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                            <DataGridTemplateColumn.CellEditingTemplate>
                                <DataTemplate>
                                    <DatePicker SelectedDate="{Binding RequisitionDate, UpdateSourceTrigger=PropertyChanged}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellEditingTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="領料單据號" Binding="{Binding RequisitionNo, UpdateSourceTrigger=PropertyChanged}" Width="110" ElementStyle="{StaticResource CenterText}" EditingElementStyle="{StaticResource CenterEdit}"/>
                        <DataGridTextColumn Header="機種名稱" Binding="{Binding ModelName, UpdateSourceTrigger=PropertyChanged}" Width="130" ElementStyle="{StaticResource CenterText}" EditingElementStyle="{StaticResource CenterEdit}"/>
                        <DataGridTextColumn Header="領出數量" Binding="{Binding OutQty, UpdateSourceTrigger=PropertyChanged}" Width="70" ElementStyle="{StaticResource CenterText}" EditingElementStyle="{StaticResource CenterEdit}"/>
                        <DataGridTemplateColumn Header="S/N" Width="170" SortMemberPath="SN">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <TextBlock x:Name="txtSn" Text="{Binding SN}" VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" Visibility="Collapsed"/>
                                        <TextBlock x:Name="linkSn" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                   ToolTip="点击打开SN文件">
                                            <Hyperlink Command="{Binding DataContext.OpenSnFileCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                       CommandParameter="{Binding}">
                                                <Run Text="{Binding SnFilePath, Mode=OneWay}"/>
                                            </Hyperlink>
                                        </TextBlock>
                                    </Grid>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding SnFilePath}" Value="{x:Null}">
                                            <Setter TargetName="linkSn" Property="Visibility" Value="Collapsed"/>
                                            <Setter TargetName="txtSn" Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="D/C" Binding="{Binding DC, UpdateSourceTrigger=PropertyChanged}" Width="50" ElementStyle="{StaticResource CenterText}" EditingElementStyle="{StaticResource CenterEdit}"/>
                        <DataGridTextColumn Header="REV" Binding="{Binding Rev, UpdateSourceTrigger=PropertyChanged}" Width="50" ElementStyle="{StaticResource CenterText}" EditingElementStyle="{StaticResource CenterEdit}"/>
                        <DataGridTextColumn Header="Work Order" Binding="{Binding WorkOrder, UpdateSourceTrigger=PropertyChanged}" Width="150" ElementStyle="{StaticResource CenterText}" EditingElementStyle="{StaticResource CenterEdit}"/>
                        <DataGridTextColumn Header="回线RT工令" Binding="{Binding ReturnRtOrder, UpdateSourceTrigger=PropertyChanged}" Width="100" ElementStyle="{StaticResource CenterText}" EditingElementStyle="{StaticResource CenterEdit}"/>
                        <DataGridTextColumn Header="回线数量" Binding="{Binding ReturnQty, UpdateSourceTrigger=PropertyChanged}" Width="65" ElementStyle="{StaticResource CenterText}" EditingElementStyle="{StaticResource CenterEdit}"/>
                        <DataGridTextColumn Header="线别" Binding="{Binding LineNo, UpdateSourceTrigger=PropertyChanged}" Width="50" ElementStyle="{StaticResource CenterText}" EditingElementStyle="{StaticResource CenterEdit}"/>
                        <DataGridTemplateColumn Header="回线日期" Width="90" SortMemberPath="ReturnDate">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding ReturnDate, StringFormat={}{0:yyyy/M/d}}" Style="{StaticResource CenterText}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                            <DataGridTemplateColumn.CellEditingTemplate>
                                <DataTemplate>
                                    <DatePicker SelectedDate="{Binding ReturnDate, UpdateSourceTrigger=PropertyChanged}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellEditingTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="入库单号" Binding="{Binding StockInNo, UpdateSourceTrigger=PropertyChanged}" Width="110" ElementStyle="{StaticResource CenterText}" EditingElementStyle="{StaticResource CenterEdit}"/>
                        <DataGridTextColumn Header="入库数量" Binding="{Binding StockInQty, UpdateSourceTrigger=PropertyChanged}" Width="65" ElementStyle="{StaticResource CenterText}" EditingElementStyle="{StaticResource CenterEdit}"/>
                        <DataGridTemplateColumn Header="入库日期" Width="90" SortMemberPath="StockInDate">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding StockInDate, StringFormat={}{0:yyyy/M/d}}" Style="{StaticResource CenterText}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                            <DataGridTemplateColumn.CellEditingTemplate>
                                <DataTemplate>
                                    <DatePicker SelectedDate="{Binding StockInDate, UpdateSourceTrigger=PropertyChanged}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellEditingTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="备注" Binding="{Binding Remark, UpdateSourceTrigger=PropertyChanged}" Width="140" ElementStyle="{StaticResource CenterText}" EditingElementStyle="{StaticResource CenterEdit}"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <!--计划表-->
            <TabItem Header="计划表">
                <DataGrid x:Name="dg_plans"
                          ItemsSource="{Binding PlansView}"
                          SelectedItem="{Binding SelectedPlan, Mode=TwoWay}"
                          AutoGenerateColumns="False"
                          IsReadOnly="{Binding DataContext.IsGridReadOnly, RelativeSource={RelativeSource AncestorType=Window}}"
                          CanUserSortColumns="True" CanUserReorderColumns="True" CanUserAddRows="False"
                          HeadersVisibility="All" GridLinesVisibility="All"
                          SelectionMode="Extended" SelectionUnit="CellOrRowHeader"
                          ClipboardCopyMode="None"
                          LoadingRow="Dg_Plans_LoadingRow"
                          CellEditEnding="Dg_Plans_CellEditEnding"
                          CurrentCellChanged="Dg_Plans_CurrentCellChanged"
                          PreviewMouseRightButtonDown="Dg_Plans_PreviewMouseRightButtonDown"
                          VirtualizingPanel.IsVirtualizing="True">
                    <DataGrid.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="编辑(对话框)" Click="Menu_EditPlan_Click"/>
                            <MenuItem Header="标记删除" Click="Menu_DeletePlan_Click"/>
                            <Separator/>
                            <MenuItem Header="打开报告文件夹" Click="Menu_OpenReportFolder_Click" ToolTip="打开该工作编号对应报告夹中的 Report 子文件夹"/>
                            <MenuItem Header="打开报告概览" Click="Menu_OpenReportOverview_Click" ToolTip="打开该工作编号对应报告夹中的 Excel 概览文件"/>
                            <MenuItem Header="打开一键报告" Click="Menu_OpenMainReport_Click" ToolTip="打开一键报告并将选中计划与对应领退数据填入相应位置"/>
                            <Separator/>
                            <MenuItem Header="复制行" Click="Menu_CopyPlanRow_Click"/>
                            <MenuItem Header="复制单元格" Click="Menu_CopyPlanCell_Click"/>
                            <MenuItem Header="粘贴" Click="Menu_PastePlan_Click"/>
                            <Separator/>
                            <MenuItem Header="显示/隐藏列" x:Name="menu_plan_columns" SubmenuOpened="Menu_PlanColumns_SubmenuOpened"/>
                        </ContextMenu>
                    </DataGrid.ContextMenu>
                    <DataGrid.CellStyle>
                        <StaticResource ResourceKey="FullCell"/>
                    </DataGrid.CellStyle>
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Setter Property="Background" Value="White"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Id}" Value="0">
                                    <Setter Property="Background" Value="#FFFFF8E1"/>
                                </DataTrigger>
                                <!-- 选中行：很浅的灰色 -->
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#FFF2F2F2"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="工作編號" Width="90" SortMemberPath="JobNo">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding JobNo}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource CenterText}">
                                                <Setter Property="Foreground" Value="Black"/>
                                                <Style.Triggers>
                                                    <!-- 无对应报告文件夹/概览：灰色区分（明显但不突兀，白/浅灰背景上均清晰） -->
                                                    <DataTrigger Binding="{Binding HasReportLink}" Value="False">
                                                        <Setter Property="Foreground" Value="#FF808080"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                            <DataGridTemplateColumn.CellEditingTemplate>
                                <DataTemplate>
                                    <TextBox Text="{Binding JobNo, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource CenterEdit}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellEditingTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="产品别" Width="80" SortMemberPath="Product">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ComboBox ItemsSource="{Binding DataContext.CatalogProducts, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                              SelectedValue="{Binding Product, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                              VerticalContentAlignment="Center" BorderThickness="0"
                                              ToolTip="产品别取自字典，如需新增请到管理模块添加"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="客户别" Width="95" SortMemberPath="Customer">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ComboBox ItemsSource="{Binding DataContext.CatalogCustomers, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                              SelectedValue="{Binding Customer, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                              VerticalContentAlignment="Center" BorderThickness="0"
                                              ToolTip="客户别取自字典，如需新增请到管理模块添加"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="机种名称" Binding="{Binding ModelName, UpdateSourceTrigger=PropertyChanged}" Width="130" ElementStyle="{StaticResource CenterText}" EditingElementStyle="{StaticResource CenterEdit}"/>
                        <DataGridTemplateColumn Header="阶段" Width="65" SortMemberPath="Stage">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ComboBox ItemsSource="{Binding DataContext.CatalogStages, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                              SelectedValue="{Binding Stage, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                              VerticalContentAlignment="Center" BorderThickness="0"
                                              ToolTip="阶段取自字典，如需新增请到管理模块添加"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="测试项目" Width="150" SortMemberPath="TestItem">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ComboBox ItemsSource="{Binding DataContext.CatalogTestItems, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                              SelectedValue="{Binding TestItem, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                              IsEditable="False" VerticalContentAlignment="Center" BorderThickness="0"
                                              ToolTip="测试项目取自字典，如需新增请到管理模块添加"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="样品数" Binding="{Binding SampleSize, UpdateSourceTrigger=PropertyChanged}" Width="55" ElementStyle="{StaticResource CenterText}" EditingElementStyle="{StaticResource CenterEdit}"/>
                        <DataGridTextColumn Header="试验时间" Binding="{Binding TestPeriod, UpdateSourceTrigger=PropertyChanged}" Width="65" ElementStyle="{StaticResource CenterText}" EditingElementStyle="{StaticResource CenterEdit}"/>
                        <DataGridTextColumn Header="负责人" Binding="{Binding Owner, UpdateSourceTrigger=PropertyChanged}" Width="80" ElementStyle="{StaticResource CenterText}" EditingElementStyle="{StaticResource CenterEdit}"/>
                        <DataGridTemplateColumn Header="开始日期" Width="90" SortMemberPath="StartDate">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding StartDate, StringFormat={}{0:yyyy/M/d}}" Style="{StaticResource CenterText}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                            <DataGridTemplateColumn.CellEditingTemplate>
                                <DataTemplate>
                                    <DatePicker SelectedDate="{Binding StartDate, UpdateSourceTrigger=PropertyChanged}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellEditingTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="结束日期" Width="90" SortMemberPath="EndDate">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding EndDate, StringFormat={}{0:yyyy/M/d}}" Style="{StaticResource CenterText}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                            <DataGridTemplateColumn.CellEditingTemplate>
                                <DataTemplate>
                                    <DatePicker SelectedDate="{Binding EndDate, UpdateSourceTrigger=PropertyChanged}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellEditingTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="状况" Width="75" SortMemberPath="Status">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ComboBox ItemsSource="{Binding DataContext.CatalogStatuses, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                              SelectedValue="{Binding Status, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                              VerticalContentAlignment="Center" BorderThickness="0"
                                              ToolTip="状况仅可选 Ongoing / Close / Pending"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="备注" Binding="{Binding Remark, UpdateSourceTrigger=PropertyChanged}" Width="150" ElementStyle="{StaticResource CenterText}" EditingElementStyle="{StaticResource CenterEdit}"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
        </TabControl>

        <StatusBar Grid.Row="3">
            <StatusBarItem Content="{Binding StatusMessage}"/>
            <Separator/>
            <StatusBarItem>
                <TextBlock Text="{Binding PendingText}" Foreground="#FFB26A00" FontWeight="Bold"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
