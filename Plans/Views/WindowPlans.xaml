<Window x:Class="ORT一键报告.Plans.Views.WindowPlans" Background="{DynamicResource WindowBackgroundBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:lex="http://wpflocalizeextension.codeplex.com"
        xmlns:local="clr-namespace:ORT一键报告.Plans.Views"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        mc:Ignorable="d"
        Title="{lex:Loc Plans_Title}" Height="700" Width="1300" MinHeight="450" MinWidth="900"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <!-- 文本列浏览样式：文字水平垂直居中，无内边距与边框 -->
        <Style x:Key="CenterText" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
        </Style>
        <!-- 文本列编辑样式：无边框铺满单元格，内容居中 -->
        <Style x:Key="CenterEdit" TargetType="TextBox">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <!-- 单元格通用样式：无内边距、内容居中；选中单元格浅灰（与选中行背景叠加显示），黑字不变 -->
        <Style x:Key="FullCell" TargetType="DataGridCell">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Style.Triggers>
                <!-- 选中单元格：浅灰色（行选中与单元格选中可同时显示） -->
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource TableCellSelectedBrush}"/>
                    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="5">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>

        <!--工具栏-->
        <ToolBarTray>
            <ToolBar Band="0" BandIndex="0">
                <Button Content="{lex:Loc Plans_AddRequisition}" Command="{Binding AddRequisitionCommand}" ToolTip="{lex:Loc Plans_AddRequisitionWithPlan}"/>
                <Button Content="{lex:Loc Plans_AddPlan}" Command="{Binding AddPlanCommand}" ToolTip="{lex:Loc Plans_AddPlanDirect}"/>
                <Button Content="{lex:Loc Common_Edit}" Command="{Binding EditRequisitionCommand}" ToolTip="{lex:Loc Plans_EditSelected}"/>
                <Separator/>
                <Button Content="{lex:Loc Plans_SubmitSave}" Command="{Binding SaveChangesCommand}" FontWeight="Bold"
                        ToolTip="{lex:Loc Plans_ToolTip_SubmitSave}"/>
                <Button Content="{lex:Loc Plans_Discard}" Command="{Binding DiscardChangesCommand}"
                        ToolTip="{lex:Loc Plans_ToolTip_Discard}"/>
                <Separator/>
                <Button Content="{lex:Loc Plans_ExportRequisition}" Command="{Binding ExportRequisitionCommand}" ToolTip="{lex:Loc Plans_ToolTip_ExportReq}"/>
                <Button Content="{lex:Loc Plans_ExportPlan}" Command="{Binding ExportScheduleCommand}" ToolTip="{lex:Loc Plans_ToolTip_ExportPlan}"/>
                <Separator/>
                <Button Content="{lex:Loc Plans_ReturnTransfer}" Click="Btn_ReturnLine_Click" ToolTip="{lex:Loc Plans_ToolTip_ReturnTransfer}"/>
                <Separator/>
                <Button Content="{lex:Loc Common_Refresh}" Command="{Binding RefreshCommand}" ToolTip="{lex:Loc Plans_ToolTip_Reload}"/>
            </ToolBar>
        </ToolBarTray>

        <!--筛选区（可折叠）-->
        <Expander Grid.Row="1" Header="{lex:Loc Common_Filter}" IsExpanded="True" Margin="0,5,0,0">
            <StackPanel Margin="5">
                <WrapPanel>
                    <Label Content="{lex:Loc Plans_RequisitionSearch}" VerticalContentAlignment="Center"/>
                    <TextBox Width="180" Margin="0,0,15,3" VerticalContentAlignment="Center"
                             Text="{Binding ReqKeyword, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="{lex:Loc Plans_FilterRequisition}"/>
                    <Label Content="{lex:Loc Plans_PlanSearch}" VerticalContentAlignment="Center"/>
                    <TextBox Width="180" Margin="0,0,15,3" VerticalContentAlignment="Center"
                             Text="{Binding Keyword, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="{lex:Loc Plans_FilterPlan}"/>
                    <ComboBox Width="140" Margin="0,0,10,3" VerticalContentAlignment="Center"
                              ItemsSource="{Binding AvailableFields}"
                              SelectedItem="{Binding AddFilterField, Mode=TwoWay}"
                              ToolTip="{lex:Loc Plans_SelectFieldForFilter}"/>
                    <ItemsControl ItemsSource="{Binding ActiveFilters}" VerticalAlignment="Center">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="3"
                                        Margin="0,0,8,3" Padding="5,2" Background="{DynamicResource HeaderBackgroundBrush}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Field}" VerticalAlignment="Center"
                                                   FontWeight="Bold" Margin="0,0,5,0"/>
                                        <local:FilterDropDown
                                            Options="{Binding Options}"
                                            SelectedValues="{Binding SelectedValues}"
                                            Visibility="{Binding IsValueField, Converter={StaticResource BoolToVis}}"/>
                                        <StackPanel Orientation="Horizontal"
                                                    Visibility="{Binding IsDateField, Converter={StaticResource BoolToVis}}">
                                            <DatePicker Width="112" SelectedDate="{Binding DateFrom, Mode=TwoWay}" ToolTip="{lex:Loc Plans_FromDate}"/>
                                            <TextBlock Text="~" VerticalAlignment="Center" Margin="3,0"/>
                                            <DatePicker Width="112" SelectedDate="{Binding DateTo, Mode=TwoWay}" ToolTip="{lex:Loc Plans_EndDate}"/>
                                        </StackPanel>
                                        <Button Content="✕" Margin="5,0,0,0" Padding="3,0" BorderThickness="0"
                                                Background="Transparent" Foreground="{DynamicResource TextSecondaryBrush}" ToolTip="{lex:Loc Plans_DeleteFilter}"
                                                Command="{Binding DataContext.RemoveFilterCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </WrapPanel>
            </StackPanel>
        </Expander>

        <!--两 Tab：领退表 / 计划表-->
        <TabControl Grid.Row="2" Margin="0,5,0,0">
            <!--领退表-->
            <TabItem Header="{lex:Loc Plans_RequisitionTab}">
                <DataGrid x:Name="dg_requisitions"
                          ItemsSource="{Binding RequisitionsView}"
                          SelectedItem="{Binding SelectedRequisition, Mode=TwoWay}"
                          AutoGenerateColumns="False"
                          IsReadOnly="{Binding DataContext.IsGridReadOnly, RelativeSource={RelativeSource AncestorType=Window}}"
                          CanUserSortColumns="True" CanUserReorderColumns="True" CanUserAddRows="False"
                          HeadersVisibility="All" GridLinesVisibility="All"
                          SelectionMode="Extended" SelectionUnit="CellOrRowHeader"
                          ClipboardCopyMode="None"
                          LoadingRow="Dg_Requisitions_LoadingRow"
                          CellEditEnding="Dg_Requisitions_CellEditEnding"
                          CurrentCellChanged="Dg_Requisitions_CurrentCellChanged"
                          PreviewMouseRightButtonDown="Dg_Requisitions_PreviewMouseRightButtonDown"
                          VirtualizingPanel.IsVirtualizing="True">
                    <DataGrid.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="{lex:Loc Plans_EditDialog}" Click="Menu_EditRequisition_Click"/>
                            <MenuItem Header="{lex:Loc Plans_MarkDelete}" Click="Menu_DeleteRequisition_Click"/>
                            <Separator/>
                            <MenuItem Header="{lex:Loc Common_CopyRow}" Click="Menu_CopyReqRow_Click"/>
                            <MenuItem Header="{lex:Loc Common_CopyCell}" Click="Menu_CopyReqCell_Click"/>
                            <MenuItem Header="{lex:Loc Common_Paste}" Click="Menu_PasteReq_Click"/>
                            <Separator/>
                            <MenuItem Header="{lex:Loc Plans_ShowHideColumns}" x:Name="menu_req_columns" SubmenuOpened="Menu_ReqColumns_SubmenuOpened"/>
                        </ContextMenu>
                    </DataGrid.ContextMenu>
                    <DataGrid.CellStyle>
                        <StaticResource ResourceKey="FullCell"/>
                    </DataGrid.CellStyle>
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Id}" Value="0">
                                    <Setter Property="Background" Value="{DynamicResource StatusWarnBgBrush}"/>
                                </DataTrigger>
                                <!-- 选中行：很浅的灰色 -->
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource TableRowSelectedBrush}"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="{lex:Loc Plans_RequisitionDateTC}" Width="90" SortMemberPath="RequisitionDate">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding RequisitionDate, StringFormat={}{0:yyyy/M/d}}" Style="{StaticResource CenterText}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                            <DataGridTemplateColumn.CellEditingTemplate>
                                <DataTemplate>
                                    <DatePicker SelectedDate="{Binding RequisitionDate, UpdateSourceTrigger=PropertyChanged}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellEditingTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="{lex:Loc Plans_RequisitionDocNo}" Binding="{Binding RequisitionNo, UpdateSourceTrigger=PropertyChanged}" Width="110" ElementStyle="{StaticResource CenterText}" EditingElementStyle="{StaticResource CenterEdit}"/>
                        <DataGridTextColumn Header="{lex:Loc Plans_ModelNameTC}" Binding="{Binding ModelName, UpdateSourceTrigger=PropertyChanged}" Width="130" ElementStyle="{StaticResource CenterText}" EditingElementStyle="{StaticResource CenterEdit}"/>
                        <DataGridTextColumn Header="{lex:Loc Plans_IssueQty}" Binding="{Binding OutQty, UpdateSourceTrigger=PropertyChanged}" Width="70" ElementStyle="{StaticResource CenterText}" EditingElementStyle="{StaticResource CenterEdit}"/>
                        <DataGridTemplateColumn Header="S/N" Width="170" SortMemberPath="SN">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <TextBlock x:Name="txtSn" Text="{Binding SN}" VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" Visibility="Collapsed"/>
                                        <TextBlock x:Name="linkSn" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                   ToolTip="{lex:Loc Plans_ClickOpenSN}">
                                            <Hyperlink Command="{Binding DataContext.OpenSnFileCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                       CommandParameter="{Binding}">
                                                <Run Text="{Binding SnFilePath, Mode=OneWay}"/>
                                            </Hyperlink>
                                        </TextBlock>
                                    </Grid>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding SnFilePath}" Value="{x:Null}">
                                            <Setter TargetName="linkSn" Property="Visibility" Value="Collapsed"/>
                                            <Setter TargetName="txtSn" Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="D/C" Binding="{Binding DC, UpdateSourceTrigger=PropertyChanged}" Width="50" ElementStyle="{StaticResource CenterText}" EditingElementStyle="{StaticResource CenterEdit}"/>
                        <DataGridTextColumn Header="REV" Binding="{Binding Rev, UpdateSourceTrigger=PropertyChanged}" Width="50" ElementStyle="{StaticResource CenterText}" EditingElementStyle="{StaticResource CenterEdit}"/>
                        <DataGridTextColumn Header="Work Order" Binding="{Binding WorkOrder, UpdateSourceTrigger=PropertyChanged}" Width="150" ElementStyle="{StaticResource CenterText}" EditingElementStyle="{StaticResource CenterEdit}"/>
                        <DataGridTextColumn Header="{lex:Loc Plans_ReturnRTOrder}" Binding="{Binding ReturnRtOrder, UpdateSourceTrigger=PropertyChanged}" Width="100" ElementStyle="{StaticResource CenterText}" EditingElementStyle="{StaticResource CenterEdit}"/>
                        <DataGridTextColumn Header="{lex:Loc Plans_ReturnQty}" Binding="{Binding ReturnQty, UpdateSourceTrigger=PropertyChanged}" Width="65" ElementStyle="{StaticResource CenterText}" EditingElementStyle="{StaticResource CenterEdit}"/>
                        <DataGridTextColumn Header="{lex:Loc Plans_Line}" Binding="{Binding LineNo, UpdateSourceTrigger=PropertyChanged}" Width="50" ElementStyle="{StaticResource CenterText}" EditingElementStyle="{StaticResource CenterEdit}"/>
                        <DataGridTemplateColumn Header="{lex:Loc Plans_ReturnDate}" Width="90" SortMemberPath="ReturnDate">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding ReturnDate, StringFormat={}{0:yyyy/M/d}}" Style="{StaticResource CenterText}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                            <DataGridTemplateColumn.CellEditingTemplate>
                                <DataTemplate>
                                    <DatePicker SelectedDate="{Binding ReturnDate, UpdateSourceTrigger=PropertyChanged}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellEditingTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="{lex:Loc Plans_StockInNo}" Binding="{Binding StockInNo, UpdateSourceTrigger=PropertyChanged}" Width="110" ElementStyle="{StaticResource CenterText}" EditingElementStyle="{StaticResource CenterEdit}"/>
                        <DataGridTextColumn Header="{lex:Loc Plans_StockInQty}" Binding="{Binding StockInQty, UpdateSourceTrigger=PropertyChanged}" Width="65" ElementStyle="{StaticResource CenterText}" EditingElementStyle="{StaticResource CenterEdit}"/>
                        <DataGridTemplateColumn Header="{lex:Loc Plans_StockInDate}" Width="90" SortMemberPath="StockInDate">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding StockInDate, StringFormat={}{0:yyyy/M/d}}" Style="{StaticResource CenterText}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                            <DataGridTemplateColumn.CellEditingTemplate>
                                <DataTemplate>
                                    <DatePicker SelectedDate="{Binding StockInDate, UpdateSourceTrigger=PropertyChanged}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellEditingTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="{lex:Loc Admin_Remark}" Binding="{Binding Remark, UpdateSourceTrigger=PropertyChanged}" Width="140" ElementStyle="{StaticResource CenterText}" EditingElementStyle="{StaticResource CenterEdit}"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <!--计划表-->
            <TabItem Header="{lex:Loc Plans_PlanTab}">
                <DataGrid x:Name="dg_plans"
                          ItemsSource="{Binding PlansView}"
                          SelectedItem="{Binding SelectedPlan, Mode=TwoWay}"
                          AutoGenerateColumns="False"
                          IsReadOnly="{Binding DataContext.IsGridReadOnly, RelativeSource={RelativeSource AncestorType=Window}}"
                          CanUserSortColumns="True" CanUserReorderColumns="True" CanUserAddRows="False"
                          HeadersVisibility="All" GridLinesVisibility="All"
                          SelectionMode="Extended" SelectionUnit="CellOrRowHeader"
                          ClipboardCopyMode="None"
                          LoadingRow="Dg_Plans_LoadingRow"
                          BeginningEdit="Dg_Plans_BeginningEdit"
                          CellEditEnding="Dg_Plans_CellEditEnding"
                          CurrentCellChanged="Dg_Plans_CurrentCellChanged"
                          PreviewMouseRightButtonDown="Dg_Plans_PreviewMouseRightButtonDown"
                          VirtualizingPanel.IsVirtualizing="True">
                    <DataGrid.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="{lex:Loc Plans_EditDialog}" Click="Menu_EditPlan_Click"/>
                            <MenuItem Header="{lex:Loc Plans_MarkDelete}" Click="Menu_DeletePlan_Click"/>
                            <Separator/>
                            <MenuItem Header="{lex:Loc Plans_OpenReportFolder}" Click="Menu_OpenReportFolder_Click" ToolTip="{lex:Loc Plans_ToolTip_OpenFolder}"/>
                            <MenuItem Header="{lex:Loc Plans_OpenOverview}" Click="Menu_OpenReportOverview_Click" ToolTip="{lex:Loc Plans_ToolTip_OpenOverview}"/>
                            <MenuItem Header="{lex:Loc Plans_OpenMainReport}" Click="Menu_OpenMainReport_Click" ToolTip="{lex:Loc Plans_ToolTip_OpenMainReport}"/>
                            <Separator/>
                            <MenuItem Header="{lex:Loc Common_CopyRow}" Click="Menu_CopyPlanRow_Click"/>
                            <MenuItem Header="{lex:Loc Common_CopyCell}" Click="Menu_CopyPlanCell_Click"/>
                            <MenuItem Header="{lex:Loc Common_Paste}" Click="Menu_PastePlan_Click"/>
                            <Separator/>
                            <MenuItem Header="{lex:Loc Plans_ShowHideColumns}" x:Name="menu_plan_columns" SubmenuOpened="Menu_PlanColumns_SubmenuOpened"/>
                        </ContextMenu>
                    </DataGrid.ContextMenu>
                    <DataGrid.CellStyle>
                        <StaticResource ResourceKey="FullCell"/>
                    </DataGrid.CellStyle>
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Id}" Value="0">
                                    <Setter Property="Background" Value="{DynamicResource StatusWarnBgBrush}"/>
                                </DataTrigger>
                                <!-- 选中行：很浅的灰色 -->
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource TableRowSelectedBrush}"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="{lex:Loc Plans_WorkNumber}" Width="90" SortMemberPath="JobNo">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding JobNo}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource CenterText}">
                                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                                <Style.Triggers>
                                                    <!-- 无对应报告文件夹/概览：灰色区分（明显但不突兀，白/浅灰背景上均清晰） -->
                                                    <DataTrigger Binding="{Binding HasReportLink}" Value="False">
                                                        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                            <DataGridTemplateColumn.CellEditingTemplate>
                                <DataTemplate>
                                    <TextBox Text="{Binding JobNo, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource CenterEdit}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellEditingTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="{lex:Loc Plans_ProductType}" Width="80" SortMemberPath="Product">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Product}" Style="{StaticResource CenterText}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                            <DataGridTemplateColumn.CellEditingTemplate>
                                <DataTemplate>
                                    <ComboBox ItemsSource="{Binding DataContext.CatalogProducts, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                              SelectedValue="{Binding Product, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                              VerticalContentAlignment="Center"
                                              ToolTip="{lex:Loc Plans_ProductTypeHint}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellEditingTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="{lex:Loc PlanEdit_Customer}" Width="95" SortMemberPath="Customer">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Customer}" Style="{StaticResource CenterText}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                            <DataGridTemplateColumn.CellEditingTemplate>
                                <DataTemplate>
                                    <ComboBox ItemsSource="{Binding DataContext.CatalogCustomers, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                              SelectedValue="{Binding Customer, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                              VerticalContentAlignment="Center"
                                              ToolTip="{lex:Loc Plans_CustomerHint}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellEditingTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="{lex:Loc Plans_ModelName}" Binding="{Binding ModelName, UpdateSourceTrigger=PropertyChanged}" Width="130" ElementStyle="{StaticResource CenterText}" EditingElementStyle="{StaticResource CenterEdit}"/>
                        <DataGridTemplateColumn Header="{lex:Loc Plans_Stage}" Width="65" SortMemberPath="Stage">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Stage}" Style="{StaticResource CenterText}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                            <DataGridTemplateColumn.CellEditingTemplate>
                                <DataTemplate>
                                    <ComboBox ItemsSource="{Binding DataContext.CatalogStages, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                              SelectedValue="{Binding Stage, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                              VerticalContentAlignment="Center"
                                              ToolTip="{lex:Loc Plans_StageHint}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellEditingTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="{lex:Loc Plans_TestItem}" Width="150" SortMemberPath="TestItem">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding TestItem}" Style="{StaticResource CenterText}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                            <DataGridTemplateColumn.CellEditingTemplate>
                                <DataTemplate>
                                    <ComboBox ItemsSource="{Binding DataContext.CatalogTestItems, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                              SelectedValue="{Binding TestItem, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                              IsEditable="False" VerticalContentAlignment="Center"
                                              ToolTip="{lex:Loc Plans_TestItemHint}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellEditingTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="{lex:Loc PlanEdit_SampleQty}" Binding="{Binding SampleSize, UpdateSourceTrigger=PropertyChanged}" Width="55" ElementStyle="{StaticResource CenterText}" EditingElementStyle="{StaticResource CenterEdit}"/>
                        <DataGridTextColumn Header="{lex:Loc Admin_TestTime}" Binding="{Binding TestPeriod, UpdateSourceTrigger=PropertyChanged}" Width="65" ElementStyle="{StaticResource CenterText}" EditingElementStyle="{StaticResource CenterEdit}"/>
                        <DataGridTextColumn Header="{lex:Loc Plans_Owner}" Binding="{Binding Owner, UpdateSourceTrigger=PropertyChanged}" Width="80" ElementStyle="{StaticResource CenterText}" EditingElementStyle="{StaticResource CenterEdit}"/>
                        <DataGridTemplateColumn Header="{lex:Loc Plans_StartDate}" Width="90" SortMemberPath="StartDate">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding StartDate, StringFormat={}{0:yyyy/M/d}}" Style="{StaticResource CenterText}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                            <DataGridTemplateColumn.CellEditingTemplate>
                                <DataTemplate>
                                    <DatePicker SelectedDate="{Binding StartDate, UpdateSourceTrigger=PropertyChanged}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellEditingTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="{lex:Loc PlanEdit_EndDate}" Width="90" SortMemberPath="EndDate">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding EndDate, StringFormat={}{0:yyyy/M/d}}" Style="{StaticResource CenterText}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                            <DataGridTemplateColumn.CellEditingTemplate>
                                <DataTemplate>
                                    <DatePicker SelectedDate="{Binding EndDate, UpdateSourceTrigger=PropertyChanged}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellEditingTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="{lex:Loc Plans_Status}" Width="75" SortMemberPath="Status">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Status}" Style="{StaticResource CenterText}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                            <DataGridTemplateColumn.CellEditingTemplate>
                                <DataTemplate>
                                    <ComboBox ItemsSource="{Binding DataContext.CatalogStatuses, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                              SelectedValue="{Binding Status, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                              VerticalContentAlignment="Center"
                                              ToolTip="{lex:Loc Plans_StatusHint}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellEditingTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="{lex:Loc Admin_Remark}" Binding="{Binding Remark, UpdateSourceTrigger=PropertyChanged}" Width="150" ElementStyle="{StaticResource CenterText}" EditingElementStyle="{StaticResource CenterEdit}"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
        </TabControl>

        <StatusBar Grid.Row="3">
            <StatusBarItem Content="{Binding StatusMessage}"/>
            <Separator/>
            <StatusBarItem>
                <TextBlock Text="{Binding PendingText}" Foreground="{DynamicResource StatusWarnBrush}" FontWeight="Bold"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
