<Window x:Class="ORT一键报告.Plans.Views.WindowPlans"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ORT一键报告.Plans.Views"
        mc:Ignorable="d"
        Title="领退和计划" Height="700" Width="1300" MinHeight="450" MinWidth="900"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <Grid Margin="5">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>

        <!--工具栏：导入/导出/清空需技术员及以上；新增/编辑/删除需普通用户及以上（普通用户提交审核）-->
        <ToolBarTray>
            <ToolBar Band="0" BandIndex="0">
                <Button Content="导入领用表" Command="{Binding ImportRequisitionCommand}" ToolTip="导入成品領用記錄Excel，与已有记录合并到同一行（技术员及以上）"/>
                <Button Content="导入计划表" Command="{Binding ImportScheduleCommand}" ToolTip="导入ORT Test Schedule Excel，与已有记录合并到同一行（技术员及以上）"/>
                <Separator/>
                <Button Content="导出领用表" Command="{Binding ExportRequisitionCommand}"/>
                <Button Content="导出计划表" Command="{Binding ExportScheduleCommand}"/>
                <Separator/>
                <Button Content="新增" Command="{Binding AddCommand}"/>
                <Button Content="编辑" Command="{Binding EditCommand}" ToolTip="编辑选中记录（普通用户提交审核）"/>
                <Button Content="删除" Command="{Binding DeleteCommand}"/>
                <Button Content="全部清空" Command="{Binding ClearAllCommand}" Foreground="DarkRed" ToolTip="清空全部计划数据（需确认，技术员及以上）"/>
                <Separator/>
                <Button Content="回线转移单" Click="Btn_ReturnLine_Click" ToolTip="打开回线转移单工具"/>
                <Separator/>
                <Button Content="刷新" Command="{Binding RefreshCommand}"/>
            </ToolBar>
        </ToolBarTray>

        <!--筛选区（可折叠）：按需添加筛选条件-->
        <Expander Grid.Row="1" Header="筛选" IsExpanded="True" Margin="0,5,0,0">
            <StackPanel Margin="5">
                <WrapPanel>
                    <ComboBox Width="140" Margin="0,0,10,3" VerticalContentAlignment="Center"
                              ItemsSource="{Binding AvailableFields}"
                              SelectedItem="{Binding AddFilterField, Mode=TwoWay}"
                              ToolTip="选择字段以添加筛选条件"/>
                    <ItemsControl ItemsSource="{Binding ActiveFilters}" VerticalAlignment="Center">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="#FFBBBBBB" BorderThickness="1" CornerRadius="3"
                                        Margin="0,0,8,3" Padding="5,2" Background="#FFF8F8F8">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Field}" VerticalAlignment="Center"
                                                   FontWeight="Bold" Margin="0,0,5,0"/>
                                        <!--值字段：Excel风格筛选下拉（搜索+多选）-->
                                        <local:FilterDropDown
                                            Options="{Binding Options}"
                                            SelectedValues="{Binding SelectedValues}"
                                            Visibility="{Binding IsValueField, Converter={StaticResource BoolToVis}}"/>
                                        <!--日期字段：起止日期-->
                                        <StackPanel Orientation="Horizontal"
                                                    Visibility="{Binding IsDateField, Converter={StaticResource BoolToVis}}">
                                            <DatePicker Width="112" SelectedDate="{Binding DateFrom, Mode=TwoWay}" ToolTip="起始日期"/>
                                            <TextBlock Text="~" VerticalAlignment="Center" Margin="3,0"/>
                                            <DatePicker Width="112" SelectedDate="{Binding DateTo, Mode=TwoWay}" ToolTip="截止日期"/>
                                        </StackPanel>
                                        <Button Content="✕" Margin="5,0,0,0" Padding="3,0" BorderThickness="0"
                                                Background="Transparent" Foreground="Gray" ToolTip="删除该筛选条件"
                                                Command="{Binding DataContext.RemoveFilterCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </WrapPanel>
                <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                    <Label Content="搜索" VerticalContentAlignment="Center"/>
                    <TextBox Width="220" VerticalContentAlignment="Center"
                             Text="{Binding Keyword, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="按机种/单据号/工作编号/测试项目/负责人/SN等筛选（停止输入后刷新）"/>
                </StackPanel>
            </StackPanel>
        </Expander>

        <!--数据列表：可拖动列头调整顺序（顺序会持久化）-->
        <DataGrid x:Name="dg_plans" Grid.Row="2" Margin="0,5,0,0"
                  ItemsSource="{Binding PlansView}"
                  SelectedItem="{Binding SelectedPlan, Mode=TwoWay}"
                  AutoGenerateColumns="False" IsReadOnly="True"
                  CanUserSortColumns="True" CanUserReorderColumns="True" CanUserAddRows="False"
                  HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                  SelectionMode="Single" SelectionUnit="FullRow"
                  VirtualizingPanel.IsVirtualizing="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Id" Binding="{Binding Id}" Width="50"/>
                <DataGridTextColumn Header="工作編號" Binding="{Binding JobNo}" Width="90"/>
                <DataGridTextColumn Header="领料单据号" Binding="{Binding RequisitionNo}" Width="110"/>
                <DataGridTextColumn Header="机种名称" Binding="{Binding ModelName}" Width="130"/>
                <DataGridTextColumn Header="测试项目" Binding="{Binding TestItem}" Width="140"/>
                <DataGridTextColumn Header="数量" Binding="{Binding OutQty}" Width="45"/>
                <!--S/N：无附件显示文本，有附件显示可点击的文件链接（tooltip为SN文本）-->
                <DataGridTemplateColumn Header="S/N" Width="170" SortMemberPath="SN">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Grid>
                                <TextBlock x:Name="txtSn" Text="{Binding SN}" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" Visibility="Collapsed"/>
                                <TextBlock x:Name="linkSn" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding SN}">
                                    <Hyperlink Command="{Binding DataContext.OpenSnFileCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                               CommandParameter="{Binding}" ToolTip="点击打开SN文件">
                                        <Run Text="{Binding SnFilePath, Mode=OneWay}"/>
                                    </Hyperlink>
                                </TextBlock>
                            </Grid>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding SnFilePath}" Value="{x:Null}">
                                    <Setter TargetName="linkSn" Property="Visibility" Value="Collapsed"/>
                                    <Setter TargetName="txtSn" Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="D/C" Binding="{Binding DC}" Width="50"/>
                <DataGridTextColumn Header="REV" Binding="{Binding Rev}" Width="50"/>
                <DataGridTextColumn Header="Work Order" Binding="{Binding WorkOrder}" Width="150"/>
                <DataGridTextColumn Header="回线RT工令" Binding="{Binding ReturnRtOrder}" Width="95"/>
                <DataGridTextColumn Header="线别" Binding="{Binding LineNo}" Width="50"/>
                <DataGridTextColumn Header="领用日期" Binding="{Binding RequisitionDate}" Width="75"/>
                <DataGridTextColumn Header="回线日期" Binding="{Binding ReturnDate}" Width="75"/>
                <DataGridTextColumn Header="入库单号" Binding="{Binding StockInNo}" Width="110"/>
                <DataGridTextColumn Header="入库日期" Binding="{Binding StockInDate}" Width="75"/>
                <DataGridTextColumn Header="产品别" Binding="{Binding Product}" Width="70"/>
                <DataGridTextColumn Header="客户别" Binding="{Binding Customer}" Width="90"/>
                <DataGridTextColumn Header="阶段" Binding="{Binding Stage}" Width="50"/>
                <DataGridTextColumn Header="样品数" Binding="{Binding SampleSize}" Width="55"/>
                <DataGridTextColumn Header="试验时间" Binding="{Binding TestPeriod}" Width="65"/>
                <DataGridTextColumn Header="负责人" Binding="{Binding Owner}" Width="80"/>
                <DataGridTextColumn Header="开始日期" Binding="{Binding StartDate}" Width="85"/>
                <DataGridTextColumn Header="结束日期" Binding="{Binding EndDate}" Width="85"/>
                <DataGridTextColumn Header="状况" Binding="{Binding Status}" Width="60"/>
                <DataGridTextColumn Header="备注" Binding="{Binding Remark}" Width="150"/>
                <DataGridTextColumn Header="创建人" Binding="{Binding CreatedBy}" Width="70"/>
                <DataGridTextColumn Header="更新时间" Binding="{Binding UpdatedAt, StringFormat=yyyy-MM-dd HH:mm}" Width="120"/>
            </DataGrid.Columns>
        </DataGrid>

        <StatusBar Grid.Row="3">
            <StatusBarItem Content="{Binding StatusMessage}"/>
        </StatusBar>
    </Grid>
</Window>
